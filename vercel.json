{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/assets/:path*",
      "destination": "https://assets.isnow.life/site/v20261003/assets/:path*",
      "permanent": false
    },
    {
      "source": "/photos/:path*",
      "destination": "https://assets.isnow.life/site/v20261003/photos/:path*",
      "permanent": false
    },
    {
      "source": "/videos/:path*",
      "destination": "https://assets.isnow.life/site/v20261003/videos/:path*",
      "permanent": false
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*).(css|js|json|jpg|jpeg|png|webp|gif|mp3|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
