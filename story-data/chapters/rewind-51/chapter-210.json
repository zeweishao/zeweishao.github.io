{
  "bookId": "rewind-51",
  "id": "chapter-210",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "41805001",
          "sourceType": 3,
          "text": "深夜的训练场。",
          "type": "narration"
        },
        {
          "sourceId": "41805002",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "嘿——嗬——哈——",
          "type": "dialogue"
        },
        {
          "sourceId": "41805003",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "完美的训练记录，再一次刷新了自己的最佳表现……哈，意料之中的结果。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805004",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "咯吱——嗒——",
          "type": "dialogue"
        },
        {
          "sourceId": "41805005",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "原本紧闭的训练场大门，被未知的外力破开了一道口子。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805006",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "夜风从门缝倒灌进来，引起巨大的响动，原地却仍旧空无一人。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805007",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "谁在那里，给我出来！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805008",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "知道我是谁么？竟然在我的面前玩这种无聊的小把戏？！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805009",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "快给我滚出来，别磨磨蹭蹭的，想干架就正面上……嗯，那是？",
          "type": "dialogue"
        },
        {
          "sourceId": "41805010",
          "sourceType": 3,
          "text": "街区的一角，圣阳学生宿舍内。",
          "type": "narration"
        },
        {
          "sourceId": "41805011",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "演算完成，结论出来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805012",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "已经将对手的进攻和防守动作量化，推导出了一个完整的数据模型，后续的出招结果完全在可预测范围~！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805013",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "嗯，阳子姐只要按照我的计算出拳，明天的比赛就一定能赢。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805014",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "终于可以安心睡个好觉了……呼，好困。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805015",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "砰砰砰——砰砰砰——",
          "type": "dialogue"
        },
        {
          "sourceId": "41805016",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "一阵急促的敲门声瞬间赶走了困意，也让原本安静的夜晚充满了诡异的气氛。",
          "type": "dialogue"
        },
        {
          "sourceId": "41805017",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "砰！砰砰——砰砰砰——",
          "type": "dialogue"
        },
        {
          "sourceId": "41805018",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "唔，谁……什么人？",
          "type": "dialogue"
        },
        {
          "sourceId": "41805019",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "是我！快开门！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805020",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "把门打开，跟我走——快！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805021",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "嗯？阳子姐，怎么是你？",
          "type": "dialogue"
        },
        {
          "sourceId": "41805022",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "发生了什么事，你怎么慌慌张张的……",
          "type": "dialogue"
        },
        {
          "sourceId": "41805023",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "哈啊，哈……来不及解释了，这里不安全，快跟我走！",
          "type": "dialogue"
        },
        {
          "sourceId": "41805024",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "唔……到底发生了什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "41805025",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "现在就离开的话，明天的比赛怎么办……你不是一直很重视那场比赛吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "41805026",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "没时间了，那个「怪物」就要追上来了……跟我走！",
          "type": "dialogue"
        }
      ],
      "id": "detail-1037",
      "sourceRefs": [
        {
          "bundle": "mikage",
          "rowIds": [
            41805001,
            41805002,
