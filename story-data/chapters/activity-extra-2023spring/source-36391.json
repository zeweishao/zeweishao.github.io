{
  "bookId": "activity-extra-2023spring",
  "id": "source-36391",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "36391001",
          "sourceType": 0,
          "speaker": "酒井唯",
          "text": "「逃学威莉」第三幕第二十三场准备——Action！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391002",
          "sourceType": 5,
          "speaker": "哈莉",
          "text": "嘿嘿嘿吼！里面的人听好了，统统不许动——",
          "type": "dialogue"
        },
        {
          "sourceId": "36391003",
          "sourceType": 7,
          "text": "哈莉 · 直入重围\n商品名称：哈莉·直入重围 Ver.\n作品名称：《少女X机关枪》\n制造商：LET'S RED 猩潮\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约244mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "36391004",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "好……好可怕。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391005",
          "sourceType": 0,
          "speaker": "酒井唯",
          "text": "哈莉……你是来解救人质的，表情不要那么兴奋！\n等下再拍吧，社员们都先休息一下。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇，这就是电影社平常的社团活动吗！居然是拍电影，好有意思！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那么这次的春日社团大揭秘，就由优纪带大家去采访一下「时光电影社」的主要社员吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "运气好的话，说不定还能碰到电影社的特别指导老师呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "嗨，现在我们到社团休息室啦。\n咦？门正巧开着，和优纪一起进去看看吧——",
          "type": "dialogue"
        },
        {
          "sourceId": "36391010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "这什么破裙子！真是太不方便了，我要把它脱了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊啊啊，对不起对不起，花迦快把摄像机关了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391012",
          "sourceType": 0,
          "text": "滋滋滋——滋滋滋——",
          "type": "narration"
        },
        {
          "sourceId": "36391013",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哈哈哈哈，不好意思，刚才出了些意外，那么采访现在正式开始！\n请问哈莉，拍摄「逃学威莉」这部电影好玩吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "36391014",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "吼吼！超有意思！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "据说这次是要扮演一个潜入学校然后卧底解救人质的女特工？有遇到什么拍摄上的困难吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "36391016",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "嘿嘿！完全没有！什么困难哈莉都能解决！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391017",
          "sourceType": 0,
          "speaker": "小红",
          "text": "笨蛋哈莉看不懂剧本~",
          "type": "dialogue"
        },
        {
          "sourceId": "36391018",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "呼，呼……哈莉要把红盒子拆成零件！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391019",
          "sourceType": 5,
          "speaker": "旁白",
          "text": "噼里啪啦——嘭——",
          "type": "dialogue"
        },
        {
          "sourceId": "36391020",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "采……滋滋滋……访结束……\n我们……滋滋滋……先出去……吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "36391021",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "开机了……不知道刚才有没有砸到机器？\n啊！这个角度好奇怪，怎么调整不回来了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391022",
          "sourceType": 0,
          "speaker": "狐狸怪盗",
          "text": "嗯……让在下看看？",
          "type": "dialogue"
        },
        {
          "sourceId": "36391023",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "是底部的支架松了，像这样拧紧就好了……不愧是我。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391024",
          "sourceType": 7,
          "text": "诸葛孔明 · 星河漫步\n商品名称：诸葛孔明·星河漫步 Ver.  \n作品名称：《赤炎·境界》\n制造商：SNOW.A 细雪庭\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约248mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "36391025",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "谢谢！等等！你这身打扮！\n难道是正在拍摄「世纪末的军师」的……",
          "type": "dialogue"
        },
        {
          "sourceId": "36391026",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "嘘——在下可是偷偷跑来电影社的。\n这么大声的话就要被粉丝们找到了。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391027",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "孔明老师，请问能采访你吗？\n大家都很期待这部「三国名侦探」系列最新的剧场版呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391028",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "唔……时间不多了，在下只能回答一个问题。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391029",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇，那优纪要好好想个问题，争取给社团节搞个大新闻！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391030",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "据说当时竞争这个角色的还有周瑜、光秀等高人气男手办，请问为什么最后是孔明先生出演呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "36391031",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "嗯？据说是编剧指定的……这么看我果然不简单呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391032",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "难道是知名编剧「泡面姬」吗——",
          "type": "dialogue"
        },
        {
          "sourceId": "36391033",
          "sourceType": 5,
          "speaker": "粉丝一号",
          "text": "啊啊啊丞相在那！丞相！！我是你的粉丝！！请给我签名！！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391034",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "哎呀呀，不巧，看来在下要先走一步了。",
          "type": "dialogue"
        },
        {
          "sourceId": "36391035",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊啊……等等！好大的风——\n飞起来了吗？！！不愧是传闻中能借来东风的男人！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391036",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "很遗憾，因为热情的粉丝，采访只能暂时中止了。\n",
          "type": "dialogue"
        },
        {
          "sourceId": "36391037",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "不过看到孔明先生潇洒离去的样子，优纪已经十分期待电影上映了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391038",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "拍到了呢……在月下飞起来的孔明先生……",
          "type": "dialogue"
        },
        {
          "sourceId": "36391039",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇，花迦好厉害！这样一来采访海报和封面也都有了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36391040",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "搞定，那么这次社团节大揭秘的采访任务圆满完成！\n可以关掉摄影机啦——",
          "type": "dialogue"
        },
        {
          "sourceId": "36391041",
          "sourceType": 3,
          "text": "咔——",
          "type": "narration"
        },
        {
          "sourceId": "36391042",
          "sourceType": 3,
          "text": "……………………………………\n呲——社团节采访母带？",
          "type": "narration"
        },
        {
          "sourceId": "36391043",
          "sourceType": 0,
          "speaker": "玉夏",
          "text": "孔明真不愧是我选定的主演！\n决定了，下一个剧本一定要把赵云写成男二号！",
          "type": "dialogue"
        }
      ],
