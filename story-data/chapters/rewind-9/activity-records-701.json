  "sections": [
    {
      "blocks": [
        {
          "text": "「每日习字」\n平庸的笔触,美丽地勾画出原本就美丽的东西。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "花开物语前"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n有时，会想起那日的肆意欢乐。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "花开物语中"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n哈莉、小红、小蓝、里惠、洛瑞丝、优纪、和江、人类、桃乐丝、警察、武术、百合花、不爱看书、勇敢、善良、绿子、lvzi。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "花开物语后"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n一位大胆的神祇，纵容着、肆意妄为的生活。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "花开物语终"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n科学，于规则内质疑世界。\n傲慢与欲望之人，无所约束，必成加害者。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "狂徒净魂·清道夫"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n关于力量，人们总有不同见解。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "狂徒净魂·维系者"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n若情绪能感染他人，愤怒亦然。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "狂徒净魂·绯色心"
    },
    {
      "blocks": [
        {
          "text": "「每日习字」\n我胖了。",
          "title": "所有的际遇都是神的美意",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "狂徒净魂·体型者"
    }
  ],
