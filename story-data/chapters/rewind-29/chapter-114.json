      "title": "指尖跃动·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "24670001",
          "sourceType": 0,
          "speaker": "仙人掌",
          "text": "嗯……我刚才是怎么了？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670002",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "……赢了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670003",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "咳咳……",
          "type": "dialogue"
        },
        {
          "sourceId": "24670004",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "被打倒的感觉……真是有点羞耻……",
          "type": "dialogue"
        },
        {
          "sourceId": "24670005",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "不过偶尔来一次，好像也挺不错的❤",
          "type": "dialogue"
        },
        {
          "sourceId": "24670006",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "真是华丽的一击呀，我有点理解黑子小姐为什么那么喜欢你了~人家好像也有点心动的感觉呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "24670007",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "24670008",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "这家伙现在要怎么处理呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670009",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "这样的危险分子，最好直接杀掉。",
          "type": "dialogue"
        },
        {
          "sourceId": "24670010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "喂喂，和江，我们可不能滥用私刑！还是交给管理局处理吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670011",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "人是御坂解决的，交给她决定吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "24670012",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "啊……我来决定？？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670013",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "你打算怎么处置人家呢？想要做什么都可以喔❤？",
          "type": "dialogue"
        },
        {
          "sourceId": "24670014",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "24670015",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "如果就这样杀了她就太便宜她了……把她带回去，让她用余生好好的赎罪吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "24670016",
          "sourceType": 5,
          "text": "咻！！",
          "type": "narration"
        },
        {
          "sourceId": "24680001",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "不好意思，她现在还不能交给你们。",
          "type": "dialogue"
        },
        {
          "sourceId": "24680002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "弗吉尼娅？！",
          "type": "dialogue"
        },
        {
          "sourceId": "24680003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "大家快到我身后！",
          "type": "dialogue"
        },
        {
          "sourceId": "24680004",
          "sourceType": 3,
          "text": "……",
          "type": "narration"
        },
        {
          "sourceId": "24680005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "……嗯？怎么没动静了？\n弗吉尼娅，放马过来呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "24680006",
          "sourceType": 5,
          "speaker": "花迦",
          "text": "优纪……克罗赛尔不见了！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-620",
