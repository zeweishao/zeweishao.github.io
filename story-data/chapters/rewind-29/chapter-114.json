            24650009,
            24650010,
            24650011,
            24650012,
            24650013
          ],
          "sectionId": 24650
        }
      ],
      "title": "指尖跃动·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "24660001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "不行！这些家伙完全采用不要命的打法！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660002",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "御……御坂同学，你那边还没有结束吗？我们快顶不住了！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660003",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "抱歉，这个家伙比想象中要灵活得多！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660004",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "可恶，不使用「那个」战斗的话，总感觉少了点什么。",
          "type": "dialogue"
        },
        {
          "sourceId": "24660005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "还清醒的各位，大家一起来帮忙吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660006",
          "sourceType": 0,
          "speaker": "众手办",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "24660007",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "大……大家？",
          "type": "dialogue"
        },
        {
          "sourceId": "24660008",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "喂！！你们难道是忘了她们是为了谁在战斗吗？我们不能这么没良心！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "咦？你清醒过来了？！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660010",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "嗯……因为我想起了主人根本不看篮球比赛，她只是因为喜欢的男生是校队前锋才买了我……",
          "type": "dialogue"
        },
        {
          "sourceId": "24660011",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "当然，后来她的告白失败了。",
          "type": "dialogue"
        },
        {
          "sourceId": "24660012",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "……不说这些了。\n大家不要被这个女人吓到了，快跟我一起掩护御坂！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660013",
          "sourceType": 0,
          "speaker": "仙人掌",
          "text": "一起掩护御坂！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660014",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "你们……",
          "type": "dialogue"
        },
        {
          "sourceId": "24660015",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "真是个蠢货，忠于自己的欲望，然后了无遗憾的死去难道不好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "24660016",
          "sourceType": 0,
          "speaker": "猪猪储蓄罐",
          "text": "御坂姐姐，你应该需要这个吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "24660017",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "啊，这个是……硬币？",
          "type": "dialogue"
        },
        {
          "sourceId": "24660018",
          "sourceType": 0,
          "speaker": "猪猪储蓄罐",
          "text": "我的主人是你的忠实粉丝哦，加油！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660019",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "啧，看来只能用那个了。\n虽然会让我进入很长一段时间的虚弱期——",
          "type": "dialogue"
        },
        {
          "sourceId": "24660020",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "路西法！！展现你真正力量的时候到了！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660021",
          "sourceType": 0,
          "speaker": "众手办",
          "text": "唔——！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660022",
          "sourceType": 5,
          "speaker": "克罗赛尔",
          "text": "愚民们，全部沦陷在欲望之中吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660023",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "抱歉，恐怕你的技能对我不管用。",
          "type": "dialogue"
        },
        {
          "sourceId": "24660024",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "怎、怎么会这样？！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660025",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "论心理掌握的能力，我可是认识一个比你更加棘手的家伙。",
          "type": "dialogue"
        },
        {
          "sourceId": "24660026",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "那么，现在到我的时间了！",
          "type": "dialogue"
        },
        {
          "sourceId": "24660027",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "接招吧！",
          "type": "dialogue"
        }
      ],
      "id": "detail-619",
