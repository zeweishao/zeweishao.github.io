        }
      ],
      "title": "指尖跃动·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "24650001",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "主人，你想起我了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "24650002",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "哈哈哈，我就知道你还记得我！",
          "type": "dialogue"
        },
        {
          "sourceId": "24650003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "居然一边说梦话一边攻击，这也太诡异了吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "24650004",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "而且，比清醒的时候强很多。",
          "type": "dialogue"
        },
        {
          "sourceId": "24650005",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "怎……怎么办，没办法接近！现在全场的手办都变成了她的人质……",
          "type": "dialogue"
        },
        {
          "sourceId": "24650006",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "不是全场……你仔细看，还有不少手办没受控制。",
          "type": "dialogue"
        },
        {
          "sourceId": "24650007",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "我猜测，她的能力是需要依靠手办们的欲望才能发动的。",
          "type": "dialogue"
        },
        {
          "sourceId": "24650008",
          "sourceType": 2,
          "speaker": "御坂美琴",
          "text": "（如果只是轻微的电击，手办们在倒地片刻之后马上又站起来了……）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "24650009",
          "sourceType": 2,
          "speaker": "御坂美琴",
          "text": "（烦死了！！要在不伤害对方的情况下，同时应对这么多手办！怎么办得到啊！）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "24650010",
          "sourceType": 0,
          "speaker": "克里斯",
          "text": "主人，我们一起看比赛吧~",
          "type": "dialogue"
        },
        {
          "sourceId": "24650011",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "给我——停下！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24650012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "小琴琴，其他手办交给我们阻拦，你专心对付克罗赛尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "24650013",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "……好，那就拜托你们了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-618",
      "sourceRefs": [
        {
          "bundle": "paojie1",
          "rowIds": [
            24650001,
            24650002,
            24650003,
            24650004,
            24650005,
            24650006,
            24650007,
