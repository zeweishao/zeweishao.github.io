            24420018,
            24420019,
            24420020
          ],
          "sectionId": 24420
        }
      ],
      "title": "乐园秘宝·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "24430001",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "我觉得刚才那伙人应该没有什么坏心思。",
          "type": "dialogue"
        },
        {
          "sourceId": "24430002",
          "sourceType": 0,
          "speaker": "白井黑子",
          "text": "姐姐大人，我们来这个世界才多久，可不能轻信陌生人说的话！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430003",
          "sourceType": 2,
          "speaker": "白井黑子",
          "text": "（更何况，这可是与姐姐大人千载难逢的独处机会，怎么能让那些莫名其妙的家伙跑来扫兴啊！）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "24430004",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "不过这个地方确实越来越可疑了，你看！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430005",
          "sourceType": 0,
          "speaker": "白井黑子",
          "text": "藏宝图吗……也太粗糙了吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430006",
          "sourceType": 0,
          "speaker": "白井黑子",
          "text": "这怎么看都是小孩子的涂鸦吧？是有人在故意诱导吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430007",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "二位，有没有兴趣一起组队寻找宝藏？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430008",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "错过了这次机会，就只能当一辈子的流浪手办了……这样居无定所的日子，你们也过够了吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430009",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "……这之间有什么关系？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430010",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "昂？你们不会什么都不知道就来了吧？？",
          "type": "dialogue"
        },
        {
          "sourceId": "24430011",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "能够重获主人关爱的魔法药水，尤兰达女士的最新研究！\n也就是让所有流浪手办趋之若鹜的宝藏！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430012",
          "sourceType": 0,
          "speaker": "朋克小子",
          "text": "和我们一起组队吧，到时候大家平分药水！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430013",
          "sourceType": 0,
          "speaker": "白井黑子",
          "text": "对不起，我们不感兴趣。",
          "type": "dialogue"
        },
        {
          "sourceId": "24430014",
          "sourceType": 0,
          "speaker": "仙人掌",
          "text": "不感兴趣？我们很有实力的哦……而且我们知道宝藏在哪里！只要你们加入的话，我就告诉你们。",
          "type": "dialogue"
        },
        {
          "sourceId": "24430015",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "宝藏在花坛！抓紧时间，去晚了可就没份啦！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430016",
          "sourceType": 0,
          "speaker": "仙人掌",
          "text": "喂，你是哪里冒出来的？！居然敢拆我们台！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430017",
          "sourceType": 5,
          "speaker": "朋克小子",
          "text": "你完蛋了！给我站住！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430018",
          "sourceType": 0,
          "speaker": "仙人掌",
          "text": "追！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24430019",
          "sourceType": 0,
          "speaker": "美琴、黑子",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "24430020",
          "sourceType": 0,
          "speaker": "白井黑子",
          "text": "姐姐大人。",
          "type": "dialogue"
        },
        {
          "sourceId": "24430021",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "嗯，我们也跟上去看看吧！",
          "type": "dialogue"
        }
      ],
      "id": "detail-604",
