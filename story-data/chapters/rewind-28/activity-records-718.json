  "sections": [
    {
      "blocks": [
        {
          "text": "手办团的世界，黑暗的迪迦出现，他的目的是……摆脱黑暗的气息。",
          "title": "追寻光的道路",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "黑暗迪迦"
    },
    {
      "blocks": [
        {
          "text": "在莉可和手办团的帮助下，迪迦试着寻找变回光明的办法。",
          "title": "追寻光的道路",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "寻找光明"
    },
    {
      "blocks": [
        {
          "text": "柯斯顿城，似乎是迪迦找回光明力量的最后希望？",
          "title": "追寻光的道路",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "希望之种"
    },
    {
      "blocks": [
        {
          "text": "光明从来不曾从迪迦的身边离去。",
          "title": "追寻光的道路",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "闪耀迪迦"
    },
    {
      "blocks": [
        {
          "text": "我只是在做我能做的事，身为一个人能做的事！ ",
          "title": "「回归光明」",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "达拉姆的力量"
    },
    {
      "blocks": [
        {
          "text": "其实每个人都可以靠自己的力量变成光的。",
          "title": "「回归光明」",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "希特拉的敏捷"
    },
    {
      "blocks": [
        {
          "text": "奥特曼既是光，也是人类。",
          "title": "「回归光明」",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "卡蜜拉的黑暗"
    },
    {
      "blocks": [
        {
          "text": "根本赢不了，我听不懂。",
          "title": "「回归光明」",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "光的救赎"
    }
  ],
