            23001017,
            23001018,
            23001019,
            23001020,
            23001021
          ],
          "sectionId": 23001
        }
      ],
      "title": "命运交互·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "23002001",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "这就是刚才那家伙带走的东西吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002002",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "看上去很好喝的样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002003",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "不要说着就真的开始喝起来啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "23002004",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "才没喝，我只是稍微尝下味道，你不好奇这是什么吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23002005",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "唔！！这是什么，我从来没有尝过这么有趣的味道！",
          "type": "dialogue"
        },
        {
          "sourceId": "23002006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "找到了，就是这里吧！那家伙终于露出马脚了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002007",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "让哈莉找了这么久，下一枪，冲着他脑门好了~",
          "type": "dialogue"
        },
        {
          "sourceId": "23002008",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "先不要冲动，这里是其他人的设计室，等到主人确定没有其他人类再动手。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊，和江，你看那边！",
          "type": "dialogue"
        },
        {
          "sourceId": "23002010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "目标，锁定！",
          "type": "dialogue"
        },
        {
          "sourceId": "23002011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "是涂料小偷！竟然已经出现了，而且还这么大胆？！",
          "type": "dialogue"
        },
        {
          "sourceId": "23002012",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "又有手办过来了吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002013",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "好像对我们有敌意的样子，是要来抢宝物的吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23002014",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "放开那瓶涂料，不然别怪我们不客气了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002015",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "你是在命令我？",
          "type": "dialogue"
        },
        {
          "sourceId": "23002016",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "想和我打架吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23002017",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "米莉姆，等等。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002018",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "我才不听，天天被关在小盒子里，我的身体都要生锈了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002019",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "来得正好。优纪，还是看我的吧，对付这种盛气凌人的家伙，言语可是行不通的。",
          "type": "dialogue"
        },
        {
          "sourceId": "23002020",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "哈莉，等一下……",
          "type": "dialogue"
        },
        {
          "sourceId": "23002021",
          "sourceType": 9,
          "text": "砰。",
          "type": "narration"
        },
        {
          "sourceId": "23003001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "怎么回事……这个家伙。好像有点强过头了……",
          "type": "dialogue"
        },
        {
          "sourceId": "23003002",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "哇哈哈哈哈~你们就只有这些本事吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23003003",
          "sourceType": 0,
          "speaker": "米莉姆",
          "text": "如果只有这种程度的话，要挑战我，还太早了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-504",
