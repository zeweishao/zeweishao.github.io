      "title": "细节刻画·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "29518001",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "学姐，好消息！还有半小时开始营业，店门口的客人已经排长队啦！",
          "type": "dialogue"
        },
        {
          "sourceId": "29518002",
          "sourceType": 0,
          "speaker": "玉夏",
          "text": "真的？！",
          "type": "dialogue"
        },
        {
          "sourceId": "29518003",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "哼哼，当然是我的宣传工作做得到位！",
          "type": "dialogue"
        },
        {
          "sourceId": "29518004",
          "sourceType": 0,
          "speaker": "玉夏",
          "text": "你做了什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "29518005",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "我在网站上受到启发，挨家挨户发放了很多份试读版。",
          "type": "dialogue"
        },
        {
          "sourceId": "29518006",
          "sourceType": 0,
          "speaker": "玉夏",
          "text": "干得不错！\n......等等，你怎么有钱去打印试读版的？",
          "type": "dialogue"
        },
        {
          "sourceId": "29518007",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "简单！\n我直接把整本书撕开，一边跑一边撒到街道上。",
          "type": "dialogue"
        },
        {
          "sourceId": "29518008",
          "sourceType": 0,
          "speaker": "玉夏",
          "text": "......",
          "type": "dialogue"
        },
        {
          "sourceId": "29519001",
          "sourceType": 0,
          "speaker": "冈田彩音·樱桃汽水",
          "text": "欢迎光临！书架上的书请随意选取。",
          "type": "dialogue"
        },
        {
          "sourceId": "29519002",
          "sourceType": 0,
          "speaker": "冈田彩音·樱桃汽水",
          "text": "本店招牌的蛋包饭番茄酱味涂料，要不要点一杯，坐下来一边看书一边慢慢品尝呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "29519003",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "你看起来......很眼熟。是不是紫罗兰学园的......",
          "type": "dialogue"
        },
        {
          "sourceId": "29519004",
          "sourceType": 2,
          "speaker": "冈田彩音·樱桃汽水",
          "text": "不行，如果她记住我的名字，这件事迟早被哥哥知道......",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "29519005",
          "sourceType": 0,
          "speaker": "冈田彩音·樱桃汽水",
          "text": "神宫有咲，紫罗兰学园神宫有咲！\n对了，这本《玛丽苏·艾里克希娅·H·冰雪公主》很适合您哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520001",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "狩猎者大人！\n真的是《咖啡执事的狩猎》里的狩猎者大人！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520002",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "客人们蜂拥而至，让妾身感到更加兴奋了呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "29520003",
          "sourceType": 0,
          "speaker": "黄兔子",
          "text": "想要瞻仰狩猎者大人的英姿！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520004",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "想喝狩猎者大人的咖啡涂料！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520005",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "不要心急。\n还差最后一步，美味到渗透灵魂与骨髓的秘制调味粉。",
          "type": "dialogue"
        },
        {
          "sourceId": "29520006",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "在咖啡因微妙的作用下变得兴奋，是多么美妙的一件事。\n客人，请用。",
          "type": "dialogue"
        },
        {
          "sourceId": "29520007",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "吨吨吨吨吨吨——嗝！\n哈啊，身体暖起来了......",
          "type": "dialogue"
        },
        {
          "sourceId": "29520008",
          "sourceType": 0,
          "speaker": "黄兔子",
          "text": "我也要！给我5杯，不，10杯！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520009",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "调配那么多咖啡，妾身的手会酸的。\n神宫小姐，可以麻烦你完成剩下的10杯咖啡吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "29520010",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "这明明是你的工作！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520011",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "可、以、吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "29520012",
          "sourceType": 0,
          "speaker": "玉夏·一碗极鲜",
          "text": "（小声）现在她是揽客的关键，你们暂时容忍一下。",
          "type": "dialogue"
        },
        {
          "sourceId": "29520013",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "我没什么意见，但是彩音有话要说！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520014",
          "sourceType": 0,
          "speaker": "冈田彩音·樱桃汽水",
          "text": "哎？我也没意见，不过店长好像有点不满？",
          "type": "dialogue"
        },
        {
          "sourceId": "29520015",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "店长小姐？",
          "type": "dialogue"
        },
        {
          "sourceId": "29520016",
          "sourceType": 0,
          "speaker": "玉夏·一碗极鲜",
          "text": "身为店长，只能上了吗......",
          "type": "dialogue"
        },
        {
          "sourceId": "29520017",
          "sourceType": 5,
          "speaker": "玉夏·一碗极鲜",
          "text": "太不像话了！需要帮忙怎么不早说，累坏自己怎么办！\n给我等着，我马上开始做！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520018",
          "sourceType": 0,
          "speaker": "黄兔子",
          "text": "但是，我想要狩猎者大人亲自调配的咖啡！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520019",
          "sourceType": 0,
          "speaker": "狩猎者·兴奋因子",
          "text": "嘘——作为补偿，请收下这张纸条。\n这是我为客人您定制的专属秘密哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "29520020",
          "sourceType": 0,
          "speaker": "黄兔子",
          "text": "我的！给我拿来！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520021",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "嘻嘻，狩猎者大人亲手写的纸条，散发着咖啡的香气......\n快看看，上面写了什么！",
          "type": "dialogue"
        },
        {
          "sourceId": "29520022",
          "sourceType": 0,
          "speaker": "黄兔子",
          "text": "......「上班时间私自旷工喝咖啡，扣除半个月奖金。」",
          "type": "dialogue"
        }
      ],
      "id": "detail-654",
      "sourceRefs": [
