        {
          "sourceId": "28560001",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "不要过来，不要靠近我。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "28560003",
              "text": "为什么？"
            }
          ],
          "sourceId": "28560002",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "28560003",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "我是个怪物，会伤害你。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "28560005",
              "text": "可我现在好好的呀。"
            },
            {
              "targetId": "28560005",
              "text": "你看起来非常孤独。"
            }
          ],
          "sourceId": "28560004",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "28560005",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "你不……怕我？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "28560007",
              "text": "你很温柔，没什么好怕的。"
            }
          ],
          "sourceId": "28560006",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "28560007",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "……谢谢。",
          "type": "dialogue"
        }
