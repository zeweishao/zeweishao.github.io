{
  "bookId": "hero-211102",
  "id": "bond-28561",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "28561001",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "抱歉，我刚刚又睡着了。",
          "type": "dialogue"
        },
        {
          "sourceId": "28561002",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "你看起来很累，一直都没好好休息过吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "28561003",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "我担心外面不安全，只有守在门口才能放心。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "28561005",
              "text": "你太紧绷了。"
            }
          ],
          "sourceId": "28561004",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "28561005",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "不知不觉就想守护点什么，我习惯了。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "28561007",
              "text": "那么这次换我来守护你吧。"
            }
          ],
          "sourceId": "28561006",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "28561007",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "这、这怎么可以，你不是外面那些怪物们的对手。",
          "type": "dialogue"
        },
        {
          "sourceId": "28561008",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "嘘，安静下来。",
          "type": "dialogue"
        },
        {
          "sourceId": "28561009",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "这里没有怪物，这里比什么地方都安全。",
          "type": "dialogue"
        },
        {
          "sourceId": "28561010",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "贤秀可以彻底地好好放松下来，再睡一会吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "28561011",
          "sourceType": 0,
          "speaker": "车贤秀",
          "text": "唔……",
          "type": "dialogue"
        }
      ],
