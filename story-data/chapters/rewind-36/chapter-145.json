            33031022,
            33031023
          ],
          "sectionId": 33031
        }
      ],
      "title": "晨星之海·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "33032001",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "箱子里就是我准备的礼物，要不要先猜猜看，里面是什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "33032002",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "敲敲，声音听起来像是玻璃，还有一股潮湿的气息。\n再结合这个大小判断——",
          "type": "dialogue"
        },
        {
          "sourceId": "33032003",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "哼哼，本王猜到了！\n是泡在水里的一大块玻璃！",
          "type": "dialogue"
        },
        {
          "sourceId": "33032004",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "莉可猜错了哦，是水族箱。",
          "type": "dialogue"
        },
        {
          "sourceId": "33032005",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "笨、笨蛋！怎么想也是水族箱才对吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "33032006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "水族箱......？\n主人，为什么会买这个呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "33032007",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "说来很巧，是在FULI商店买到的。\n有一位店员向我推销——",
          "type": "dialogue"
        },
        {
          "sourceId": "33032008",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "「把手办放在水族箱后面拍照，这样就会有置身水底的梦幻效果」。\n于是我就被说动了。",
          "type": "dialogue"
        },
        {
          "sourceId": "33032009",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "隔着水族箱拍照？真没意思！\n这么漂亮的水族箱，当然要跳下去玩个痛快才行！",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "33032011",
              "text": "会溺水吧？"
            },
            {
              "targetId": "33032011",
              "text": "会掉漆吧？"
            }
          ],
          "sourceId": "33032010",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "33032011",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "没关系，我会告诉每一滴水，用最温柔的怀抱迎接她们。\n可以允许我们下水吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "33032012",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "已经很久没有见到......如此清澈的水流了。",
          "type": "dialogue"
        },
        {
          "sourceId": "33032013",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "稍等，我查一下保养手册。\n手办短时间浸在水中，应该没有什么问题——",
          "type": "dialogue"
        },
        {
          "sourceId": "33032014",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "呜呼！那还等什么，马上出发吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "33032015",
          "sourceType": 3,
          "text": "噗通——哗啦！",
          "type": "narration"
        }
      ],
      "id": "detail-763",
      "sourceRefs": [
        {
          "bundle": "qiluo",
          "rowIds": [
            33032001,
            33032002,
            33032003,
            33032004,
            33032005,
            33032006,
            33032007,
            33032008,
            33032009,
            33032010,
            33032011,
            33032012,
            33032013,
            33032014,
            33032015
          ],
          "sectionId": 33032
        }
      ],
      "title": "晨星之海·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "33033001",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "咕......咕噜噜噜。\n奇、奇怪的感觉，我居然在水里还能说话？",
          "type": "dialogue"
        },
        {
          "sourceId": "33033002",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "我已经赋予你们水之力量的加护，可以尽情在水中畅游。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033003",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "好耶，出发出发，找到海底失落的宝藏！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033004",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "莉可，那我们也——出发吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033005",
          "sourceType": 5,
          "text": "噗通！",
          "type": "narration"
        },
        {
          "sourceId": "33033006",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "是谁，谁推的我？\n本王可没说要下来！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033007",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "莉可，不用怕！\n往前冲，向着星辰大海！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033008",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "才没有害怕，本王只是不想弄湿自己的身体——\n鱼，好大的鱼，别过来呀呀呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033009",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "咯咯咯，莉可，你听说过怪谈「水族箱之谜」吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "33033010",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "据说水族箱中沉睡的冤魂，是曾经遇难的水手。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033011",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "水鬼会紧盯进入水族箱中的人，捕捉他们的灵魂。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033012",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "如果被抓住，就会从亲友的视线和记忆中永远消失——",
          "type": "dialogue"
        },
        {
          "sourceId": "33033013",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "住、住口，别再讲了！\n本王要上岸，放我出去啊——！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033014",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "快过来，我帮你们擦干身体。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033015",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "呼——不错不错，很符合本王身份的休闲方式。\n你有心了。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033016",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "大鲨鱼来喽！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033017",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "呀啊！咳，咳咳！\n这、这点小儿科就想吓到本王吗？真是太小看......",
          "type": "dialogue"
        },
        {
          "sourceId": "33033018",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "水手的冤魂来了——",
          "type": "dialogue"
        },
        {
          "sourceId": "33033019",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "呜啊啊啊啊！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "33033020",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "久违地......有种温暖的感觉。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033021",
          "sourceType": 2,
          "speaker": "奇萝",
          "text": "不妙呀，幽灵对某处产生留恋的话，可是会成为地缚灵的。",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "33033022",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "但是，能够随心所欲地度过有限而完整的一生，属于手办的一生……",
          "type": "dialogue"
        },
        {
          "sourceId": "33033023",
          "sourceType": 2,
          "speaker": "奇萝",
          "text": "似乎，也是一种不错的选择呢。",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "33033024",
          "sourceType": 2,
          "speaker": "奇萝",
          "text": "嗯，这样就足够了吧。太贪心的话，会被恶灵缠身哦。",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "33033025",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "泡完澡再把身上晒干，好舒服——\n奇萝也一起来吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "33033026",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "呼——阳光照在身上，暖乎乎的。\n难得能尽情晒太阳了，要好好享受才行。",
          "type": "dialogue"
        },
        {
          "sourceId": "33033027",
          "sourceType": 2,
          "speaker": "奇萝",
          "text": "心情无比平静，如果真的是幽灵，恐怕已经......\n成佛了吧......",
          "tone": "thought",
          "type": "dialogue"
        }
      ],
      "id": "detail-764",
      "sourceRefs": [
        {
          "bundle": "qiluo",
          "rowIds": [
            33033001,
            33033002,
