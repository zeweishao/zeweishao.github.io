            33035017,
            33035018,
            33035019,
            33035020,
            33035021
          ],
          "sectionId": 33035
        },
        {
          "bundle": "qiluo",
          "rowIds": [
            33036001,
            33036002
          ],
          "sectionId": 33036
        }
      ],
      "title": "晨星之海·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "33038001",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "自从成为「幽灵」之后，已经很久......没有梦到过灵异事件了。",
          "type": "dialogue"
        },
        {
          "sourceId": "33038002",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "究竟是怎么回事......有点晕乎乎的......昨晚，我听到歌声——",
          "type": "dialogue"
        },
        {
          "sourceId": "33038003",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "然后贝歌叫醒我，对我说......",
          "type": "dialogue"
        },
        {
          "sourceId": "33038004",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "不对，究竟哪里开始是梦？\n从雕塑说话开始，还是从听到歌声开始......",
          "type": "dialogue"
        },
        {
          "sourceId": "33038005",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "还是说——\n变成手办后的一切，都只是梦境而已吗？头、好痛——",
          "type": "dialogue"
        },
        {
          "sourceId": "33038006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "嘘——三、二、一！\n哇吼！",
          "type": "dialogue"
        },
        {
          "sourceId": "33038007",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "哇、哇吼！我们是幽灵，被我们盯上就会.....",
          "type": "dialogue"
        },
        {
          "sourceId": "33038008",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "嗯，那个......就会陷进可怕的梦里无法醒来！",
          "type": "dialogue"
        },
        {
          "sourceId": "33038009",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "嘿嘿......吓，吓唬人真的挺有趣的。\n我稍微......有点理解奇萝的兴趣了。",
          "type": "dialogue"
        },
        {
          "sourceId": "33038010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "和江和江，你看，我和花迦成功吓到奇萝了！\n她愣住一动不动，肯定是被吓了一大跳呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "33038011",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "优纪？我昨天......",
          "type": "dialogue"
        },
        {
          "sourceId": "33038012",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "你昨天一定是累坏了，从文艺研究社回来就昏睡过去。",
          "type": "dialogue"
        },
        {
          "sourceId": "33038013",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "毛巾是主人帮你盖上的，|102|让我们不要叫醒你。",
          "type": "dialogue"
        },
        {
          "sourceId": "33038014",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "果然，那些会说话的雕像只是梦......",
          "type": "dialogue"
        },
        {
          "sourceId": "33038015",
          "sourceType": 0,
          "speaker": "奇萝",
          "text": "......不，不对！文艺研究社？！我们昨天不是在水里......",
          "type": "dialogue"
        },
        {
          "sourceId": "33038016",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "没错！我们昨天约好了，要去找水里的女鬼！",
          "type": "dialogue"
        },
        {
          "sourceId": "33038017",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪记错了，我们现在要去探查的第六大不可思议，叫作「缸中的幽灵」。",
          "type": "dialogue"
        },
        {
          "sourceId": "33038018",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "差、差不多嘛，别在意。\n快走吧奇萝，我已经等不及了！",
          "type": "dialogue"
        }
      ],
