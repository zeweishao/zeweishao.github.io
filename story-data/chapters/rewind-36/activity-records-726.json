  "sections": [
    {
      "blocks": [
        {
          "text": "自认为幽灵的少女带来的礼物竟然是M城的都市怪谈集。",
          "title": "怪奇事件簿",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "M城传说"
    },
    {
      "blocks": [
        {
          "text": "亲身去见证这些午夜怪谈吧！",
          "title": "怪奇事件簿",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "不可思议"
    },
    {
      "blocks": [
        {
          "text": "生存还是死亡呢，这是艺术家面临的问题。",
          "title": "怪奇事件簿",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "写实艺术"
    },
    {
      "blocks": [
        {
          "text": "话语和眼睛也许会欺骗你，但行动不会。",
          "title": "怪奇事件簿",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "表里不一"
    },
    {
      "blocks": [
        {
          "text": "愿你得见星辰与日出，大海与天空。",
          "title": "怪奇事件簿",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "晨星之海"
    },
    {
      "blocks": [
        {
          "text": "笃、笃、笃，请开门吧，你的快递到了。",
          "title": "异闻笔录",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "会动的纸箱"
    },
    {
      "blocks": [
        {
          "text": "双脚悬空，痛苦的挣扎，生命走向了……",
          "title": "异闻笔录",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "悬挂的影子"
    },
    {
      "blocks": [
        {
          "text": "夜半时分，琴房中响起幽怨的歌声。",
          "title": "异闻笔录",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "夜半的哀歌"
    },
    {
      "blocks": [
        {
          "text": "粘稠的汁液肆意流淌，描绘出诡异图腾。",
          "title": "异闻笔录",
          "type": "profile"
        }
      ],
      "id": "stage-9",
      "title": "粘稠的汁液"
    },
    {
      "blocks": [
        {
          "text": "午夜十二点后，不可窥探门后世界。",
          "title": "异闻笔录",
          "type": "profile"
        }
      ],
      "id": "stage-10",
      "title": "打不开的门"
    }
  ],
