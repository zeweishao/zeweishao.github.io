            20010007,
            20010008,
            20010009,
            20010010,
            20010011,
            20010012,
            20010013,
            20010014,
            20010015,
            20010016,
            20010017,
            20010018,
            20010019,
            20010020,
            20010021,
            20010022,
            20010023,
            20010024,
            20010025,
            20010026,
            20010027,
            20010028,
            20010029,
            20010030,
            20010031,
            20010032
          ],
          "sectionId": 20010
        }
      ],
      "title": "大地诗篇·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "20011001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "真是好奇啊~明智先生准备的篝火晚会，到底会是什么样的呢？据说还有巨大惊喜什么的~",
          "type": "dialogue"
        },
        {
          "sourceId": "20011002",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "薇薇安，你还好吗？刚在出发的时候就有些心不在焉的样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011003",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "诶……大概是在和优纪思考一样的事情哦。真期待啊，明智先生的篝火晚会。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011004",
          "sourceType": 0,
          "speaker": "雪人",
          "text": "找不到了，为什么会找不到了！",
          "type": "dialogue"
        },
        {
          "sourceId": "20011005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "唔，前面那个是，雪人先生？他好像很焦虑的样子，不知道遇到了什么麻烦。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "一直低着头，看上去是在找什么，大概是弄丢什么东西了。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011007",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "我们过去看看，也许我们可以帮上忙。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011008",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "怎么会不见了呢……这下该怎么办……",
          "type": "dialogue"
        },
        {
          "sourceId": "20011009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "唔！不只是雪人先生，还有一位身着誓约盛装的美人也在这里呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011010",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "你、你们好，我是海伦，来自罗贝尔，现在服务于管理局。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011011",
          "sourceType": 7,
          "text": "海伦 · 神圣誓约\n商品名称：海伦·神圣誓约 Ver.\n作品名称：《永恒的异界幻想》\n制造商：TENMA 天马\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约240mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "20011012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "管理局我听说过，说起来我们和管理局的关系还不浅呢。不过你为什么会出现在这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "20011013",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "有人委托我帮忙拍摄一组婚纱照，帮忙推销她的作品，可是在赶往拍摄场地的路上，不小心把捧花弄丢了……",
          "type": "dialogue"
        },
        {
          "sourceId": "20011014",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "诶诶，原来是弄丢了捧花，难怪会那么着急呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011015",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "我们可以分头帮忙找一找，你还记得你最后见到捧花是什么时候吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "20011016",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "大概是半个小时之前。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011017",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "半个小时的话，应该不会丢太远。我们人多，找到的概率更大。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011018",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "明白~我来负责那边那个方向，保证完成任务~",
          "type": "dialogue"
        },
        {
          "sourceId": "20011019",
          "sourceType": 9,
          "text": "一段时间后，几人在约定的地方汇合，可是令人失望的是……她们完全找不到任何捧花的线索。",
          "type": "narration"
        },
        {
          "sourceId": "20011020",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "真是太糟糕了……连一朵花都没看到。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011021",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "会不会是被路过的手办捡走了？或者被猫猫鸟鸟之类的东西叼走了也说不定。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011022",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "如果真是这样的话，岂不是等于说找到的可能性为零了……",
          "type": "dialogue"
        },
        {
          "sourceId": "20011023",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "其实也不是完全没有办法，如果实在找不到的话，那么我们就来帮海伦做一束新的吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "20011024",
          "sourceType": 0,
          "speaker": "薇薇安",
          "text": "我对花艺技巧还算略有心得，再加上明智先生这个智囊，绝对会让海伦眼前一亮的。",
          "type": "dialogue"
        },
        {
          "sourceId": "20011025",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这个办法太好了，一起努力制作一束比原来更加美丽的捧花吧！",
          "type": "dialogue"
        }
      ],
