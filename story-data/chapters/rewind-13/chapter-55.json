            16381009
          ],
          "sectionId": 16381
        },
        {
          "bundle": "miku",
          "rowIds": [
            16382001,
            16382002,
            16382003,
            16382004,
            16382005,
            16382006,
            16382007,
            16382008,
            16382009
          ],
          "sectionId": 16382
        }
      ],
      "title": "春和景明前篇·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "16390001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "门铃响了，我…我去看看！",
          "type": "dialogue"
        },
        {
          "sourceId": "16390002",
          "sourceType": 0,
          "speaker": "猪猪",
          "text": "你好，叨扰了，柯斯顿那边的工作事宜刚刚结束，\n龙王大人是来考察庆典筹备情况的。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390003",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "不必拘谨，吾只是顺道拜访，\n不过隔着门就听到里面吵吵闹闹，预备的节目都排好了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16390004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "噢，龙王大人……今天我们有好好练习，大家进步都很多呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哎，不如我们现在跳一遍给龙王大人看看，红盒子，音乐！",
          "type": "dialogue"
        },
        {
          "sourceId": "16390006",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "那就演示一下吧，希望节目效果能跟你们的信心成正比。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390007",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "只有这样而已吗？\n真是懈怠的家伙们，看你们轻松闲散的样子，还以为建成日庆典已经完美谢幕了。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390008",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "因为觉得已经足够优秀就停止努力，哼，人类的劣根性。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390009",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "请问，Miku她，还在练习吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16390010",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "哼，那种努力又认真的态度，\n如果在过去，大概也能成为什么了不起的城主。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "真想亲眼看看啊，Miku工作时的样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "16390012",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "哼，不如就带你们去看看好了，免得你们在这里沾沾自喜。\n小心不要妨碍别人工作，她可是我重要的嘉宾。",
          "type": "dialogue"
        },
        {
          "sourceId": "16391001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇奥——好漂亮的场景！",
          "type": "dialogue"
        },
        {
          "sourceId": "16391002",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "没想到拍摄工作也这么辛苦。",
          "type": "dialogue"
        },
        {
          "sourceId": "16391003",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "当然，为了定格到最完美的瞬间，明星要格外注重自己的体态和神情，\n对光线、氛围、镜头的把握也十分重要，这需要长年的积累和千百遍的练习。",
          "type": "dialogue"
        },
        {
          "sourceId": "16391004",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "为了练习完美微笑，除去吃饭睡觉一整天都要对着镜子咬筷子呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "16391005",
          "sourceType": 0,
          "speaker": "克罗赛尔·小甜甜",
          "text": "你的眼睛告诉我，你很期待对着镜头展示自己的身体呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "16391006",
          "sourceType": 0,
          "speaker": "猪猪",
          "text": "咳……龙王大人，不如让表演者们也参加拍摄吧？\n虽然说不是什么轻松的工作，就当从高强度练习里放松一下。",
          "type": "dialogue"
        },
        {
          "sourceId": "16392001",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "这位爷爷很懂女人心呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "16392002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "真的可以吗！参加拍摄！？",
          "type": "dialogue"
        },
        {
          "sourceId": "16392003",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "别想拿这个当偷懒的借口，\n拍完了就赶紧回去给我继续练习！",
          "type": "dialogue"
        }
      ],
