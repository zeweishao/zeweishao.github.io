{
  "bookId": "rewind-13",
  "id": "chapter-57",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "16450001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "下一个地点是……啊，是这里。\n“地方物语答题”?我们要参加吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16450002",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "可以。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450003",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "答题阿……听起来就很头痛，有没有什么格斗大赛之类的东西？",
          "type": "dialogue"
        },
        {
          "sourceId": "16450004",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "可是庆典要大家一起玩才有趣呀。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450005",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "这种文雅又淑女的活动，绿子不想参加也可以理解。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450006",
          "sourceType": 2,
          "speaker": "艾里克希娅",
          "text": "Miku出现的地方可是我出名的好机会，我绝不会放过。",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "16450007",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "艾里克希娅看上去蠢蠢欲动……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450008",
          "sourceType": 0,
          "speaker": "周瑜",
          "text": "“地方物语答题”，奖品是……嗯，好漂亮的袖扣。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450009",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "答题阿，好像很轻松的样子，要试试看吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16450010",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "活动参赛者请到准备区就位，参赛每组人数上限两人，采用抢答制。\n开始念题目时就可以按铃抢答了，答对加两分，答错扣两分，超时扣两分。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450011",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "大家自行组队入座，记得把队名填在桌前的名牌上。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450012",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "第一题，当今世上，最高贵端庄、最从容优雅、最美丽大方、最博学多识、最深明大义、最英勇神武、最……的龙，是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "16450013",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "叮咚——！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450014",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "艾伦兹·珀尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450015",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "很棒，回答正确。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450016",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450017",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "好厉害，竟然可以运用这么多成语去描述一个人。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450018",
          "sourceType": 0,
          "speaker": "玩具兔",
          "text": "哈哈哈哈，太不要脸了，这是把《成语词典》全都搬空进去吗哈哈哈哈哈哈……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450019",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "第二题，现任家主，守护者，至高权力者，现任龙王是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "16450020",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "叮咚——！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450021",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "艾伦兹·珀尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450022",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "好快！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450023",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "很棒，回答正确。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450024",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "第三题，",
          "type": "dialogue"
        },
        {
          "sourceId": "16450025",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "叮咚——！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450026",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "哎，哎，先让人说题目阿！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450027",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "艾伦兹·珀尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450028",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "很棒，回答正确。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450029",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450030",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "第四题，拥有三千年深厚历史底蕴的、举世无双的、镶嵌在家主大人权……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450031",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "叮——",
          "type": "dialogue"
        },
        {
          "sourceId": "16450032",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "叮咚——！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450033",
          "sourceType": 5,
          "speaker": "哈莉",
          "text": "嘿，我抢到了！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450034",
          "sourceType": 5,
          "speaker": "小红",
          "text": "赢了！哈莉赢了！",
          "type": "dialogue"
        },
        {
          "sourceId": "16450035",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "这位选手，请答题，倒计时，五，四，三……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450036",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "啊哈，我不知道。",
          "type": "dialogue"
        },
        {
          "sourceId": "16450037",
          "sourceType": 0,
          "speaker": "诸葛孔明",
          "text": "噗……",
          "type": "dialogue"
        },
        {
          "sourceId": "16450038",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "加油，答案再想想。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451001",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "你过来。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451002",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "骑士大人，您也想要参加吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16451003",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "不，你下去，我来出题。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451004",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "哼哼，真是好猜的套路，接下来就轮到我的表演时间了！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451005",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "第十九题，蠢透了的龙是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "16451006",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "叮咚——！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451007",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "艾伦兹·珀尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451008",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "请问这是正确答案吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "16451009",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "当然。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451010",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "回答正确。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451011",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "第二十题……",
          "type": "dialogue"
        },
        {
          "sourceId": "16451012",
          "sourceType": 5,
          "speaker": "绿子",
          "text": "喔，我好像也会……我知道！是艾伦兹·珀尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451013",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "艾伦……",
          "type": "dialogue"
        },
        {
          "sourceId": "16451014",
          "sourceType": 5,
          "speaker": "艾里克希娅",
          "text": "绿子，不要抢我题目！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451015",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "才怪，这可是我难得会答的题目，绝不会输给你的！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451016",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "怎么办……我阻止不了骑士大人，这样下去……家主大人会掀翻这里的……",
          "type": "dialogue"
        },
        {
          "sourceId": "16451017",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "对，家主大人，我要去找家主大人。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451018",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "第二十一题，曾经因为吃太多，导致体重超过了200斤，从屋顶上摔下来的是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "16451019",
          "sourceType": 5,
          "speaker": "绿子",
          "text": "艾伦兹·珀尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451020",
          "sourceType": 5,
          "speaker": "艾里克希娅",
          "text": "艾伦兹·珀尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451021",
          "sourceType": 5,
          "speaker": "哈莉",
          "text": "艾伦兹·珀尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451022",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "艾伦兹·珀尔！",
          "type": "dialogue"
        },
        {
          "sourceId": "16451023",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "回答正确。",
          "type": "dialogue"
        },
        {
          "sourceId": "16451024",
          "sourceType": 5,
          "speaker": "艾伦兹·珀尔",
          "text": "阿斯塔罗斯！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "16452001",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "以上就是本次活动的全部题目了，感谢大家的参与。\n请到休息区享用下午茶，耐心等待比分结果~",
          "type": "dialogue"
        },
        {
          "sourceId": "16452002",
          "sourceType": 2,
          "speaker": "牙牙",
          "text": "呜，牙牙我好艰难。请接下来的比赛千万别再出现这种情况了。",
          "tone": "thought",
          "type": "dialogue"
        }
      ],
      "id": "detail-352",
