            43218010,
            43218011,
            43218012,
            43218013,
            43218014
          ],
          "sectionId": 43218
        }
      ],
      "title": "决断之时 · Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "43219001",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "检查了每个角落，很遗憾，毫无所获。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219002",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "会不会是坐标信息出了问题。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219003",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "坐标经过了帕拉斯的检测，这个可能性很小。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219004",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "也许，你们需要重新考虑线索的意义，",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "43219006",
              "text": "竟然是蒂娅！"
            },
            {
              "targetId": "43219006",
              "text": "你一直在寻找优纪吗？"
            }
          ],
          "sourceId": "43219005",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "43219006",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "我从未有一刻放弃寻找，因为另一个「我」一直在呼唤着。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219007",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "我能感受到，那个声音越来越近了。跟我来。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219008",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "还是没有见到优纪，那个神秘留言不会是在耍我们吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "43219009",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "凝神，仔细听，声音是从那个方向传来的。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219010",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "快，我们跟上声音的方向。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "主人主人，优纪在这里！优纪好想你呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "43219012",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "能再次见到你真好，我的主人。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219013",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "对不起，花迦不应该哭的……可我完全无法控制自己，呜……",
          "type": "dialogue"
        },
        {
          "sourceId": "43219014",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "真的是你们……我、我不是在做梦吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "43219015",
          "sourceType": 0,
          "speaker": "帕拉斯",
          "text": ">>>检测到加密芯片中含有一封隐藏邮件，已触发解锁条件。",
          "type": "dialogue"
        },
        {
          "sourceId": "43219016",
          "sourceType": 0,
          "speaker": "帕拉斯",
          "text": "「享受这份欢乐吧，希塔，这会是旧时代最后的荣光。」",
          "type": "dialogue"
        },
        {
          "sourceId": "43219017",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "导师？她为什么要这么做？",
          "type": "dialogue"
        }
      ],
      "id": "detail-1150",
      "sourceRefs": [
        {
          "bundle": "ladon",
          "rowIds": [
            43219001,
            43219002,
            43219003,
            43219004,
            43219005,
            43219006,
            43219007,
            43219008,
            43219009,
            43219010,
            43219011,
            43219012,
            43219013,
            43219014,
            43219015,
            43219016,
            43219017
          ],
          "sectionId": 43219
        }
      ],
      "title": "决断之时 · Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "43220001",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "欢迎回家，优纪、和江、花迦，我们大家都很想你们！",
          "type": "dialogue"
        },
        {
          "sourceId": "43220002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "太好了！重新回到主人身边，就好像做了一场梦一样呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220003",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "谢谢各位，没有你们，我们可能永远也不会回来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220004",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "能平安归来就好，这里永远是你们的家。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220005",
          "sourceType": 0,
          "speaker": "菈冬",
          "text": "热闹起来了啊，真好，我总觉得之前的家里太沉闷了点。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220006",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "家里一下子多了很多新成员，主人的人缘还是一如既往得好。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220007",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "不如大家一起举办庆祝晚宴吧，庆祝你们的归来！",
          "type": "dialogue"
        },
        {
          "sourceId": "43220008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇哈哈哈，晚宴什么的，优纪最喜欢了！",
          "type": "dialogue"
        },
        {
          "sourceId": "43220009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "我们呀，可是有很多很多话要讲给主人听呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "43220010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "回家的感觉真好呢，每个角落都充满了回忆的喜悦。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220011",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "离开的这段时间，越发感受到陪伴在主人身边的珍贵。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "43220013",
              "text": "你们早已成为了我生活的一部分。"
            }
          ],
          "sourceId": "43220012",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "43220013",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "还记得有年春天，优纪和主人一起为樱花树挂上风铃。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220014",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "嗯，还有一位远方来的歌姬为我们献唱，印象深刻。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "还有还有，优纪和大家一起偷偷给主人写作业的事……",
          "type": "dialogue"
        },
        {
          "sourceId": "43220016",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "那次险些被其他人发现，所幸有惊无险。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220017",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "点点滴滴，全都是属于我们的共同回忆。",
          "type": "dialogue"
        },
        {
          "sourceId": "43220018",
          "sourceType": 0,
          "speaker": "优纪",
