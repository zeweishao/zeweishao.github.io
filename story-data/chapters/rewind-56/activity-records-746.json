  "sections": [
    {
      "blocks": [
        {
          "text": "在尘埃之下，那些被遗忘的线索悄然连接着过去与现在的秘密。",
          "title": "战场上的扫荡者",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "废墟之秘"
    },
    {
      "blocks": [
        {
          "text": "在风起云涌的局势中，激起波澜壮阔的竞争和计谋，谁能赢到最后。",
          "title": "战场上的扫荡者",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "金币风波"
    },
    {
      "blocks": [
        {
          "text": "那些未被言说的秘密，悄无声息地影响着每个人的命运。",
          "title": "战场上的扫荡者",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "隐秘真相"
    },
    {
      "blocks": [
        {
          "text": "久别的心灵在不经意间找到了彼此的轨迹，重燃旧日的甜蜜与温存。",
          "title": "战场上的扫荡者",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "决断之时"
    },
    {
      "blocks": [
        {
          "text": "在碎石之下，她用满怀希望的目光搜寻着，期待发掘出埋藏已久的金银财宝。",
          "title": "究极的金币猎手",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "残垣寻宝"
    },
    {
      "blocks": [
        {
          "text": "每一个细节都被精心打磨和清洗，她宛如赋予这些废弃物第二次生命。",
          "title": "究极的金币猎手",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "极致净化"
    },
    {
      "blocks": [
        {
          "text": "在追逐无尽财富的冒险中，她机敏而果敢，每一步都充满了刺激与挑战。",
          "title": "究极的金币猎手",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "无尽宝藏"
    },
    {
      "blocks": [
        {
          "text": "她的巢穴布满无尽的禁忌金币，每一枚金币都闪耀着危险的光芒。",
          "title": "究极的金币猎手",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "蕴奇待价"
    }
  ],
