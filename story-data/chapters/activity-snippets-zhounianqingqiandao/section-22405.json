  "id": "section-22405",
  "sections": [
    {
      "blocks": [
        {
          "noticeKind": "placeholder",
          "text": "原文中的动态称谓保留为占位符：|101|＝玩家昵称。",
          "type": "notice"
        }
      ],
      "id": "reading-note",
      "title": "阅读说明"
    },
    {
      "blocks": [
        {
          "sourceId": "22405001",
          "sourceType": 10,
          "text": "阿尔弗雷德时尚秀",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "22405002",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你？我觉得还不错。",
          "type": "dialogue"
        },
        {
          "sourceId": "22405003",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "现在，全世界的焦点，「时尚之王」阿尔弗雷德——\n将为你带来前所未有的视觉体验。",
          "type": "dialogue"
        },
        {
          "sourceId": "22405004",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "欢迎来到一年一度的阿尔弗雷德时装超级秀场！",
          "type": "dialogue"
        },
        {
          "sourceId": "22405005",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "现在，让我听到你的尖叫。",
          "type": "dialogue"
        },
        {
          "sourceId": "22405006",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "「为了世界和平！一起加油吧！」",
          "type": "dialogue"
        },
        {
          "sourceId": "22405007",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "「我将终身侍奉光明，也侍奉你。」",
          "type": "dialogue"
        },
        {
          "sourceId": "22405008",
          "sourceType": 0,
          "speaker": "蓝莎·纯白誓约",
          "text": "「你，胜于一切。」",
          "type": "dialogue"
        },
        {
          "sourceId": "22405009",
          "sourceType": 0,
          "speaker": "拉斐尔",
          "text": "「如果你不再需要我，我就会一直这样一个人呆在这里。因为我已经属于你。」",
          "type": "dialogue"
        },
        {
          "sourceId": "22405010",
          "sourceType": 0,
          "speaker": "克罗赛尔·诱惑",
          "text": "「一起缔结这禁忌的契约，让我享受到最后一刻吧！」",
          "type": "dialogue"
        },
        {
          "sourceId": "22405011",
          "sourceType": 3,
          "text": "咝咝~咝咝~",
          "type": "narration"
        },
        {
          "sourceId": "22405012",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "阿尔弗雷德——你这家伙——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22405013",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你来做什么？麻烦你敬畏时尚，尊重艺术。",
          "type": "dialogue"
        },
        {
          "sourceId": "22405014",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "什么时尚，我看你是想用歪门邪道诱拐吾的专属人类！",
          "type": "dialogue"
        },
        {
          "sourceId": "22405015",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "愚昧，无知，这是心的时尚！爱的艺术！",
          "type": "dialogue"
        },
        {
          "sourceId": "22405016",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "狡猾的家伙……唔唔唔——喂，阿斯塔罗斯，你到底跟谁一伙，让开！别拦着我！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22405017",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "吵吵闹闹，哪有龙王的样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "22405018",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "不要管她，表演继续——各单位注意，Ready——",
          "type": "dialogue"
        },
        {
          "sourceId": "22405019",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "可恶，又被抢先了……\n我还没有告诉|101|，与龙族联姻的方法！",
          "type": "dialogue"
        }
      ],
