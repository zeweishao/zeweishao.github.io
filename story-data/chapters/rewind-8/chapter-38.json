{
  "bookId": "rewind-8",
  "id": "chapter-38",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "4310001",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "艾伦兹，做好准备，我们要准备迎战了。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310002",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "你可不要拖我后腿。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310003",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "被蠢家主这么说，令我很不爽。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310004",
          "sourceType": 0,
          "speaker": "柠檬仔",
          "text": "9",
          "type": "dialogue"
        },
        {
          "sourceId": "4310005",
          "sourceType": 0,
          "speaker": "苦丁",
          "text": "10",
          "type": "dialogue"
        },
        {
          "sourceId": "4310006",
          "sourceType": 0,
          "speaker": "柠檬仔",
          "text": "J",
          "type": "dialogue"
        },
        {
          "sourceId": "4310007",
          "sourceType": 0,
          "speaker": "苦丁",
          "text": "Q",
          "type": "dialogue"
        },
        {
          "sourceId": "4310008",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "哦，在玩扑克牌啊，不如吾也一起吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310009",
          "sourceType": 0,
          "speaker": "柠檬仔",
          "text": "这个声音好像在哪里听过。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310010",
          "sourceType": 0,
          "speaker": "苦丁",
          "text": "这个脸好像也在哪里见过。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310011",
          "sourceType": 0,
          "speaker": "柠檬仔",
          "text": "？！家主龙王！",
          "type": "dialogue"
        },
        {
          "sourceId": "4310012",
          "sourceType": 0,
          "speaker": "苦丁",
          "text": "双王炸。",
          "type": "dialogue"
        },
        {
          "sourceId": "4310013",
          "sourceType": 0,
          "speaker": "柠檬仔",
          "text": "蠢货！你还出牌？快跑啊！",
          "type": "dialogue"
        }
      ],
      "id": "detail-257",
      "sourceRefs": [
        {
          "bundle": "honglong",
          "rowIds": [
            4310001,
            4310002,
            4310003,
            4310004,
            4310005,
            4310006,
            4310007,
            4310008,
            4310009,
            4310010,
            4310011,
            4310012,
            4310013
          ],
          "sectionId": 4310
        }
      ],
      "title": "家主大人终章·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "4320001",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "那家伙的手下真不少。喂你还可以吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "4320002",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "这话我问你。如果你累了，就趁早退出。",
          "type": "dialogue"
        },
        {
          "sourceId": "4320003",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "龙族可是很记仇的，无论如何我都会夺回我的房子。",
          "type": "dialogue"
        },
        {
          "sourceId": "4320004",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "好强的眼神真不错。",
          "type": "dialogue"
        }
      ],
      "id": "detail-258",
      "sourceRefs": [
        {
          "bundle": "honglong",
          "rowIds": [
            4320001,
            4320002,
            4320003,
            4320004
          ],
          "sectionId": 4320
        }
      ],
      "title": "家主大人终章·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "4330001",
          "sourceType": 0,
          "speaker": "弹簧猫",
          "text": "狩猎者大人！他们又来了……噗。\n谁……把门踢掉……压住我了……",
          "type": "dialogue"
        },
        {
          "sourceId": "4330002",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "哦，真是不好意思，不知道你的手下在门后，脚没控制住力道。",
          "type": "dialogue"
        },
        {
          "sourceId": "4330003",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "还以为是什么东西，这不是夹着尾巴逃跑的龙王大人吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "4330004",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "你们这是故意损坏财物，还有非法入侵哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "4330005",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "直接打吧，这家伙抢我台词。",
          "type": "dialogue"
        },
        {
          "sourceId": "4330006",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "啊，这么粗暴。不再聊会吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "4330007",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "真有趣，吾还是第一次和尸体说话。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331001",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "你输了，你是希望吾将你踹下去，还是自己走?",
          "type": "dialogue"
        },
        {
          "sourceId": "4331002",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "你终有一天会明白人类有多自私。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331003",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "无所谓。这和吾有什么关系。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331004",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "吾可是龙王大人，保护人族这种生命稍纵即逝的生物，不过是用来消磨时光。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331005",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "况且，只要吾有钱，要什么样的人没有。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331006",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "土包子。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331007",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "明明就是喜欢人类，你什么时候可以改一下口是心非的习惯。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331008",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "4331009",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "哼。我就是喜欢人族，你管得着。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331010",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "这么坦率的你还真是第一次见到。",
          "type": "dialogue"
        },
        {
          "sourceId": "4331011",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "好好珍惜，没有以后了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-259",
      "sourceRefs": [
        {
          "bundle": "honglong",
          "rowIds": [
            4330001,
            4330002,
            4330003,
            4330004,
            4330005,
            4330006,
            4330007
          ],
          "sectionId": 4330
        },
        {
          "bundle": "honglong",
          "rowIds": [
            4331001,
            4331002,
            4331003,
            4331004,
            4331005,
            4331006,
            4331007,
            4331008,
            4331009,
            4331010,
            4331011
          ],
          "sectionId": 4331
        }
      ],
      "title": "家主大人终章·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "4340001",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "假冒家主的事情终于解决了，那么接下来该算一下我们之间的这笔账了。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340002",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "龙焰。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340003",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "这是什么意思？",
          "type": "dialogue"
        },
        {
          "sourceId": "4340004",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "最近你很嚣张嘛，先是不顾家主的痛苦，强迫我学习各种报表，来到这里之后，还处处不听从命令。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340005",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "我可是不爽你很久了。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340006",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "你还是老样子，这么爱记仇。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340007",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "阿斯塔罗斯，我之前说过的，吾等龙族同意与你解除契约，这是真的。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340008",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "现在我行使家主的最后一个命令，释放你的全部力量，与我堂堂正正的决一胜负。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340009",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "龙焰，Dracarys.NO.2",
          "type": "dialogue"
        },
        {
          "sourceId": "4340010",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "这个是新的传承能力？",
          "type": "dialogue"
        },
        {
          "sourceId": "4340011",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "是的，这股力量比以前的都要强大了。\n倒是要多亏了那个狩猎者，让我想起了这一招。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340012",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "不过呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "4340013",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "龙焰，Dracarys！",
          "type": "dialogue"
        },
        {
          "sourceId": "4340014",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "我还是喜欢用这招，毕竟用这种普通招式打败你，才有成就感。",
          "type": "dialogue"
        },
        {
          "sourceId": "4340015",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "我倒要看看家主你现在到底有多强。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341001",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "你赢不了我。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341002",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "是啊，已成败局。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341003",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "听吾之令，以吾之血，解除……",
          "type": "dialogue"
        },
        {
          "sourceId": "4341004",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "等会。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341005",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "？",
          "type": "dialogue"
        },
        {
          "sourceId": "4341006",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "解除契约之后我还有每月十个亿的工资可以领吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "4341007",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "……想得美。一个子都不会给你。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341008",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "哦，这样啊，那我不要解除契约了。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341009",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "你这家伙是故意和我作对的吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341010",
          "sourceType": 0,
          "speaker": "阿斯塔罗斯",
          "text": "是啊，我还挺享受的。",
          "type": "dialogue"
        },
        {
          "sourceId": "4341011",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "哼。",
          "type": "dialogue"
        }
      ],
      "id": "detail-260",
      "sourceRefs": [
