            3203012
          ],
          "sectionId": 3203
        }
      ],
      "title": "#1 失踪的樱"
    },
    {
      "blocks": [
        {
          "sourceId": "3204001",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "小贱人，看你还能往哪逃。",
          "type": "dialogue"
        },
        {
          "sourceId": "3204002",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "我本就没打算逃。",
          "type": "dialogue"
        },
        {
          "sourceId": "3204003",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "很好，算你有骨气。\n我从来不打女人，但今天我要为你破例，你知道为什么吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3204004",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3204005",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "哼，你居然胆敢向外界散播阿撒兹勒大人的情报，纵然你有着一副娇艳欲滴的外表，我也要亲手撕碎才能解恨。",
          "type": "dialogue"
        },
        {
          "sourceId": "3204006",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "呃啊……咳……咳咳咳……",
          "type": "dialogue"
        },
        {
          "sourceId": "3204007",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "现在才想求饶，晚了——受死吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "3204008",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "住手，我命令你。",
          "type": "dialogue"
        },
        {
          "sourceId": "3204009",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "又来了一个不要命的，正好，今天一并收拾了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205001",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "那两个家伙受了重伤，走不远的，给我仔细找。\n能找到活着的最好，倘若死了，我也要亲眼见到。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205002",
          "sourceType": 0,
          "speaker": "暴躁熊",
          "text": "是！",
          "type": "dialogue"
        },
        {
          "sourceId": "3205003",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "你……咳咳咳，你别管我了。\n他们随时都会追上来，你快逃吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205004",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你在质疑我的绅士素养么，嗯？\n海伦紧急联系我，让我赶来救你。如果她看到我独自一人返回，你以为等待我的会是什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "3205005",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "我明白了，让你丢下我的话不会再说了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205006",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你身上的伤看起来很严重，表层的涂装几乎全都脱落了……但这些瑕疵……我从未在其他同类手办身上见过，而且年代已久……我先带你去一趟黑街，那里一定有人知道怎么修复。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205007",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "黑街……太远了，我恐怕等不到了呢。\n抱歉，我有点累，想先睡一会。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205008",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "喂，赫兰德，你振作一点，千万别死。\n不行，我得想个办法……有了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205009",
          "sourceType": 13,
          "speaker": "M. The 3rd Sect.",
          "text": "与试炼者|101|取得联系中……请稍候。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205010",
          "sourceType": 13,
          "speaker": "玩家",
          "text": "喂，阿尔弗雷德？",
          "type": "dialogue"
        },
        {
          "sourceId": "3205011",
          "sourceType": 13,
          "speaker": "阿尔弗雷德",
          "text": "少废话，到我发给你这个地址来。\n我给你半小时的时间，超时的话，你的管理局实习生永远也别想有戏了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205012",
          "sourceType": 2,
          "speaker": "玩家",
          "text": "（第一次看到阿尔弗雷德这么紧张，看来是很重要的事情。）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "3205013",
          "sourceType": 13,
          "speaker": "玩家",
          "text": "我知道了，马上来。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205014",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "来得还算及时。\n我的同伴赫兰德受了很重的伤，需要尽快送往黑街救治，你……请你一定要尽快送她到黑街。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205015",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "嗯，方便的话，可以先到口袋里面去吗？我带你们过去。",
          "type": "dialogue"
        },
        {
          "sourceId": "3205016",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "……唔，我这是在哪？",
          "type": "dialogue"
        },
        {
          "sourceId": "3205017",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "在去黑街的路上，你还好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3205018",
          "sourceType": 0,
          "speaker": "赫兰德",
          "text": "阿尔弗雷德……\n我不想去黑街，你带我去另一个地方吧。",
          "type": "dialogue"
        }
      ],
      "id": "detail-132",
