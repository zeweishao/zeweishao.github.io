      "id": "reading-note",
      "title": "阅读说明"
    },
    {
      "blocks": [
        {
          "sourceId": "3130001",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "都给我打起精神来！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130002",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "阿撒兹勒大人马上就到了，你们可别给我丢脸！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130003",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "报——",
          "type": "dialogue"
        },
        {
          "sourceId": "3130004",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "什么事，我这正在为迎接阿撒兹勒大人做准备呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130005",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "流水线出现了重大事故……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130006",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "你说什么……？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "什么重大事故？",
          "type": "dialogue"
        },
        {
          "sourceId": "3130008",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "大大大人……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "虚礼就不必了，让你的部下带我去现场看看。",
          "type": "dialogue"
        },
        {
          "sourceId": "3130010",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "是。",
          "type": "dialogue"
        },
        {
          "sourceId": "3130011",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "昨晚上在清点发往FULI商店的货物时发现的……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130012",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "这些货看起来怪怪的……像是变弱了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130014",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "这会是什么原因，咱又该怎么办呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130015",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "呕心沥血的结果，等来的竟是这样的结局……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130016",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "如果不能实现那个心愿，我留着这一堆废物有什么用……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130017",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "大、大人？",
          "type": "dialogue"
        },
        {
          "sourceId": "3130018",
          "sourceType": 5,
          "speaker": "阿撒兹勒",
          "text": "你们，给我统统去死——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130019",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "大大大人！快跑啊～～～！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "3130020",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "结束了吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3130021",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不，一切，还远远没有开始。",
          "type": "dialogue"
        }
      ],
      "id": "detail-156",
      "sourceRefs": [
        {
          "bundle": "exceldata",
