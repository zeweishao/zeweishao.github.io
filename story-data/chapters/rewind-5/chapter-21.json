      ],
      "title": "#1 复仇之焰"
    },
    {
      "blocks": [
        {
          "sourceId": "3131001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "果然……",
          "type": "dialogue"
        },
        {
          "sourceId": "3131002",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我所研制出来的，是丑陋的残次品。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131003",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "而你，尽管已经离开了这个世界。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131004",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你所创造的一切，仍然无人可以超越。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131005",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我会让整个手办界为你绽放出别样的光彩。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我会夺回本该属于你的一切荣耀。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我会……让你的名字在所有的手办之间传颂。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我发誓。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "所以我必须得到真正的神奇涂料。",
          "type": "dialogue"
        },
        {
          "sourceId": "3131010",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "而我，一定会得到。",
          "type": "dialogue"
        }
      ],
      "id": "detail-157",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
