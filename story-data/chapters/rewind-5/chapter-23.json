        }
      ],
      "title": "#4 旧时照片"
    },
    {
      "blocks": [
        {
          "sourceId": "3146001",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪，小心！",
          "type": "dialogue"
        },
        {
          "sourceId": "3146002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "嘶，好痛——",
          "type": "dialogue"
        },
        {
          "sourceId": "3146004",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "你敢伤她？",
          "type": "dialogue"
        },
        {
          "sourceId": "3146005",
          "sourceType": 0,
          "speaker": "独轮车",
          "text": "你你你别过来……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146006",
          "sourceType": 5,
          "speaker": "独轮车",
          "text": "啊！——",
          "type": "dialogue"
        },
        {
          "sourceId": "3146007",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪，在这里休息一下。",
          "type": "dialogue"
        },
        {
          "sourceId": "3146008",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "让我看看你身上的伤……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "没事，不要紧啦……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "不过，被你一说我还真想休息一下了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3146011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "天启那帮马仔真是没完没了，怎么都甩不掉……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "总觉得脑袋里晕乎乎的，好像有另外一个声音在说话……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146013",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "和江，你不要太紧张我，我休息一下就好了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146014",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪……你……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "嗯？怎么了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3146016",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "你的身上……",
          "type": "dialogue"
        },
        {
          "sourceId": "3146017",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "我的身上……啊，怎么会——",
          "type": "dialogue"
        },
        {
          "sourceId": "3146018",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "我的身体里怎么会有另外一层涂装？！",
          "type": "dialogue"
        }
      ],
      "id": "detail-172",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3146001,
