      "title": "#2 告别之刻"
    },
    {
      "blocks": [
        {
          "sourceId": "3144001",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "大人……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144002",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "我能找到的……都在这里了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144003",
          "sourceType": 0,
          "speaker": "优纪复刻品A",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144004",
          "sourceType": 0,
          "speaker": "优纪复刻品B",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144005",
          "sourceType": 0,
          "speaker": "优纪复刻品C",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "果然并不是那么容易就能找到的么……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144007",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "您、您说什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "3144008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你不用找了，这里没有一个是我想要的。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144009",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "什、什么？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3144010",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "属下该死，属下办事不利，甘愿领罚！",
          "type": "dialogue"
        },
        {
          "sourceId": "3144011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我记得不错的话，这是你第二次办事不利了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144012",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "是……大人没有记错。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "很好，如你所愿，别再让我看到你。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144014",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "我、我知道了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144015",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "啧啧，真是可怜呢，对您忠心耿耿的仆从，就是这样的下场么……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144016",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我不需要无能的废物。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144017",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "您说得对，可M城对手办来说还是过于庞大，短期内想要找到那个特殊的手办，恐怕……",
          "type": "dialogue"
        },
        {
          "sourceId": "3144018",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不必说了，我自有打算，你也退下。",
          "type": "dialogue"
        },
        {
          "sourceId": "3144019",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "……是，大人英明。",
          "type": "dialogue"
        }
      ],
      "id": "detail-170",
