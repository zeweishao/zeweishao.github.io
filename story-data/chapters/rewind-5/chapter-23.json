      "title": "#3 王之愤怒"
    },
    {
      "blocks": [
        {
          "sourceId": "3145001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "又是这熟悉的夜色……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145002",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "又是这熟悉的孤独……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145003",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "为什么被丢下的是我……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145004",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你们……都到哪里去了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145005",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "…………",
          "type": "dialogue"
        },
        {
          "sourceId": "3145006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "已经过去这么久了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "久到我都快把自己忘了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3145008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "主人……我可怜的可敬的主人……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我一定会为你复仇……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145010",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "等我……",
          "type": "dialogue"
        },
        {
          "sourceId": "3145011",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "……",
          "type": "dialogue"
        }
      ],
      "id": "detail-171",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3145001,
