    {
      "blocks": [
        {
          "sourceId": "3142001",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142002",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "统统……杀光……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142003",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "完了完了完了，这下真的变成一个不折不扣的大魔王了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142004",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "杀……杀……杀……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "喂，莉可，你可不要以为你救了樱我就不敢揍你哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3142006",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "统统……杀光……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142007",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "哎哟，你居然真的敢打我！",
          "type": "dialogue"
        },
        {
          "sourceId": "3142008",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "杀……杀……杀……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哇呀呀呀，好痛！",
          "type": "dialogue"
        },
        {
          "sourceId": "3142010",
          "sourceType": 0,
          "speaker": "樱",
          "text": "你们还好吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "樱，你没事真的太好了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3142012",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "怎么回事，莉可这个笨蛋，没有把樱当做攻击目标吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142013",
          "sourceType": 0,
          "speaker": "樱",
          "text": "樱一直都好好的喔。",
          "type": "dialogue"
        },
        {
          "sourceId": "3142014",
          "sourceType": 0,
          "speaker": "樱",
          "text": "莉可她没有伤害过樱……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "好像……真的是这样。",
          "type": "dialogue"
        },
        {
          "sourceId": "3142016",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "忘了所有的事，也没有把樱忘记吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142017",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "莉可这个笨蛋……真是笨透了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3142018",
          "sourceType": 0,
          "speaker": "樱",
          "text": "呜呜……莉可……",
          "type": "dialogue"
        }
      ],
      "id": "detail-168",
      "sourceRefs": [
        {
