      "title": "#2 混乱！混乱"
    },
    {
      "blocks": [
        {
          "sourceId": "3138001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你们快看那边！",
          "type": "dialogue"
        },
        {
          "sourceId": "3138002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那个家伙是不是……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138003",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "莉可！你这个混蛋！",
          "type": "dialogue"
        },
        {
          "sourceId": "3138004",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "……你们来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3138005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "你果然是天启的！",
          "type": "dialogue"
        },
        {
          "sourceId": "3138006",
          "sourceType": 0,
          "speaker": "樱",
          "text": "啊……樱、樱好害怕……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138007",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138008",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "樱的事……全是你亲自设计好的，对不对！",
          "type": "dialogue"
        },
        {
          "sourceId": "3138009",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "你不但骗了优纪、和江，骗了我和小惠……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138010",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "还假惺惺地要跟我们去修复樱……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138011",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "你真的……真的太可怕了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3138012",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "姐姐，不要这么激动……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138013",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "莉可，真的是这样吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3138014",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "事到如今，我再做什么解释你们都不会信。",
          "type": "dialogue"
        },
        {
          "sourceId": "3138015",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "所以，我不会给自己辩解。",
          "type": "dialogue"
        },
        {
          "sourceId": "3138016",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "我，宫本尤娜，绝对不会原谅你！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-164",
      "sourceRefs": [
        {
