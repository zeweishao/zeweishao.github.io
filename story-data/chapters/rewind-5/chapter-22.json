      ],
      "title": "#3 命运的邂逅"
    },
    {
      "blocks": [
        {
          "sourceId": "3139001",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "狡猾的家伙！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139002",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "我会让你付出代价！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139003",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "——哦啦哦啦哦啦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139004",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "啧，居然躲过去了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139005",
          "sourceType": 0,
          "speaker": "樱",
          "text": "尤娜姐姐小心——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139006",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "樱，不要——",
          "type": "dialogue"
        },
        {
          "sourceId": "3139007",
          "sourceType": 5,
          "speaker": "樱",
          "text": "啊——————",
          "type": "dialogue"
        },
        {
          "sourceId": "3139008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "天哪，樱要掉进流水线里了！！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139009",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "樱~！",
          "type": "dialogue"
        },
        {
          "sourceId": "3139010",
          "sourceType": 3,
          "text": "只见莉可以不可见的速度冲向樱，拼尽全力把她从流水线入口处推开，她自己却——",
          "type": "narration"
        },
        {
          "sourceId": "3139011",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "啊……要掉进去了吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139012",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "掉进去……会变成樱之前那个样子吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139013",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "这样也好……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139014",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "你所遭受的痛苦……我也会亲自体会……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139015",
          "sourceType": 0,
          "speaker": "樱",
          "text": "你……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139016",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "我从没有像今天这样离你这么近过，樱……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139017",
          "sourceType": 0,
          "speaker": "樱",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3139018",
          "sourceType": 2,
          "speaker": "宫本尤娜",
          "text": "这家伙居然舍弃自己也要救樱……",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "3139019",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "可恶，我可不想欠你！",
          "type": "dialogue"
        }
      ],
      "id": "detail-165",
