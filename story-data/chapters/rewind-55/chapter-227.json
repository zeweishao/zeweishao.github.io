            43012013,
            43012014
          ],
          "sectionId": 43012
        }
      ],
      "title": "红心王后 · Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "43013001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "决定了！我们一起找到爱丽丝，夺回辛德瑞拉的水晶鞋。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013002",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "我带你们去爱丽丝常去的几个地方，或许能找到她的踪迹。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013003",
          "sourceType": 7,
          "text": "辛德瑞拉 · 焕梦新生\n商品名称：辛德瑞拉·焕梦新生 Ver.\n作品名称：《仙履奇缘》\n制造商：SNOW.A 细雪庭\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约237mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "43013004",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "太、太好了，有了辛德瑞拉的帮助，一定能找到爱丽丝的。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013005",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "怎么了，为什么一直盯着我看？这身衣服哪里不对吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "43013006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊，没有没有~我只是觉得这件衣服更适合你呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "43013007",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "当然，这是我在魔法学院学习魔法时的装扮，对我来说意义非凡。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "小心，爱丽丝可能在这里设置了陷阱。我们得留意脚下。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013009",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "我、我踩到了一个装满蜂蜜的罐子……动不了了……怎么办？",
          "type": "dialogue"
        },
        {
          "sourceId": "43013010",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "让我来。这是爱丽丝设置的恶作剧，必须用魔法才能破除。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013011",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "透明之水，净化世间一切污秽。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "太厉害了，辛德瑞拉，没想到你真的会使用魔法~！超酷的~",
          "type": "dialogue"
        },
        {
          "sourceId": "43013013",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "当然，我手中的魔棒从来都不是摆设。\n对于一名合格的魔法师来说，应对这类事情是必备的技能。",
          "type": "dialogue"
        },
        {
          "sourceId": "43013014",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "嗯嗯，有你在，终于可以安心一点了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-1124",
      "sourceRefs": [
        {
          "bundle": "fairytale",
          "rowIds": [
            43013001,
            43013002,
            43013003,
            43013004,
            43013005,
            43013006,
            43013007,
            43013008,
            43013009,
            43013010,
            43013011,
            43013012,
            43013013,
            43013014
          ],
          "sectionId": 43013
        }
      ],
      "title": "红心王后 · Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "43014001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "看那里，是爱丽丝！我们终于找到她了~",
          "type": "dialogue"
        },
        {
          "sourceId": "43014002",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "爱丽丝……把水晶鞋交出来，其他的让我们来帮助你，好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014003",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "水晶鞋？那是什么东西？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014004",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "哎呀哎呀，我想起来了，我拿走那双鞋只是想逗一逗辛德瑞拉。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014005",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "既然我的目的达到了，自然不需要那种东西咯，所以我也不知道水晶鞋在哪里。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014006",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "你把我的水晶鞋丢了？那是我最珍贵的私人物品，你怎么敢？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "真是乱来的孩子……水晶鞋你丢在了哪里，这个总该记得吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014008",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "哼哼，说不定就在这片林子里的哪个角落，谁知道呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014009",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "我会找到的，否则……你不会想知道后果是什么。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014010",
          "sourceType": 3,
          "text": "一阵紧张的搜索过后——",
          "type": "narration"
        },
        {
          "sourceId": "43014011",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "你怎么可以……怎么可以弄丢我最珍视的东西？！",
          "type": "dialogue"
        },
        {
          "sourceId": "43014012",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "嗯嗯？真的生气啦……？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014013",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "对不起嘛，我真的不是故意的，再相信我一次好不好？",
          "type": "dialogue"
        },
        {
          "sourceId": "43014014",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "这不仅仅是一只鞋，你根本不明白它的意义……如果找不回来，我绝不原谅你。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014015",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "呜……辛德瑞拉生起气来，好、好可怕……",
          "type": "dialogue"
        },
        {
          "sourceId": "43014016",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "好吧好吧，我会尽力帮忙找回鞋子，我保证。",
          "type": "dialogue"
        },
        {
          "sourceId": "43014017",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "但你要答应我，找回水晶鞋后，你也要陪我回到仙境世界~",
          "type": "dialogue"
        },
        {
          "sourceId": "43014018",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "怎么，遗失水晶鞋的始作俑者，竟还有脸跟我谈条件？",
          "type": "dialogue"
        }
      ],
      "id": "detail-1125",
      "sourceRefs": [
        {
          "bundle": "fairytale",
          "rowIds": [
            43014001,
            43014002,
            43014003,
            43014004,
            43014005,
            43014006,
            43014007,
            43014008,
            43014009,
            43014010,
            43014011,
            43014012,
            43014013,
            43014014,
            43014015,
            43014016,
            43014017,
            43014018
          ],
          "sectionId": 43014
        }
      ],
      "title": "红心王后 · Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "43015001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "大家停一下~！争吵是不能解决问题的。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015002",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "抱歉，我刚才有些失态了。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015003",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "你们不明白，水晶鞋对我的意义有多么重要，找不到我是不会罢休的。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那就扩大搜索范围，再仔细找一遍吧~",
          "type": "dialogue"
        },
        {
          "sourceId": "43015005",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "嗯嗯，我也想要帮上忙，我已经准备好了。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015006",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "好诶！新一轮的槌球游戏开始咯，火烈鸟在哪里~",
          "type": "dialogue"
        },
        {
          "sourceId": "43015007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这地方真的太大了……大家分散开来，全力搜索鞋子的线索。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015008",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "到处都是杂草，我们的视野受到很严重的遮掩，怎、怎么办？",
          "type": "dialogue"
        },
        {
          "sourceId": "43015009",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
          "text": "天色渐暗，时间快要到了……我的魔法就要失效了。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015010",
          "sourceType": 0,
          "speaker": "爱丽丝",
          "text": "呼哇，找东西什么的真无聊……\n我可没说要放弃，干嘛这样盯着我？",
          "type": "dialogue"
        },
        {
          "sourceId": "43015011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你知道就好，和我一起到那边的林子下找找看。",
          "type": "dialogue"
        },
        {
          "sourceId": "43015012",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "那……那个，你愿意和我到后面的草丛寻找水晶鞋吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "43015013",
          "sourceType": 0,
          "speaker": "辛德瑞拉",
