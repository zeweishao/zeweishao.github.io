{
  "bookId": "rewind-16",
  "id": "chapter-66",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "21301001",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "主人！！！你终于回来了！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21301002",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "出大事了！！！这绝对是！！！世界末日！！！",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "21301004",
              "text": "怎么回事？"
            }
          ],
          "sourceId": "21301003",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "21301004",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "我妹妹……里惠她……",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "21301006",
              "text": "……到底怎么了？"
            }
          ],
          "sourceId": "21301005",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "21301006",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "唔嗯~主人，欢，迎，回，来~\n您要先吃饭，先洗澡，还是……先吃我呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21301007",
          "sourceType": 7,
          "text": "宫本里惠 · 禁忌的人鱼\n商品名称：宫本里惠·禁忌的人鱼 Ver.\n作品名称：《蘑菇少女的日常》\n制造商：LET'S RED 猩潮\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约230mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "21301008",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "这这这这——超奇怪的吧？！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21301009",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "……我妹妹绝对不可能穿这么暴露的衣服！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21301010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "虽然话是这么说没错，但重点根本不是那个好吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "21301011",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "主人出去那么久，不会想念里惠吗~",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "21301013",
              "text": "当然会想啦……"
            }
          ],
          "sourceId": "21301012",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "21301013",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "我也是呢，里惠阿……最喜欢主人了~",
          "type": "dialogue"
        },
        {
          "sourceId": "21301014",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "喂喂！出大事了！天要塌了！！！——妹妹最喜欢的人竟然……不是我了！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302001",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "里惠……我的里惠……你这家伙！你跟本是个冒牌货对吧，喂，快说，你把我的妹妹藏到哪去了！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "哎尤娜，你冷静一点……这个人的确是里惠没错啦……",
          "type": "dialogue"
        },
        {
          "sourceId": "21302003",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "不可能！根本不可能！！！我妹妹……是超害羞的！绝对绝对不会跟陌生人对视或者说话的那一种！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302004",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "喔，也没什么问题嘛，我们又不是陌生人，主人就更不是了。",
          "type": "dialogue"
        },
        {
          "sourceId": "21302005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "不对不对，不是这个！我妹妹……无论做什么都一定会跟在我身后的，不管怎样都一定会双手双脚支持我的！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302006",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "嗯……万一是她长大了呢，小孩子长大之后都会更加独立一些的，不会再依赖父母兄弟什么的。",
          "type": "dialogue"
        },
        {
          "sourceId": "21302007",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "阿阿阿阿——！不是！绝对不是这样！！！……你看，你看她的眼睛！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302008",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "眼睛……唔怎么了吗……喔喔——之前没注意，仔细看下来，你妹妹的眼睛还蛮好看的耶！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302009",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "阿阿阿阿——！！！都说了不是这样了！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21302010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "尤娜……冷静……冷静一点阿……",
          "type": "dialogue"
        }
      ],
      "id": "detail-397",
      "sourceRefs": [
        {
