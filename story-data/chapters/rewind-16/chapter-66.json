      ],
      "title": "《禁忌的人鱼》·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "21311001",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "接下来是针对里惠的「性格问答大测验」，大家一起准备问题，由最熟悉妹妹的尤娜对回答进行比对，有问题吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311002",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "快点开始吧，你们马上就会知道，这个家伙绝对不可能是我的妹妹！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那么里惠，来向大家做一个自我介绍吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311004",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "不可以哦，里惠只想听从主人一个人的命令呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "21311005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "阿——！里惠……你连姐姐的话都不愿意听了吗！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "绿子，麻烦把场外无关因素拉走。",
          "type": "dialogue"
        },
        {
          "sourceId": "21311007",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "是~！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311008",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "放开窝……唔唔唔……唔唔——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "平时的话，里惠有什么兴趣爱好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311010",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "洗香香，干净漂亮地欢迎主人回家~",
          "type": "dialogue"
        },
        {
          "sourceId": "21311011",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "——明明是蹲在地上看蚂蚁搬家和观察模仿姐姐的唔唔唔……唔唔……唔唔唔——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "阿呵呵……咳……那么里惠，最喜欢的东西是什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311013",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "里惠最喜欢主人了~",
          "type": "dialogue"
        },
        {
          "sourceId": "21311014",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "——胡说！明明是窝唔唔……唔唔唔——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这样阿，讨厌的东西呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311016",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "没有主人的地方~",
          "type": "dialogue"
        },
        {
          "sourceId": "21311017",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "喜欢的食物呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311018",
          "sourceType": 0,
          "speaker": "奇怪的里惠",
          "text": "虽然没办法享用美食，但最喜欢主人喜欢的食物~",
          "type": "dialogue"
        },
        {
          "sourceId": "21311019",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "——明明是窝唔唔……唔唔……唔唔唔——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311020",
          "sourceType": 5,
          "speaker": "绿子",
          "text": "哎哎……要拉不住了……她力气大的像一头疯牛……！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311021",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "放开我——欧拉欧拉欧拉欧拉——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311022",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "不可以！她不是里惠！里惠最喜欢的是姐姐讨厌没有姐姐的地方喜欢姐姐喜欢的食物讨厌姐姐讨厌的食物兴趣爱好是模仿姐姐的一举一动！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311023",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "喔……要这么看的话，里惠的性格的确发生了巨大的变化没错！",
          "type": "dialogue"
        },
        {
          "sourceId": "21311024",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "嗯。",
          "type": "dialogue"
        },
        {
          "sourceId": "21311025",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "怎么会突然完全变了一个人呢……最近有接触什么人或者奇怪的地方吗……？",
          "type": "dialogue"
        },
        {
          "sourceId": "21311026",
          "sourceType": 3,
          "text": "叮咚——",
          "type": "narration"
        },
        {
          "sourceId": "21311027",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "欸，门铃响了？",
          "type": "dialogue"
        }
      ],
