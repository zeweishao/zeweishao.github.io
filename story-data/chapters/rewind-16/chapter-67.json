      "title": "《王子与乞丐》·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "21339001",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "甩掉了，good。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339002",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "欧拉欧拉欧拉——放开，我还能打！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21339003",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Stupid，莽夫。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339004",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "喂我说，你这家伙到底是谁阿？",
          "type": "dialogue"
        },
        {
          "sourceId": "21339005",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "伊达政宗。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339006",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "谁关心你的名字阿喂，一直鬼鬼祟祟跟在我们后面干嘛，也是来找那个柴犬小子的吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21339007",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Right，真田君是我的friend。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339008",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "那还真是让人火大的朋友。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339009",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "朋友……等等，难道，柴犬小子也是一夜之间完全变了个人吗！",
          "type": "dialogue"
        },
        {
          "sourceId": "21339010",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Bingo，被你言中了。",
          "type": "dialogue"
        },
        {
          "sourceId": "21339011",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "喔喔——看来那位真田君也是「女人味」的受害者，那么大家就是同一战线的队友了！",
          "type": "dialogue"
        },
        {
          "sourceId": "21339012",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "又多了一个需要拯救的手办吗，明白了，喜欢说英文的家伙，跟我们回家~！",
          "type": "dialogue"
        },
        {
          "sourceId": "21341001",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "如此如此，这般这般，总之就是这样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "21341002",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "嗅嗅——唔，沾上「女人味」之后就能变得像柴犬小子那样强吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21341003",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Naive，真田君本来就很强。",
          "type": "dialogue"
        },
        {
          "sourceId": "21341004",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "喂——警告你！不要闻来闻去，离我的妹妹远一点！",
          "type": "dialogue"
        },
        {
          "sourceId": "21341005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "总觉得一步一步走进了什么人的阴谋的样子……",
          "type": "dialogue"
        },
        {
          "sourceId": "21341006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "这件事并不简单。",
          "type": "dialogue"
        },
        {
          "sourceId": "21341007",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Interesting，显然幕后黑手是同一人。",
          "type": "dialogue"
        },
        {
          "sourceId": "21341008",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "可是对方的目的究竟是什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21341009",
          "sourceType": 5,
          "speaker": "宫本尤娜",
          "text": "阿——完全不知道从哪里下手，可恶！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21341010",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "不要着急，对方一定会有所行动。",
          "type": "dialogue"
        },
        {
          "sourceId": "21341011",
          "sourceType": 3,
          "text": "叮咚——",
          "type": "narration"
        },
        {
          "sourceId": "21341012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "是……门铃声？",
          "type": "dialogue"
        },
        {
          "sourceId": "21341013",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "恐怕，下一份线索要来了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-404",
