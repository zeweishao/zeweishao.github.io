            40617025,
            40617026,
            40617027,
            40617028
          ],
          "sectionId": 40617
        }
      ],
      "title": "告别时分·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "40618001",
          "sourceType": 3,
          "text": "失序者单手抓着魔女的脖子，将她提了起来。",
          "type": "narration"
        },
        {
          "sourceId": "40618002",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "你以为拿着一把奥术武器，穿一身花哨的裙甲，就能算得上骑士了？嗯？",
          "type": "dialogue"
        },
        {
          "sourceId": "40618003",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "唔……可……可恶……",
          "type": "dialogue"
        },
        {
          "sourceId": "40618004",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "真是好笑，守夜人。看到你自娱自乐的模样，我都忍不住变得幽默了。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618005",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "咳……咕……弗吉尼娅……",
          "type": "dialogue"
        },
        {
          "sourceId": "40618006",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "只要我一用力，就能扭断这纤细的脖子。你想必会变成非常漂亮的白模吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618007",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "你曾经当着所有人的面，当着我的面……发过誓……",
          "type": "dialogue"
        },
        {
          "sourceId": "40618008",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "我不记得了。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618009",
          "sourceType": 3,
          "text": "她甩开手，诺伊尔重重地摔在地上，长剑脱手而出。",
          "type": "narration"
        },
        {
          "sourceId": "40618010",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "咳……唔，你曾向一个初来乍到的守夜人宣读了守护之誓，你发誓将守护所有的荣耀与美德，所有的光明与希望。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618011",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "你给予了那位陌生的魔女充分的信任，也给予了她名为「骑士」的美好幻想。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618012",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "这也是她现在来到你面前的理由。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618013",
          "sourceType": 9,
          "text": "……快啊……让箭洞穿她的身躯……她的伤口上将开出最美艳的杀戮之花……",
          "type": "narration"
        },
        {
          "sourceId": "40618014",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "该结束了，诺伊尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618015",
          "sourceType": 3,
          "text": "她张弓搭箭，瞄准倒地的魔女，箭矢疾射而去。",
          "type": "narration"
        },
        {
          "sourceId": "40618016",
          "sourceType": 5,
          "speaker": "诺伊尔",
          "text": "……！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "40618017",
          "sourceType": 3,
          "text": "魔女愕然地看着眼前的景象。",
          "type": "narration"
        },
        {
          "sourceId": "40618018",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "……这算是赶上了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "40618019",
          "sourceType": 3,
          "text": "箭矢贯穿了你鸟类的躯体，将你钉在了地上。",
          "type": "narration"
        },
        {
          "sourceId": "40618020",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "啊……",
          "type": "dialogue"
        },
        {
          "sourceId": "40618021",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "40618022",
          "sourceType": 3,
          "text": "冰冷的感觉渗透了身心，你说不出话。",
          "type": "narration"
        },
        {
          "sourceId": "40618023",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "没想到你的乌鸦守护了你，但也只能拖延一下。它白死了。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618024",
          "sourceType": 3,
          "text": "来不及愤怒，也来不及悲伤，魔女只是平静地看着眼前的一切。",
          "type": "narration"
        },
        {
          "sourceId": "40618025",
          "sourceType": 3,
          "text": "她呼唤铭刻在肉体记忆里的，她曾最熟悉的感受——",
          "type": "narration"
        },
        {
          "sourceId": "40618026",
          "sourceType": 3,
          "text": "奥术能量在身体里久违地疾驰。",
          "type": "narration"
        },
        {
          "sourceId": "40618027",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "（古精灵语）……请最后一次听我号令，为我奔走。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618028",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "你的眼睛……你在施法？",
          "type": "dialogue"
        },
        {
          "sourceId": "40618029",
          "sourceType": 3,
          "text": "纷扰的呓语充塞着魔女的脑海，激起足以让人狂乱的黑色浪潮。",
          "type": "narration"
        },
        {
          "sourceId": "40618030",
          "sourceType": 3,
          "text": "下一瞬间，却变成了纯粹的「无」。",
          "type": "narration"
        },
        {
          "sourceId": "40618031",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "啊……为什么没能早点察觉呢?",
          "type": "dialogue"
        },
        {
          "sourceId": "40618032",
          "sourceType": 3,
          "text": "面对濒死的使魔，魔女终于解开了一直以来束缚自己的枷锁。",
          "type": "narration"
        },
        {
          "sourceId": "40618033",
          "sourceType": 9,
          "text": "……这是……不可能……阻止她……阻止她！",
          "type": "narration"
        },
        {
          "sourceId": "40618034",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "憎恶——之矢！",
          "type": "dialogue"
        },
        {
          "sourceId": "40618035",
          "sourceType": 3,
          "text": "黑焰缠绕的利箭化作摧枯拉朽的一击，朝着魔女飞来——",
          "type": "narration"
        },
        {
          "sourceId": "40618036",
          "sourceType": 3,
          "text": "却在距离她数十公分的位置被半空展开的护盾阻挡，消弭于无形。",
          "type": "narration"
        },
        {
          "sourceId": "40618037",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "我们做个了断，弗吉尼娅。",
          "type": "dialogue"
        },
        {
          "sourceId": "40618038",
          "sourceType": 3,
          "text": "魔女轻轻地拾起剑，再度发起挑战。",
          "type": "narration"
        },
        {
          "sourceId": "40802001",
          "sourceType": 3,
          "text": "不知过了多久，随着失序者的长弓坠地，战斗已然分晓。",
          "type": "narration"
        },
        {
          "sourceId": "40802002",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "这场决斗是你赢了。动手吧，诺伊尔。",
          "type": "dialogue"
        },
        {
          "sourceId": "40802003",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "只要我死了，仪式就会终止，所有的仇恨和悲伤也会画上句号。",
          "type": "dialogue"
        },
        {
          "sourceId": "40802004",
          "sourceType": 9,
          "text": "……弗吉尼娅……你在做什么……你……",
          "type": "narration"
        },
        {
          "sourceId": "40802005",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "我会的。",
          "type": "dialogue"
        },
        {
          "sourceId": "40802006",
          "sourceType": 3,
          "text": "魔女双手持剑，将剑高高地举过头顶——",
          "type": "narration"
        },
        {
          "options": [
            {
              "targetId": "40802008",
              "text": "停一下。"
            }
          ],
          "sourceId": "40802007",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "40802008",
          "sourceType": 3,
          "text": "或许是魔女的治疗术起了作用，你终于有了些说话的力气。",
          "type": "narration"
        },
        {
          "sourceId": "40802009",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "那封邀请函是弗吉尼娅写的，她故意将你引来N城……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802010",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "她杀死其他的个体，将「不朽灾祸」聚集在一起……为的就是让你消灭她……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802011",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "……什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "40802012",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "这样一来……她身上所有的「不朽灾祸」也都会死去……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802013",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802014",
          "sourceType": 3,
          "text": "你回想起之前和诺伊尔一起推导的凶手的动机。",
          "type": "narration"
        },
        {
          "sourceId": "40802015",
          "sourceType": 3,
          "text": "是仇恨。",
          "type": "narration"
        },
        {
          "sourceId": "40802016",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "所有的事件……都是她的赎罪计划……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802017",
          "sourceType": 0,
          "speaker": "乌鸦",
          "text": "因为弗吉尼娅比任何人都恨弗吉尼娅……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802018",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "真是给我编了个好理由。听了这只乌鸦的话，你就要放过我吗，诺伊尔？",
          "type": "dialogue"
        },
        {
          "sourceId": "40802019",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "哪怕「不朽灾祸」即将完全复活……",
          "type": "dialogue"
        },
        {
          "sourceId": "40802020",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "哪怕你的这位伙伴即使再怎样治疗，也必死无疑？",
          "type": "dialogue"
        },
        {
          "sourceId": "40802021",
          "sourceType": 0,
          "speaker": "诺伊尔",
          "text": "……！",
          "type": "dialogue"
        },
        {
          "sourceId": "40802022",
          "sourceType": 5,
          "speaker": "弗吉尼娅",
          "text": "你还在等什么！！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-1009",
      "sourceRefs": [
        {
