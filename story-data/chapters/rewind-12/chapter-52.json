            17118014,
            17118015,
            17118016
          ],
          "sectionId": 17118
        }
      ],
      "title": "~皆大欢喜~ · Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "17119001",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "说吧，这一次，你又想打什么鬼主意？",
          "type": "dialogue"
        },
        {
          "sourceId": "17119002",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "迄今为止，相信你们已经了解到绯野魔术是何等瑰丽。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119003",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "是是是，早就见识到绯野大小姐的华丽演出了。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119004",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "呵呵，那些还不是全部哦，你们看到的不过是冰山一角。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119005",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "真正的魔术，并不是用眼睛看见的，而要用心才能感知。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119006",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "又在说我听不懂的话了，麻烦你简单直白点好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "17119007",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "简单点来说，我要和你玩一场心理游戏。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119008",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我从会认字开始接受心理训练，我的父亲为我请来顶级的心理学哲学教授为我量身定制了多项专业课程。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119009",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "后来我在练习魔术的时候，偶然间想到把心理学的知识融合进自己钟爱的剧作家戏剧中，创立了这套心理魔术——“剧作家的试炼”。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119010",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我可以很自信地告诉你，截止目前，还没有谁可以在这场游戏中赢得过我。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119011",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "好家伙，我看出来了，她这是把自己的看家本领都拿出来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119012",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "哲学心理学剧作家戏剧……她刚刚讲的这些，完全都在我的知识盲区之内嘛。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119013",
          "sourceType": 0,
          "speaker": "樱·樱花梦语",
          "text": "总觉得绯野姐姐是在故意针对音姐姐，樱好担心呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "17119014",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "看来这次想要赢你，只能靠运气了啊，问题是我这次还能有这种运气么……",
          "type": "dialogue"
        },
        {
          "sourceId": "17119015",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "17119016",
          "sourceType": 0,
          "speaker": "凛",
          "text": "是谁在那里？",
          "type": "dialogue"
        },
        {
          "sourceId": "17119017",
          "sourceType": 0,
          "speaker": "凛",
          "text": "出来。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119018",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "是我，请放心，我没有恶意。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119019",
          "sourceType": 0,
          "speaker": "凛",
          "text": "找我何事？",
          "type": "dialogue"
        },
        {
          "sourceId": "17119020",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "我想请凛前辈帮我一个忙。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119021",
          "sourceType": 0,
          "speaker": "凛",
          "text": "我看起来像是很闲的样子么？我拒绝。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119022",
          "sourceType": 0,
          "speaker": "凛",
          "text": "麻烦让开，我正在执行秘密任务。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119023",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "17119024",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "我知道你的秘密任务是什么。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119025",
          "sourceType": 0,
          "speaker": "冈田桜介·机车手",
          "text": "我可以给你提供全部的线索，必要的话甚至能亲自协助你调查，只需要凛前辈帮我一个小忙。",
          "type": "dialogue"
        },
        {
          "sourceId": "17119026",
          "sourceType": 0,
          "speaker": "凛",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "17119027",
          "sourceType": 0,
          "speaker": "凛",
          "text": "你想让我做什么，说来听听。",
          "type": "dialogue"
        }
      ],
      "id": "detail-329",
      "sourceRefs": [
        {
          "bundle": "chunjie",
          "rowIds": [
