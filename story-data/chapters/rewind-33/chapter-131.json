            31684009,
            31684010,
            31684011,
            31684012
          ],
          "sectionId": 31684
        },
        {
          "bundle": "mushroom",
          "rowIds": [
            31685001,
            31685002,
            31685003,
            31685004,
            31685005
          ],
          "sectionId": 31685
        }
      ],
      "title": "真实幻境·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "31686001",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "蒂娅......伊迪丝......我、我，那个......\n呜，呜呜呜......我好乱，我想回家......",
          "type": "dialogue"
        },
        {
          "sourceId": "31686002",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "大家......不要一起拥上来，可以稍微，离我远一点点吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "31686003",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "我们已经是朋友了，朋友之间相处，是不会哭着躲避的。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686004",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "就像一簇蘑菇，安心地簇拥在一起——\n我们也可以做到那样。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686005",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "黑猫小姐......就是，蒂娅小姐......\n也就是......我的，朋友？",
          "type": "dialogue"
        },
        {
          "sourceId": "31686006",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "所以，你们不是我的幻想，我也并没有做梦......\n真正的伊迪丝小姐和蒂娅小姐本人，一直就在我面前？",
          "type": "dialogue"
        },
        {
          "sourceId": "31686007",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "嗯。你的朋友徕卡说，你希望和我们成为朋友。\n但是要和你正常交流，需要一些引导。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686008",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "那么，我做到了......我，我可以和别人正常交朋友了。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686009",
          "sourceType": 0,
          "speaker": "布鲁特",
          "text": "何止正常交往，你甚至做到了一口气认识三个朋友！\n好极了，开个派对庆祝一下我们终于解决了一个大难题！",
          "type": "dialogue"
        },
        {
          "sourceId": "31686010",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "啊......等等，在那之前，我还有一件必须要做的事。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686011",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "你们听说过......一个名叫「玲」的快递员吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "31686012",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "我记得，海柔尔和玲都是来自《少女X机关枪》这部作品。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686013",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "嗯......没错。在我第一次踏上小岛的那天，玲救了我的命，但我因为太害怕，醒来就逃走了......",
          "type": "dialogue"
        },
        {
          "sourceId": "31686014",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "「醒来」？",
          "type": "dialogue"
        },
        {
          "sourceId": "31686015",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "当时，被，被吓晕过去了......嘿嘿。",
          "type": "dialogue"
        },
        {
          "sourceId": "31686016",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "向救命恩人道谢，这一直是我的心愿。\n现在的我，终于有能力完成这件事了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-700",
      "sourceRefs": [
        {
