            31683016,
            31683017,
            31683018,
            31683019,
            31683020
          ],
          "sectionId": 31683
        }
      ],
      "title": "真实幻境·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "31684001",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "真是一位过分热情的观众，没办法，明日之星徕卡就给你一次见面的机会！",
          "type": "dialogue"
        },
        {
          "sourceId": "31684002",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "徕......徕卡？\n哇啊啊啊啊——！！！你、你是从哪里......",
          "type": "dialogue"
        },
        {
          "sourceId": "31684003",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "冒、冒冒......冒冒冒，咳咳，冒出来的？\n——是想这样说吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "31684004",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "我一直在你附近观察着这场精妙的戏剧，每一句台词、每一次表情动作，我都没有错过！",
          "type": "dialogue"
        },
        {
          "sourceId": "31684005",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "嘻嘻嘻，「真正的手偶师和他的手偶是一体的」，你明白这句话真正的含义吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "31684006",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "哎哎哎？那天遇到的怪人的声音从徕卡先生口中发出来了！\n......这究竟是怎么回事？",
          "type": "dialogue"
        },
        {
          "sourceId": "31684007",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "生产水平限制了你的想象力，小可怜！或许在你所处的世界，科技还没有发展到这种阶段。",
          "type": "dialogue"
        },
        {
          "sourceId": "31684008",
          "sourceType": 0,
          "speaker": "布鲁特",
          "text": "布鲁特是经过改造的超级武器，远程控制自然不在话下！作为世界巨星，除了演技，自然还要有吸引粉丝的酷炫特质才行。",
          "type": "dialogue"
        },
        {
          "sourceId": "31684009",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "布鲁特的聪明程度可以跟遥控玩具车一拼哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "31684010",
          "sourceType": 0,
          "speaker": "布鲁特",
          "text": "小心我撕烂你的嘴！",
          "type": "dialogue"
        },
        {
          "sourceId": "31684011",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "所以说......布鲁特是被徕卡先生一直在远处操纵着吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "31684012",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "没错，现在请全体演员登场，向观众谢幕！",
          "type": "dialogue"
        },
        {
          "sourceId": "31685001",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "徕卡先生拜托我们给你一个解释清楚误会的机会，但由于你的性格原因，这个机会的形式需要特殊一些。",
          "type": "dialogue"
        },
        {
          "sourceId": "31685002",
          "sourceType": 0,
          "speaker": "星野结月",
          "text": "稍等一下，我现在要完成笔记！这份实验观察记录太宝贵了，我一定要作为心理学的珍贵研究素材，好好利用起来。",
          "type": "dialogue"
        },
        {
          "sourceId": "31685003",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "虽然不清楚原因，但按照你们的方案，我的确学到了亲近小动物的心得。谢谢。",
          "type": "dialogue"
        },
        {
          "sourceId": "31685004",
          "sourceType": 0,
          "speaker": "海柔尔",
          "text": "......哎？大家......究竟是......",
          "type": "dialogue"
        },
        {
          "sourceId": "31685005",
          "sourceType": 0,
          "speaker": "布鲁特",
          "text": "是布鲁特最喜欢的买一赠一！幻想世界与真实世界，两份交友任务重叠完成，观众们一定会惊喜欢呼的！",
          "type": "dialogue"
        }
      ],
      "id": "detail-699",
      "sourceRefs": [
        {
          "bundle": "mushroom",
          "rowIds": [
            31684001,
            31684002,
            31684003,
            31684004,
