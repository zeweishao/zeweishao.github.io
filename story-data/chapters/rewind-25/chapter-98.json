      ],
      "title": "演员招募·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "24001001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "所以说，字条上的涂鸦是阿尔弗雷德？他为什么要让樱「乖乖被绑架」？",
          "type": "dialogue"
        },
        {
          "sourceId": "24001002",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "打不通......阿尔弗雷德不接电话。\n不过根据10分钟前上传自拍的定位，他应该在飞艇工厂仓库。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001003",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "走，里惠，我们现在就去找他问清楚！",
          "type": "dialogue"
        },
        {
          "sourceId": "24001004",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "姐姐，莉可......怎么办？",
          "type": "dialogue"
        },
        {
          "sourceId": "24001005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "等我们找到樱的下落，再回来给她松绑。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001006",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "开什么玩笑，我也要去！\n如果是他干的，本王要亲手把他揍扁！",
          "type": "dialogue"
        },
        {
          "sourceId": "24001007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "尤娜、里惠！......跑掉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001008",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "管理局没有理由绑架樱。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "可尤娜那么着急，恐怕会直接动手......\n主人，我有点担心，想跟上去看看。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001010",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "也好。\n如果有什么意外，及时联系我。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001011",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "嗯，放心吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "24001012",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "太期待了，待会打起来，哈莉要帮谁呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "24002001",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "樱——你在哪——",
          "type": "dialogue"
        },
        {
          "sourceId": "24002002",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "姐姐......那扇门后面，有动静。",
          "type": "dialogue"
        },
        {
          "sourceId": "24002003",
          "sourceType": 0,
          "speaker": "樱·晴雨信箱",
          "text": "呜呜呜，魔王大人，求求你饶了大家！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002004",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "魔、魔王大人？竟敢让樱说出这种话！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002005",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "还等什么，里惠，和我一起把门撞开！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002006",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "好的，姐姐！我……我会努力的！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002007",
          "sourceType": 0,
          "speaker": "酒井唯",
          "text": "小心，有敌人。",
          "type": "dialogue"
        },
        {
          "sourceId": "24002008",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "那是什么......飞、飞碟？！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002009",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "姐姐，快趴下！",
          "type": "dialogue"
        },
        {
          "sourceId": "24002010",
          "sourceType": 3,
          "text": "嘭——咣当！",
          "type": "narration"
        },
        {
          "sourceId": "24002011",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "被压住了，动不了......",
          "type": "dialogue"
        },
        {
          "sourceId": "24002012",
          "sourceType": 0,
          "speaker": "宫本尤娜",
          "text": "好大的......铁饼，里惠，你怎么变成两个了......",
          "type": "dialogue"
        },
        {
          "sourceId": "24002013",
          "sourceType": 0,
          "speaker": "宫本里恵",
          "text": "姐姐，醒醒啊——！",
          "type": "dialogue"
        }
      ],
      "id": "detail-543",
