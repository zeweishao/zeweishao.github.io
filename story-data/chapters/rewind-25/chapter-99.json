            24010011,
            24010012,
            24010013,
            24010014,
            24010015,
            24010016,
            24010017
          ],
          "sectionId": 24010
        }
      ],
      "title": "魔鬼教练·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "24011001",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "拿到了，尤娜从栅栏递进来的扣子，快去开门！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011002",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "打开了！这个锁头怎么这么重？",
          "type": "dialogue"
        },
        {
          "sourceId": "24011003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "一起抬！一，二......不行，和江，快来帮忙。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011004",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "完全......抬不动。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011005",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "可恶，她的脑子也是杠铃做的吗！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "难怪这么顺利。\n她知道，我们打开锁也出不去。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "魔鬼冲过来了！她的眼睛闪着红光，啊好可怕！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011008",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "你们退后，我来试试。\n一斩，瞬杀！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "锁头裂成两半了！和江好厉害。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011010",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "就是现在，推、开、门！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011011",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "久违了，自由的世界，蓝天，草地，还有树上的......哈莉？",
          "type": "dialogue"
        },
        {
          "sourceId": "24011012",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "藤蔓秋千，出击！森林是我们的——！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011013",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "你不要过来啊！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "24011014",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "撞得真狠......眼冒金星......",
          "type": "dialogue"
        },
        {
          "sourceId": "24011015",
          "sourceType": 0,
          "speaker": "酒井唯",
          "text": "我也该反思一下了——看来是我之前的做法太温柔，才让你们这么不长记性。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011016",
          "sourceType": 0,
          "speaker": "酒井唯",
          "text": "这次闹剧耽误的训练时间，今天晚上要加倍补回来。\n好了，别在地上躺着了，动、起、来。",
          "type": "dialogue"
        },
        {
          "sourceId": "24011017",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "呜呜，主人......我想回家......",
          "type": "dialogue"
        },
        {
          "sourceId": "24012001",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "本王先来做个总结：今天已经接近成功了，下一次，我们一定能逃出魔鬼的领地！",
          "type": "dialogue"
        },
        {
          "sourceId": "24012002",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "咳咳，发言完毕，鼓掌。\n大家......怎么都不说话，随便谁来讲点什么......",
          "type": "dialogue"
        },
        {
          "sourceId": "24012003",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "我退出。",
          "type": "dialogue"
        },
        {
          "sourceId": "24012004",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "说得好！......什么？！和江，你，你要当叛徒？",
          "type": "dialogue"
        },
        {
          "sourceId": "24012005",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "那种力度的劈斩，我至今没做到过。\n这说明，她的训练确实有效。",
          "type": "dialogue"
        },
        {
          "sourceId": "24012006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "......如果变强，就能更好地保护主人。",
          "type": "dialogue"
        },
        {
          "sourceId": "24012007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这么说来，我今天逃跑的速度也比之前快了不少......\n也是训练的效果吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "24012008",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "你们两个笨蛋，被魔鬼洗脑了吗！\n算了......有咲，至少我们两个可以战斗到底。",
          "type": "dialogue"
        },
        {
          "sourceId": "24012009",
          "sourceType": 0,
          "speaker": "神宫有咲·牧狼农场",
          "text": "哎——？还要继续吗？\n排练时间也没剩多久，反正逃不掉，不如乖乖完成任务算了。",
          "type": "dialogue"
        },
        {
          "sourceId": "24012010",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "可、可恶！我会亲自把魔鬼解决掉的，走着瞧吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "24012011",
          "sourceType": 0,
          "speaker": "樱·晴雨信箱",
          "text": "大家，怎么吵架了？不要这样。\n莉可，等等我呀——",
          "type": "dialogue"
        }
      ],
