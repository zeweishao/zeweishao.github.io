          "sectionId": 22605
        }
      ],
      "title": "黑夜降临·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "22606001",
          "sourceType": 0,
          "speaker": "玲",
          "text": "小菜一碟，报……报告！\n物资统统封装完毕~",
          "type": "dialogue"
        },
        {
          "sourceId": "22606002",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "天色不早了，准备收队。",
          "type": "dialogue"
        },
        {
          "sourceId": "22606003",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "是！长官！\n哈莉又要在军备采办比赛拿到第一名了，对吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "22606004",
          "sourceType": 0,
          "speaker": "小红",
          "text": "没错，哈莉赢了！哈莉是第一名！",
          "type": "dialogue"
        },
        {
          "sourceId": "22606005",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "嘿嘿~赢了！第一名……？\n——喂，那边的兔子，站住，不许动！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22606006",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "……嗷？",
          "type": "dialogue"
        },
        {
          "sourceId": "22606007",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "红兔子，手套白，哈莉是个大蠢材~",
          "type": "dialogue"
        },
        {
          "sourceId": "22606008",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "手下败将大蠢材，胆小鬼哈莉不敢来~",
          "type": "dialogue"
        },
        {
          "sourceId": "22606009",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "哈，哈……想宰人……",
          "type": "dialogue"
        },
        {
          "sourceId": "22606010",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "喂，哈莉？",
          "type": "dialogue"
        },
        {
          "sourceId": "22606011",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "今天我要拆兔子！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22606012",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "阿阿阿啊——救命阿——杀人啦——",
          "type": "dialogue"
        },
        {
          "sourceId": "22606013",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "跑吧，嘿嘿嘿嘿，有请我们的好朋友——追踪者爆炸三十号！",
          "type": "dialogue"
        },
        {
          "sourceId": "22606014",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "是长眼睛的手雷，阿阿阿阿！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22607001",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "哼哼，这下知道我的厉害了吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "22607002",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "呜呜呜，对不起，我错了，我打不过，呜呜呜……",
          "type": "dialogue"
        },
        {
          "sourceId": "22607003",
          "sourceType": 0,
          "speaker": "小红",
          "text": "哼，菜鸟！我们大人不记小人过，就放你一马！",
          "type": "dialogue"
        },
        {
          "sourceId": "22607004",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "好了哈莉，别耽误时间，该回去了。",
          "type": "dialogue"
        },
        {
          "sourceId": "22607005",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "哼，臭兔子，算你走运~",
          "type": "dialogue"
        },
        {
          "sourceId": "22607006",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "谢谢，谢谢放过我，我再也不敢了……才怪~\n嘿嘿嘿，我怕了我装的，来抓我呀抓我呀~？",
          "type": "dialogue"
        },
        {
          "sourceId": "22607007",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "阿，真是越来越有意思了，哈哈哈嘿吼吼吼……",
          "type": "dialogue"
        },
        {
          "sourceId": "22607008",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "哈莉是……发疯了吗……看起来好可怕……",
          "type": "dialogue"
        },
        {
          "sourceId": "22607009",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "阿抓不到我很生气吧，略略略略略略~",
          "type": "dialogue"
        },
        {
          "sourceId": "22607010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "是啊小兔子，我会把你的胳膊耳朵和腿，一条一条慢慢卸下来，然后好好装回去的……嘿嘿嘿嘿……",
          "type": "dialogue"
        },
        {
          "sourceId": "22607011",
          "sourceType": 0,
          "speaker": "小红",
          "text": "前面就是死胡同，你逃不掉了，小可怜~",
          "type": "dialogue"
        },
        {
          "sourceId": "22607012",
          "sourceType": 0,
          "speaker": "红兔子",
          "text": "我……我根本没在怕……来……来抓我呀……！",
          "type": "dialogue"
        },
        {
          "sourceId": "22607013",
          "sourceType": 2,
          "speaker": "红兔子",
          "text": "（救命，会抓到的话会死掉吧，呜呜呜，我好害怕，为什么要我招惹这种疯子，大人，救命阿……）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "22607014",
          "sourceType": 2,
          "speaker": "红兔子",
          "text": "（出门前我还没有准备遗言，我还没有去过水上乐园，我还没有让大人多看我一眼……呜呜我不要……）",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "22607015",
          "sourceType": 3,
          "text": "嗖嗖——",
          "type": "narration"
        },
        {
          "sourceId": "22607016",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "什么人？！\n……哈，我的兔子不见了！！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-483",
