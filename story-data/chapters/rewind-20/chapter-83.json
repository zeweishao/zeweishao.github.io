      "title": "黑夜降临·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "22611001",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "咚咚，有人在家吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611002",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "优纪，和江，花迦——？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611003",
          "sourceType": 0,
          "speaker": "桑尼",
          "text": "好黑，什么都看不清了，谁能帮忙把灯打开吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611004",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "我记得，开关应该在……这附近？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611005",
          "sourceType": 9,
          "text": "咔哒——",
          "type": "narration"
        },
        {
          "sourceId": "22611006",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "打斗过的痕迹……终究还是晚了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611007",
          "sourceType": 0,
          "speaker": "格雷豪斯",
          "text": "你怎么认定她们出事了？万一是嫌我们太慢，也出去采办了呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611008",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "「嫌我们太慢」？你这话是什么意思？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611009",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "她们肯定出事了！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "是那幅画——",
          "type": "dialogue"
        },
        {
          "sourceId": "22611011",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "预言「厄运」的画，他们三个一定被人绑走了！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611012",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "刚才的红兔子我知道，一定是「天启」派来的家伙！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611013",
          "sourceType": 0,
          "speaker": "桑尼",
          "text": "米娅莫拉苏娜丹妮……她说的是真的，这是一幅有灵性的画。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611014",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "可恶的「天启」，偏偏要挑这种时候，破坏吾精心为人类筹备的「相识一周年」庆宴！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611015",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "采办哪里需要那么多人口，要是吾留在这里，肯定不会让那些鼠辈得逞……",
          "type": "dialogue"
        },
        {
          "sourceId": "22611016",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "没时间抱怨了，还是想想怎么补救吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611017",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "可是我们没有任何线索，也不知道对方的下落。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611018",
          "sourceType": 0,
          "speaker": "格雷豪斯",
          "text": "哼，血债血偿，宣布开战——\n走，带上家伙，现在就跟我杀到「天启」老家！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611019",
          "sourceType": 0,
          "speaker": "杰斯",
          "text": "又要大开杀戒了吗，真是让人兴奋阿，嘿嘿嘿嘿！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611020",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "没脑袋的蠢货，等你一个一个把杂鱼的据点都端掉，明天天亮就可以去给优纪他们收拾骨灰了。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611021",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "依我看，关键还是要从那三个引走我们的手办下手。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611022",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "我不赞成，他们被人带走显然是有组织的预谋，M城里寻找三个小小的手办无异于大海捞针。",
          "type": "dialogue"
        },
        {
          "sourceId": "22611023",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "等我联系管理局，申请总部支援……",
          "type": "dialogue"
        },
        {
          "sourceId": "22611024",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "「管理局」？我才不要指望那种官僚气重、办事拖沓的东西！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611025",
          "sourceType": 0,
          "speaker": "格雷豪斯",
          "text": "你说什么，再说一遍——？",
          "type": "dialogue"
        },
        {
          "sourceId": "22611026",
          "sourceType": 0,
          "speaker": "杰斯",
          "text": "呵呵哈哈哈，打起来，打起来，打起来阿！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611027",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "冷静，各位，冷静一下！",
          "type": "dialogue"
        },
        {
          "sourceId": "22611028",
          "sourceType": 3,
          "text": "砰——稀里哗啦！！！",
          "type": "narration"
        },
        {
          "sourceId": "22611029",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "有敌袭，全员戒备！",
          "type": "dialogue"
        }
      ],
