          "sectionId": 22619
        }
      ],
      "title": "废墟王座·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "22620001",
          "sourceType": 0,
          "speaker": "代号v",
          "text": "什么人？",
          "type": "dialogue"
        },
        {
          "sourceId": "22620002",
          "sourceType": 0,
          "speaker": "代号v",
          "text": "保护阿撒兹勒大人——！",
          "type": "dialogue"
        },
        {
          "sourceId": "22620003",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "挡路了。",
          "type": "dialogue"
        },
        {
          "noticeKind": "video",
          "sourceId": "22620004",
          "sourceType": 11,
          "text": "此处为游戏视频演出，尚未转写为文字。",
          "type": "notice"
        },
        {
          "sourceId": "22620005",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "「离乡的囚鸟」，「替罪的羔羊」——",
          "type": "dialogue"
        },
        {
          "sourceId": "22620006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "流离失所的异乡之人找到了归路……",
          "type": "dialogue"
        },
        {
          "sourceId": "22620007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……交错的命运终究重逢吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22620008",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "——藏在幕后的人，就是你吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22620009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你来了，又见面了……",
          "type": "dialogue"
        },
        {
          "sourceId": "22620010",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不，应该说，「终于见面了」——「蒂娅」。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620011",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "你好像对我的到来一点都不意外。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620012",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "当然，我知道你来这，是为了一个自己不曾拥有过的名字。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "「优纪」。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620014",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "这是什么意思？",
          "type": "dialogue"
        },
        {
          "sourceId": "22620015",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "哼哼哼，有趣，哈哈，哈哈哈哈……",
          "type": "dialogue"
        },
        {
          "sourceId": "22620016",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "你在笑什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "22620017",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "当然是笑你和「她」无知又可悲的命运。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620018",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "笑你们两个残缺不全的半成品。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620019",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "22620020",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你能感觉到「她」，对吧？她的记忆，她的情感……和你所缺失的，她的一切。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620021",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "真可悲。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620022",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "站住。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620023",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我不想跟你动手，现在还不是时候，等到……",
          "type": "dialogue"
        },
        {
          "sourceId": "22620024",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "等到你们各自成为完整的「你们」。",
          "type": "dialogue"
        },
        {
          "sourceId": "22620025",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "呵呵，祈祷你和「她」早点想起来吧，想起来——",
          "type": "dialogue"
        },
        {
          "sourceId": "22620026",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我的，「优纪」。",
          "type": "dialogue"
        }
      ],
      "id": "detail-494",
