{
  "bookId": "rewind-20",
  "id": "chapter-85",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "22618001",
          "sourceType": 0,
          "speaker": "格雷豪斯",
          "text": "喝阿阿阿阿——死亡旋风——",
          "type": "dialogue"
        },
        {
          "sourceId": "22618002",
          "sourceType": 0,
          "speaker": "格雷豪斯",
          "text": "哇呀呀呀，喝哈哈哈哈哈——",
          "type": "dialogue"
        },
        {
          "sourceId": "22618003",
          "sourceType": 0,
          "speaker": "膨胀薯条",
          "text": "我打打打——",
          "type": "dialogue"
        },
        {
          "sourceId": "22618004",
          "sourceType": 0,
          "speaker": "膨胀薯条",
          "text": "我打打打打打打打打——",
          "type": "dialogue"
        },
        {
          "sourceId": "22618005",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "我们也不能认输阿，「艾米莉亚」！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618006",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "全，速，突，击——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618007",
          "sourceType": 0,
          "speaker": "掌机",
          "text": "biu~biu~我biubiubiu~",
          "type": "dialogue"
        },
        {
          "sourceId": "22618008",
          "sourceType": 0,
          "speaker": "困困大王",
          "text": "哼哼哼，起来起来起来，给我起来——",
          "type": "dialogue"
        },
        {
          "sourceId": "22618009",
          "sourceType": 0,
          "speaker": "玲",
          "text": "报、报告长官！……他、他们火力太猛了……呜哇，我顶不住啦……！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618010",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "哈莉，干掉他们的指挥！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618011",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "阿哈，就是那个长了闹钟脸的大家伙吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "22618012",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "掩护「优纪」撤退，这里交给我！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618013",
          "sourceType": 0,
          "speaker": "玲",
          "text": "冲、冲过去了……好厉害！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618014",
          "sourceType": 0,
          "speaker": "梅根",
          "text": "玲，看路！——快闪开！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618015",
          "sourceType": 0,
          "speaker": "玲",
          "text": "哇阿阿阿……是超、超大的鲱鱼罐头怪！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618016",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "呵——！",
          "type": "dialogue"
        },
        {
          "sourceId": "22618017",
          "sourceType": 3,
          "text": "鲱鱼……呃阿……飞起来了……",
          "type": "narration"
        },
        {
          "sourceId": "22618018",
          "sourceType": 0,
          "speaker": "玲",
          "text": "谢、谢谢！！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-492",
      "sourceRefs": [
        {
          "bundle": "blackyouji",
          "rowIds": [
            22618001,
            22618002,
            22618003,
