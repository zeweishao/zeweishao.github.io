      "blocks": [
        {
          "sourceId": "26010001",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "不要用这样的眼神看我。",
          "type": "dialogue"
        },
        {
          "sourceId": "26010002",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "我想做的仅仅是保护好身边重要的人，不让自己珍惜的一切被侵犯。",
          "type": "dialogue"
        },
        {
          "sourceId": "26010003",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "即便冠上魔王的头衔，我也不会改变原则，纯粹的侵略和毁灭，我并没有这种残暴的兴趣。",
          "type": "dialogue"
        },
        {
          "sourceId": "26010004",
          "sourceType": 0,
          "speaker": "利姆鲁",
          "text": "毕竟我可不是什么坏史莱姆哦。",
          "type": "dialogue"
        }
      ],
