          "sectionId": 23401
        }
      ],
      "title": "流言·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "23402001",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "克罗赛尔。\n呵，天启的人，现在行动都开始这么明目张胆了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402002",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你就这样找到我的面前，是在小看我？觉得我一个人拿不下你？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402003",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "你这家伙的绅士风度都丢到哪里去了，我可不是来找你打打杀杀的。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402004",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "这样的夜晚面对我这样美丽的女士，你就不能有一些更正常点的想法？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402005",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "别把我当做那群愣头愣脑的小年轻，不是所有人看到你都会走不动路。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402006",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "女人，只会影响我出拳的速度。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402007",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "而且面对你这种危险的家伙，除非是活腻了，才会有人掉以轻心。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402008",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "我可以把这当做对我的夸赞吗？看来我在你的眼中还是有可取之处的嘛。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402009",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "那我顺便再说了，其实死掉的你，对我来说还有更多可取之处。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402010",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "啧啧啧，你这家伙就这么想让我去死吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402011",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "怎么说我们也有着那样一段纠缠的过往，真是冷血无情的男人。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402012",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "不过你是这种态度也正常，早在那个时候，你一直盯着的就是那个家伙。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402013",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "我早该想到，自己的魅力对你不会有任何作用的。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402014",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "……你到底想说什么？！",
          "type": "dialogue"
        },
        {
          "sourceId": "23402015",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "有故人苏醒了，你不想见见吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402016",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "故人？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402017",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "明明猜到……却不愿意回忆吗，不过没关系，如果你不想记起，我可以帮帮你。",
          "type": "dialogue"
        },
        {
          "sourceId": "23402018",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "「女人，在阿尔弗雷德面前，不要玩火。」",
          "type": "dialogue"
        },
        {
          "sourceId": "23402019",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你……你这女人……",
          "type": "dialogue"
        },
        {
          "sourceId": "23402020",
          "sourceType": 5,
          "speaker": "阿尔弗雷德",
          "text": "为什么会知道这个！？",
          "type": "dialogue"
        },
        {
          "sourceId": "23402021",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "这只是个开始哦~还有更多，我可以慢慢念给你听。",
          "type": "dialogue"
        }
      ],
      "id": "detail-523",
      "sourceRefs": [
        {
          "bundle": "edith",
          "rowIds": [
            23402001,
            23402002,
