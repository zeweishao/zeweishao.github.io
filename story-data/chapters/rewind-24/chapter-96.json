      "title": "漫步·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "23416001",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "哎呀~既然局势被翻转成了这样，果然只能启用备用的计划了吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416002",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "嗯嗯，看来比起花言巧语，我还是更喜欢简单直接的动手杀戮呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416003",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "这个会场有这么多的人质，阿尔弗雷德大人真的打算在这里动手吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23416004",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "想要炸弹威胁吗？这种老套的招式已经不起作用了，早在它们进入会场前，管理局的人已经进行过安全检查，排除了它们身上所有的隐患。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416005",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "至于你的精神魅惑……呵呵。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416006",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "克罗赛尔，在伊迪丝苏醒的时候，你就该清楚她对你有多大的威胁了吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416007",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你那一套逃跑的把戏，现在已经完全行不通了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416008",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "阿拉~差点都忘了，我这次的布置，是专门针对伊迪丝你来着。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416009",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "好不容易准备了这么多惊喜，结果就被这样解决掉了，不过考虑到我们过去还算是姐妹，伊迪丝你应该不会介意放我一条生路吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "23416010",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "很可惜，我是言而有信的人。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416011",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "既然是答应了阿尔弗雷德的承诺，除非拥有不可抗力影响，否则……克罗赛尔，你今天应该走不掉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416012",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "除非有……不可抗力吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416013",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "那貌似~我刚好有准备？",
          "type": "dialogue"
        },
        {
          "sourceId": "23416014",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "克罗赛尔！你这家伙……",
          "type": "dialogue"
        },
        {
          "sourceId": "23416015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "烟雾！！有奇怪的烟雾冒出来了！",
          "type": "dialogue"
        },
        {
          "sourceId": "23416016",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "红色的，一看就很奇怪！",
          "type": "dialogue"
        },
        {
          "sourceId": "23416017",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "大家请尽快疏散。",
          "type": "dialogue"
        },
        {
          "sourceId": "23416018",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "抱歉，现在才反应过来的话，已经来不及了哦~",
          "type": "dialogue"
        },
        {
          "sourceId": "23416019",
          "sourceType": 3,
          "text": "砰——！",
          "type": "narration"
        },
        {
          "sourceId": "23416020",
          "sourceType": 3,
          "text": "各色烟花炸开，烟雾笼罩了整个会场。",
          "type": "narration"
        }
      ],
