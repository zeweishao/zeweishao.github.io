      ],
      "title": "交涉·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "23408001",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "伊迪丝，真是没有想到，我们再次见面，会是在这种情形下。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408002",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "是吗。我还以为，从我出现，一直到被带到这个地方，都是在阿尔弗雷德你的算计之中呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408003",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "结果只是一场偶遇吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23408004",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "……伊迪丝。\n你果然是个可怕的女人。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408005",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "不过很可惜，设计这一切的并不是我。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408006",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "你是想说，这都是克罗赛尔的安排？",
          "type": "dialogue"
        },
        {
          "sourceId": "23408007",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "果然，你已经看出来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408008",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "没办法，谁让她在那些手办身上安置的炸弹总是老样式。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408009",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "但这也可能是她特别的欢迎仪式，想要告诉我……她盯上我了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408010",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "比起这个，你愿意跟她合作，这倒是出乎我的预料。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408011",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "让我想想，是因为过去我给你带来了太多的阴影，所以你在忌惮我的出现？",
          "type": "dialogue"
        },
        {
          "sourceId": "23408012",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "这不是合作，只是利用。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408013",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你是个危险的家伙！",
          "type": "dialogue"
        },
        {
          "sourceId": "23408014",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "在确定你对这个世界彻底无害之前，必须被控制起来。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408015",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "不过现在的结果看来……啧，克罗赛尔那女人远比我想象的更狡猾。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408016",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "在你残杀那些手办的视频记录下，即便没有我出手，管理局也必须抓捕你了。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408017",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "伊迪丝，你对你做过的一切还有什么要辩解的吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "23408018",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "噗……",
          "type": "dialogue"
        },
        {
          "sourceId": "23408019",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "伊迪丝？！你笑什么。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408020",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "没什么，嗯，许久未见，阿尔弗雷德你还是那样可爱。",
          "type": "dialogue"
        },
        {
          "sourceId": "23408021",
          "sourceType": 5,
          "speaker": "阿尔弗雷德",
          "text": "你！！",
          "type": "dialogue"
        }
      ],
      "id": "detail-528",
      "sourceRefs": [
        {
          "bundle": "edith",
          "rowIds": [
            23408001,
            23408002,
            23408003,
