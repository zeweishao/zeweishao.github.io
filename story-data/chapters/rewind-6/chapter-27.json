  "sections": [
    {
      "blocks": [
        {
          "noticeKind": "placeholder",
          "text": "原文中的动态称谓保留为占位符：|101|＝玩家昵称。",
          "type": "notice"
        }
      ],
      "id": "reading-note",
      "title": "阅读说明"
    },
    {
      "blocks": [
        {
          "sourceId": "3790001",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "吾名为：优·纪，是汝等最为黑暗的噩梦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790002",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "吾，命令汝等即刻将此魔王之训诫牢记于心。",
          "type": "dialogue"
        },
        {
          "sourceId": "3790003",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "此等屈辱之所，也容得下吾么！哼，跟吾一起去更宽广的天地决斗如何？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790004",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优……优纪……",
          "type": "dialogue"
        },
        {
          "sourceId": "3790005",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "优纪前辈……你……",
          "type": "dialogue"
        },
        {
          "sourceId": "3790006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "直呼吾之御名者，罪不可恕！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790007",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "在吾的恩赐之下，准许自尽，若此之外，别无他法！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790008",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "欸嘿嘿……你是一个傻子！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790009",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "放肆！此等大逆不道之轻蔑言语！吾要锤烂汝之狗头！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790010",
          "sourceType": 5,
          "speaker": "吕布",
          "text": "啊啊啊——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790011",
          "sourceType": 5,
          "speaker": "吕布",
          "text": "啊啊啊啊啊啊啊啊啊——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790012",
          "sourceType": 5,
          "speaker": "真田幸村",
          "text": "出现了！颜之艺术！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790013",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "啊——这——",
          "type": "dialogue"
        },
        {
          "sourceId": "3790014",
          "sourceType": 0,
          "speaker": "玲",
          "text": "我我我、这不是我的问题啦！（逃……",
          "type": "dialogue"
        },
        {
          "sourceId": "3790015",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "屠戮之宴，至！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790016",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "汝等，在天魔之力的颤栗中，化作无声的悲鸣罢！",
          "type": "dialogue"
        },
        {
          "sourceId": "3790017",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "居然……打起来了，快、快拦住他们！",
          "type": "dialogue"
        }
      ],
      "id": "detail-195",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3790001,
            3790002,
            3790003,
            3790004,
