          ],
          "sectionId": 3800
        }
      ],
      "title": "#2 吕布VS优纪"
    },
    {
      "blocks": [
        {
          "sourceId": "3810001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "汝、汝……还有汝！",
          "type": "dialogue"
        },
        {
          "sourceId": "3810002",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "睁开愚笨的双眼，吾将成为汝等漫步地狱黄泉的领路人。",
          "type": "dialogue"
        },
        {
          "sourceId": "3810003",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "嘿嘿……我是一个傻子……嘿嘿。",
          "type": "dialogue"
        },
        {
          "sourceId": "3810004",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "装疯卖傻的愚物，只会将吾的耐心消耗，尽数变为恣意的屠戮。",
          "type": "dialogue"
        },
        {
          "sourceId": "3810005",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪……优纪！请看看我！",
          "type": "dialogue"
        },
        {
          "sourceId": "3810006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "唔？汝已经切实做好踏上死亡乐土的决心了么？哼哈哈哈，幸运的愚物，正是如此。",
          "type": "dialogue"
        },
        {
          "sourceId": "3810007",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪……就连我，你也记不清了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3810008",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "只要让我使出一拳……就可以把你打上西天，欸嘿嘿……",
          "type": "dialogue"
        },
        {
          "sourceId": "3810009",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "哦？唔哈哈哈哈。",
          "type": "dialogue"
        },
        {
          "sourceId": "3810010",
          "sourceType": 2,
          "speaker": "优纪",
          "text": "什、什么？",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "3810011",
          "sourceType": 2,
          "speaker": "优纪",
          "text": "看似平凡无奇的一拳，竟然孕育了六合八荒、天地玄黄……",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "3810012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "若不是吾以妙曼之姿竭力抵挡……是吾低估了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3810013",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "如此甚好！",
          "type": "dialogue"
        },
        {
          "sourceId": "3810014",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "就让吾体内这恶鬼的余烬，燃烧的再持久一些罢！",
          "type": "dialogue"
        }
      ],
      "id": "detail-197",
      "sourceRefs": [
        {
          "bundle": "exceldata",
