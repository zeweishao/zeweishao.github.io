      ],
      "title": "#4 外层·内层"
    },
    {
      "blocks": [
        {
          "sourceId": "3830001",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "左边，是左边哦……",
          "type": "dialogue"
        },
        {
          "sourceId": "3830002",
          "sourceType": 2,
          "speaker": "优纪",
          "text": "唔哈哈哈，那吾定然从右侧奇袭！",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "3830003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这，怎么可能？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830004",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "早就告诉过你了啦，是左边，左边哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "好大的胆子！竟敢戏耍吾！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830006",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "吾誓要掏出汝滚烫之心脏，于尘土之上践踏！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830007",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "欸嘿嘿……这一次，是右边哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830008",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "死吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830009",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "早就说过是右边了哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830010",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "你这混账东西！！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830011",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "呜哇哇哇……好痛，好痛！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830012",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这就是与吾作对、与天地作对的下场！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830013",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "前辈……优纪前辈涂料剥落的……更加厉害了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830014",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "讯息收到！",
          "type": "dialogue"
        },
        {
          "sourceId": "3830015",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "我们分出全力，对抗这些包围的玩具！至于其他的……",
          "type": "dialogue"
        },
        {
          "sourceId": "3830016",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "也只能交给他了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-199",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
