          "sectionId": 3535
        }
      ],
      "title": "#6 工作台"
    },
    {
      "blocks": [
        {
          "sourceId": "3538001",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "副指挥官……",
          "type": "dialogue"
        },
        {
          "sourceId": "3538002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你、你居然……是？",
          "type": "dialogue"
        },
        {
          "sourceId": "3538003",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "在火焰中经过重塑的数百具身体……",
          "type": "dialogue"
        },
        {
          "sourceId": "3538004",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "现在已经厌倦了……复仇。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538005",
          "sourceType": 3,
          "text": "巨龙振翅飞走，破窗飞向天空，消失不见。",
          "type": "narration"
        },
        {
          "sourceId": "3538006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "打败阿撒兹勒、摧毁流水线的唯一方法，就是这瓶涂料。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538007",
          "sourceType": 3,
          "text": "当涂料涂满优纪全身，她的体内似乎蕴含了一股短暂的，不稳定的力量。",
          "type": "narration"
        },
        {
          "sourceId": "3538008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "大家！「奇迹涂料」的作用时间有限！\n涂料只会短暂的附着在身上，随后很快就会消失不见！",
          "type": "dialogue"
        },
        {
          "sourceId": "3538009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "凭借这股力量，击败他们吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "3538010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "到时候，我们一定能离开这里，再次见到主人！",
          "type": "dialogue"
        },
        {
          "sourceId": "3538011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "那些玩具背叛了我。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538012",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "但是这柄剑刃却永远不会。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我不会让你们，活着离开这里的！\n我会设下重重阻碍，拦住你们！",
          "type": "dialogue"
        },
        {
          "sourceId": "3538014",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "小宝贝，你藏在哪里呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "3538015",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "嘘……要乖乖的不能发出声音哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538016",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "在这里吗？没有……",
          "type": "dialogue"
        },
        {
          "sourceId": "3538017",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "这里吗……也不是。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538018",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "哦，我听到你了，啊哈哈哈哈，找到了找到了!",
          "type": "dialogue"
        },
        {
          "sourceId": "3538019",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "最后一块能量石宝宝，我终于找到你了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538020",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "管理局的人啊，你们听好了喔。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538021",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "「天启」的反击开始了哦，好好期待这场狩猎游戏吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3538022",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "哎呀，怎么办呢？来的入口已经被封住了。看来要找别的出口。",
          "type": "dialogue"
        }
      ],
      "id": "detail-225",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3538001,
            3538002,
            3538003,
            3538004,
