          ],
          "sectionId": 3890
        }
      ],
      "title": "#5 死亡的烈焰"
    },
    {
      "blocks": [
        {
          "sourceId": "3900001",
          "sourceType": 5,
          "speaker": "吕布",
          "text": "混账混账混账，烫烫烫烫烫，好烫！",
          "type": "dialogue"
        },
        {
          "sourceId": "3900002",
          "sourceType": 0,
          "speaker": "真田幸村",
