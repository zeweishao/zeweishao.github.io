          "sectionId": 3870
        }
      ],
      "title": "#3 巨龙"
    },
    {
      "blocks": [
        {
          "sourceId": "3880001",
          "sourceType": 5,
          "speaker": "真田幸村",
          "text": "燃烧吧！我的宇宙！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880002",
          "sourceType": 0,
          "speaker": "吕布",
          "text": "割龙肉，当酒菜。",
          "type": "dialogue"
        },
        {
          "sourceId": "3880003",
          "sourceType": 5,
          "speaker": "提尔",
          "text": "死吧！虫子们！吼——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880004",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "啊……居然，完全不是对手。",
          "type": "dialogue"
        },
        {
          "sourceId": "3880005",
          "sourceType": 5,
          "speaker": "吕布",
          "text": "跑！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880006",
          "sourceType": 5,
          "speaker": "提尔",
          "text": "你——！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "和江——小心！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880008",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "金牌搭档，在此！\n优纪，有你陪在身边，我不会畏惧任何威胁！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880009",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "优……",
          "type": "dialogue"
        },
        {
          "sourceId": "3880010",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "副……指挥……",
          "type": "dialogue"
        },
        {
          "sourceId": "3880011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "将你的渴望……建立在别人的痛苦之上，如果说为什么！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880012",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "这就是我必须要阻止的理由。",
          "type": "dialogue"
        },
        {
          "sourceId": "3880013",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "优……",
          "type": "dialogue"
        },
        {
          "sourceId": "3880014",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你僭越了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3880015",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "是，主人。",
          "type": "dialogue"
        },
        {
          "sourceId": "3880016",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "杀了这些FULI的玩具。",
          "type": "dialogue"
        },
        {
          "sourceId": "3880017",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不留，任何活口。",
          "type": "dialogue"
        }
      ],
      "id": "detail-204",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3880001,
