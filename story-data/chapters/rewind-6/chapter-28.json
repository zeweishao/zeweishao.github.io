      ],
      "title": "#1 两个记忆"
    },
    {
      "blocks": [
        {
          "sourceId": "3860001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你的名字……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "我记得你的名字……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你是……那个时候一直陪在我身边的……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那个……那一个……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860005",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "优纪。",
          "type": "dialogue"
        },
        {
          "sourceId": "3860006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "可是为什么……那个时候的你……为什……么。",
          "type": "dialogue"
        },
        {
          "sourceId": "3860009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "为什么……要将其他玩具，置于死地！",
          "type": "dialogue"
        },
        {
          "sourceId": "3860011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860012",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "这就是你苏醒之后，想要问我的第一件事吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3860013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "哼。",
          "type": "dialogue"
        },
        {
          "sourceId": "3860014",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我曾经预想过，我们再次见面的无数开场。",
          "type": "dialogue"
        },
        {
          "sourceId": "3860015",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "但是却想不到，是这一句。",
          "type": "dialogue"
        },
        {
          "sourceId": "3860016",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "哈哈哈哈哈哈哈……呵哈哈……哈哈……",
          "type": "dialogue"
        },
        {
          "sourceId": "3860017",
          "sourceType": 3,
          "text": "阿撒兹勒放声狂笑，巨大的声音响彻天地。",
          "type": "narration"
        },
        {
          "sourceId": "3860018",
          "sourceType": 3,
          "text": "周遭一片寂静，像是笼罩了一层……悲怆的哀鸣。",
          "type": "narration"
        }
      ],
      "id": "detail-202",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3860001,
            3860002,
