          ],
          "sectionId": 3860
        }
      ],
      "title": "#2 怎样的人"
    },
    {
      "blocks": [
        {
          "sourceId": "3870001",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "哼，我偷偷观察你好久了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3870002",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "只懂纸上谈兵的，不算上真正的武士。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870003",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "能接住这一枪，我就服你！",
          "type": "dialogue"
        },
        {
          "sourceId": "3870004",
          "sourceType": 5,
          "speaker": "阿撒兹勒",
          "text": "呵呵……",
          "type": "dialogue"
        },
        {
          "sourceId": "3870005",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "好……好强……",
          "type": "dialogue"
        },
        {
          "sourceId": "3870006",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "仅凭借气势，就将我震离三尺之外。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870007",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "既然如此，我也要反击喽！",
          "type": "dialogue"
        },
        {
          "sourceId": "3870008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "嘘————！",
          "type": "dialogue"
        },
        {
          "sourceId": "3870009",
          "sourceType": 3,
          "text": "刺耳的哨响似要刺穿鼓膜，随即一阵剧烈的抖动，一条巨龙正响应这阵哨声而来。",
          "type": "narration"
        },
        {
          "sourceId": "3870010",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "应主人的要求，前来。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "杀了它们吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870012",
          "sourceType": 0,
          "speaker": "提尔",
          "text": "遵照主人的意志行事。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不要怪我，优纪。",
          "type": "dialogue"
        },
        {
          "sourceId": "3870014",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你我在各自的道路上，已经……走的太远了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-203",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3870001,
