      ],
      "title": "#1 十五年前合照"
    },
    {
      "blocks": [
        {
          "sourceId": "3675001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "主人会在工厂的什么地方？",
          "type": "dialogue"
        },
        {
          "sourceId": "3675002",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "我知道我知道，一定是在他的「专属工作室」里。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675003",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "努力把自己一个人锁起来，没日没夜的将脑海中的想法全都投入到设计图纸上。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675004",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "就是像工作狂一样的家伙，没错吧~！",
          "type": "dialogue"
        },
        {
          "sourceId": "3675005",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "不赖。\n那就跟紧我吧，别走丢。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675006",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "不用啦不用啦，我走前面吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675007",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "你慢悠悠的在后面，就像一只大~乌~龟~慢都慢死啦，哈哈……",
          "type": "dialogue"
        },
        {
          "sourceId": "3675008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "3675009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "看来我家的女孩，长大了呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675010",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "四周堆放了许多看起来很特别的东西，喂，是做什么用的啦？",
          "type": "dialogue"
        },
        {
          "sourceId": "3675011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "落满灰尘的废弃娱乐设施。\n看样子以前这间厂房在被租下之前，似乎是专门用来存放这些设备用的。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675012",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "欸……“娱乐设施”？",
          "type": "dialogue"
        },
        {
          "sourceId": "3675013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "该怎么解释呢，大概就像是「摩天轮」、「过山车」这样的……很刺激，很有趣……",
          "type": "dialogue"
        },
        {
          "sourceId": "3675014",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "哇，明天就去吧，好不好！\n我从来都没见过，好想认真体验一下！",
          "type": "dialogue"
        },
        {
          "sourceId": "3675015",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "那当然是要看我的心情了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675016",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "不要嘛！用盾牌给你扇扇凉~~扇扇凉~~",
          "type": "dialogue"
        },
        {
          "sourceId": "3675017",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "胡闹，简直跟小孩子一样。\n看在你这么努力的份上，只能勉为其难答应你了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675018",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "等等，快看这股烟雾……是怎么回事？！留意到了吗？优纪。",
          "type": "dialogue"
        },
        {
          "sourceId": "3675019",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "我看到了我看到了，是真的！",
          "type": "dialogue"
        },
        {
          "sourceId": "3675020",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "快！我们去源头看看！如果是火灾，那就糟糕了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-182",
      "sourceRefs": [
        {
