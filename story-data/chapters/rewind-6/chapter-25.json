      ],
      "title": "#2 烟"
    },
    {
      "blocks": [
        {
          "sourceId": "3680001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你们！你们怎么会在这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "3680002",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "看到主人了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3680003",
          "sourceType": 0,
          "speaker": "牙牙",
          "text": "（意识模糊）今天……也有在……很认真的刷牙呀……牙牙……",
          "type": "dialogue"
        },
        {
          "sourceId": "3680004",
          "sourceType": 0,
          "speaker": "膨胀薯条",
          "text": "（意识模糊）油温过热……油温过热……",
          "type": "dialogue"
        },
        {
          "sourceId": "3680005",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "被重物压在身上，已经完全失去意识了……",
          "type": "dialogue"
        },
        {
          "sourceId": "3680006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "震动的声音。",
          "type": "dialogue"
        },
        {
          "sourceId": "3680007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "如果箱子彻底倒下来，它们会死在这里。",
          "type": "dialogue"
        },
        {
          "sourceId": "3680008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "交给我，我会处理这一切。",
          "type": "dialogue"
        },
        {
          "sourceId": "3680009",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "我……我应该怎么办！一定很重吧！我、我也要来一起帮忙。",
          "type": "dialogue"
        },
        {
          "sourceId": "3680010",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "无须插手。",
          "type": "dialogue"
        },
        {
          "sourceId": "3680011",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "那么……等、等等我！",
          "type": "dialogue"
        },
        {
          "sourceId": "3680012",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "我会找到支撑用的架子，耐心等我一下，一下就好！",
          "type": "dialogue"
        },
        {
          "sourceId": "3680013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……",
          "type": "dialogue"
        }
      ],
      "id": "detail-183",
      "sourceRefs": [
        {
