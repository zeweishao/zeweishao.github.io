      ],
      "title": "#3 温柔"
    },
    {
      "blocks": [
        {
          "sourceId": "3630001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "轻而易举就处理完毕了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630002",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "诸位，情况现下皆在掌控之中。\n先将它关进箱子里，待情绪稳定，第一时间着手安排流水线修复。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630003",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "将昨晚被老鼠啃掉的缺失涂料补全，理应就该恢复为早先正常的状态了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630004",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "指挥官威武！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630005",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "指挥官英明！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "够了，这些彩虹屁每天说一遍，已经听腻了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我们的使命，是偷偷在暗中帮主人掌控流水线生产的秩序，而不被他发现我们会动的事实。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "换言之，主人的梦想，就是我们作为玩具的梦想，你们可做好这个觉悟了么？",
          "type": "dialogue"
        },
        {
          "sourceId": "3630009",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "牢记指挥官的教导。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630010",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "永远把主人和指挥官的话牢记在心！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630011",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "很好，身为玩具的使命，应当如此。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630012",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "还有，要放在心底的，不止有我跟主人而已。\n今天，我要向诸位介绍「非常玩具公司」工厂的副指挥官！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "优纪，别躲在后面了，出来跟大家打个招呼吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630014",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "欸……这个……那个……",
          "type": "dialogue"
        },
        {
          "sourceId": "3630015",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "副指挥官好！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630016",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "保证完成副指挥官交代的任务。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630017",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "欸——？！欸——？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630018",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "我……那个，不、不是啦！你……你们……那个……",
          "type": "dialogue"
        },
        {
          "sourceId": "3630019",
          "sourceType": 0,
          "speaker": "阿一",
          "text": "那个……是，是。我完全明白。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630020",
          "sourceType": 0,
          "speaker": "阿一",
          "text": "有关于您提到的建议，我……确实会认真的考虑。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630021",
          "sourceType": 5,
          "speaker": "阿撒兹勒",
          "text": "听声音，像是二主人回来了。是在打电话吗……？",
          "type": "dialogue"
        },
        {
          "sourceId": "3630022",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "就像平时演练的那样，各部门，立即执行「僵硬」指令。",
          "type": "dialogue"
        },
        {
          "sourceId": "3630023",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "收到！",
          "type": "dialogue"
        },
        {
          "sourceId": "3630024",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "指令准确接收，立即执行「僵化」模式",
          "type": "dialogue"
        },
        {
          "sourceId": "3630025",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "僵……僵化吗？等，等一下啦！我还没藏好呢！",
          "type": "dialogue"
        }
      ],
      "id": "detail-177",
