      ],
      "title": "#5 橄榄枝"
    },
    {
      "blocks": [
        {
          "sourceId": "3650001",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "咕咕……",
          "type": "dialogue"
        },
        {
          "sourceId": "3650002",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "咯咯咯~~~~！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650003",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "瞄准，轰炸！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650004",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "咯咯哒……咯咕咕哒哒……咕咯咯~！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650005",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "对不起，我瞄偏了，它它它……实在太灵活了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我都看在眼里了，用不着汇报！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650007",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "指挥官！现在它不论如何，都不肯进流水线补全涂装了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "重申一遍，我看到了。\n而且我还知道，有了刚才的前车之鉴，现在它更警觉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我需要的是处理问题的手段，而不是复述问题的说客！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650010",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "明……明白了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650011",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "指挥官，我我我，申请自爆！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650012",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "你们在开什么玩笑！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650013",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "等……等等！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650014",
          "sourceType": 3,
          "text": "一声“轰隆”之下，玩具手雷自爆了，随即一阵童趣的歌唱声从里面传来……",
          "type": "narration"
        },
        {
          "sourceId": "3650015",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "“祝你生日快乐~祝你生日快乐~祝你幸福快乐，祝你……”",
          "type": "dialogue"
        },
        {
          "sourceId": "3650016",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "够了，这些三岁小孩的把戏！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650017",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "对……对不起！刚才我按错按钮了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650018",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "这一次才是真的！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650019",
          "sourceType": 3,
          "text": "不顾阿撒兹勒阻拦，玩具手雷自爆了。这声轰隆的爆炸引发了不小的骚动，流水线上的装满重物的纸箱直直朝手办阿撒兹勒头顶砸去。",
          "type": "narration"
        },
        {
          "sourceId": "3650020",
          "sourceType": 0,
          "speaker": "小手雷",
          "text": "不……不好了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650021",
          "sourceType": 0,
          "speaker": "小坦克",
          "text": "你你你，你这笨手雷！指挥官大人！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650022",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "嘿嘿，稳稳当当，接住了哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650023",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "优纪你，这样的重量，怎么可能？！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650024",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "自从被主人涂上特制的涂料后，好像时不时，就会变成这个样子吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "3650025",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "欸嘿嘿，虽然有点不够淑女，但危机总算解除了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650026",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "真是不敢相信。",
          "type": "dialogue"
        },
        {
          "sourceId": "3650027",
          "sourceType": 0,
          "speaker": "优纪（回忆）",
          "text": "你……快点挪开了啦，我……已经撑不了多久了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3650028",
          "sourceType": 5,
          "speaker": "优纪（回忆）",
          "text": "咿呀呀，这下真的坚持不住了。重物，要、要砸下来了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-179",
