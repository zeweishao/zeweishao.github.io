            3980014
          ],
          "sectionId": 3980
        }
      ],
      "title": "#2 痛苦的挣扎"
    },
    {
      "blocks": [
        {
          "sourceId": "3990001",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "很好。",
          "type": "dialogue"
        },
        {
          "sourceId": "3990002",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "将剑重新插入扣孔，继续启动流水线。",
          "type": "dialogue"
        },
        {
          "sourceId": "3990003",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "生产永不停止，直至FULI身败名裂，名誉扫地的那天！",
          "type": "dialogue"
        },
        {
          "sourceId": "3990004",
          "sourceType": 3,
          "text": "废弃工厂内，大量手办被束缚着，跌入流水线机器中。",
          "type": "narration"
        },
        {
          "sourceId": "3990005",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "可恶……快点放开我！",
          "type": "dialogue"
        },
        {
          "sourceId": "3990006",
          "sourceType": 0,
          "speaker": "葵",
          "text": "我……我不要在这里睡觉！这里晒不到太阳！",
          "type": "dialogue"
        },
        {
          "sourceId": "3990007",
          "sourceType": 0,
          "speaker": "艾里克希娅",
          "text": "你们……怎能如此对待偶像。",
          "type": "dialogue"
        },
        {
          "sourceId": "3990008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "大家，都……",
          "type": "dialogue"
        },
        {
          "sourceId": "3990009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "我不能够……再这样……继续退缩了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-215",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3990001,
            3990002,
            3990003,
            3990004,
            3990005,
            3990006,
            3990007,
            3990008,
            3990009
          ],
          "sectionId": 3990
        }
      ],
      "title": "#3 胁迫"
    },
    {
      "blocks": [
        {
          "sourceId": "3995001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "如果抹去大部分主人的涂装，只保留身体上必要的涂装......也许，跟主人的美好记忆，优纪就不会遗忘！",
          "type": "dialogue"
        },
        {
          "sourceId": "3995002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "用刀刻在身体上……对于手办来说，虽然没有任何痛觉。",
          "type": "dialogue"
        },
        {
          "sourceId": "3995003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "但因为一点一滴要失去跟主人的记忆，所以心脏的位置，感觉好痛！",
          "type": "dialogue"
        },
        {
          "sourceId": "3995004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "主人！并非优纪要……刻意这样去做。\n在优纪的心里，主人是优纪的全部全部。",
          "type": "dialogue"
        },
        {
          "sourceId": "3995005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "只是，大家都在期待和渴望着我，只有从回忆里，才有可能找到战胜他的方法！",
          "type": "dialogue"
        },
        {
          "sourceId": "3995006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "主人……如果你能够听到，如果你能够看到……",
          "type": "dialogue"
        },
        {
          "sourceId": "3995007",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "身为天底下最好的主人，你也一定会像……优纪这样去做吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "3995008",
          "sourceType": 3,
          "text": "优纪斑驳的身体上，随着黄色涂料的脱落，露出更大面积的、斑驳的蓝色。",
          "type": "narration"
        },
        {
          "sourceId": "3995009",
          "sourceType": 3,
          "text": "随即，记忆宛如潮水一般，开始涌现。",
          "type": "narration"
        }
      ],
      "id": "detail-216",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3995001,
            3995002,
            3995003,
            3995004,
            3995005,
            3995006,
            3995007,
            3995008,
            3995009
          ],
          "sectionId": 3995
        }
      ],
      "title": "#4 思念的割舍"
    },
    {
      "blocks": [
        {
          "sourceId": "3501001",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "现在，在精心研制的「特殊涂料」的染色加持下，掌中的手办像真人一样栩栩如生了。",
          "type": "dialogue"
        },
        {
          "sourceId": "3501002",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "「「奇迹涂料」」的一号手办试验作品就此诞生，哈哈，姑且就先这样命名吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "3501003",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "永不退色的涂料，代表了人类对于手办永不褪去的爱。",
          "type": "dialogue"
        },
        {
          "sourceId": "3501004",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "这样的结果，一定非常美妙吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "3501005",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "所以，辛苦研制的涂料……当下一定要好好保存起来。",
          "type": "dialogue"
        },
        {
          "sourceId": "3501006",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "把它决定放在什么地方好呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "3501007",
          "sourceType": 0,
          "speaker": "Terry",
          "text": "想到了……嘿嘿，就放在这里……",
          "type": "dialogue"
        },
        {
          "sourceId": "3501008",
          "sourceType": 3,
          "text": "回忆戛然而止。",
          "type": "narration"
        }
      ],
      "id": "detail-217",
      "sourceRefs": [
        {
          "bundle": "exceldata",
          "rowIds": [
            3501001,
            3501002,
            3501003,
            3501004,
            3501005,
            3501006,
            3501007,
            3501008
          ],
          "sectionId": 3501
        }
      ],
      "title": "#5 封存的回忆"
    },
    {
      "blocks": [
        {
          "sourceId": "3505001",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "优纪，优纪！",
          "type": "dialogue"
        },
        {
          "sourceId": "3505002",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "你……不能够再这样对待自己了！",
          "type": "dialogue"
        },
        {
          "sourceId": "3505003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "和江……我好没用……",
          "type": "dialogue"
        },
        {
          "sourceId": "3505004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "呜……我好没用啊……",
          "type": "dialogue"
        },
        {
          "sourceId": "3505005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "为什么，总是在最为要紧的关头，我就回忆不起来了……对，对不起！",
          "type": "dialogue"
        },
        {
          "sourceId": "3505006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "很快，这些手办就将通过物流被重新摆放在FULI的货架上，替换原有的产品。",
          "type": "dialogue"
        },
        {
          "sourceId": "3505007",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "想象人类把它们买回家之后的样子。",
          "type": "dialogue"
        },
        {
          "sourceId": "3505008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "呵哈……呵哈哈哈哈……",
          "type": "dialogue"
        },
        {
          "sourceId": "3505009",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "我终于，等到这一天了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-218",
