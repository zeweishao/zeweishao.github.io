            34203014,
            34203015,
            34203016,
            34203017,
            34203018
          ],
          "sectionId": 34203
        }
      ],
      "title": "恋爱支援作战·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "34013001",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "「用闪电击碎黑暗。」\n就是你了！",
          "type": "dialogue"
        },
        {
          "sourceId": "34013002",
          "sourceType": 0,
          "speaker": "魔力容器A",
          "text": "呜啊——",
          "type": "dialogue"
        },
        {
          "sourceId": "34013003",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "「在黄昏前偷走时间。」\n发现目标~",
          "type": "dialogue"
        },
        {
          "sourceId": "34013004",
          "sourceType": 0,
          "speaker": "魔力容器B",
          "text": "快放开我！救命啊！来人啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "34013005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "一切都是为了帮蔡文姬改变命运！\n挥动吧！旋转之星！",
          "type": "dialogue"
        },
        {
          "sourceId": "34013006",
          "sourceType": 0,
          "speaker": "魔力容器C",
          "text": "哎呦，你干嘛！叽！",
          "type": "dialogue"
        },
        {
          "sourceId": "34013007",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "有一份重要文件给|101|。\n咦，这几个手办好眼熟。",
          "type": "dialogue"
        },
        {
          "sourceId": "34013008",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "我是伊迪丝大人的员工——\n哇啊啊，你们干什么？不要过来呀！",
          "type": "dialogue"
        }
      ],
      "id": "detail-780",
      "sourceRefs": [
        {
          "bundle": "caiwenji",
          "rowIds": [
            34013001,
            34013002,
            34013003,
            34013004,
            34013005,
            34013006,
            34013007,
            34013008
          ],
          "sectionId": 34013
        }
      ],
      "title": "恋爱支援作战·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "34014001",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "终于安静了。什么法术的反噬，都是骗人的。\n……蔡文姬，我们有话想对你说。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014002",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "是啊，你们肯定有很多话想对我说。\n至尊男爵，还有阳光熊仔。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014003",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "你是怎么……唉，我们并非故意隐瞒。\n我们只是担心你会上当受骗。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014004",
          "sourceType": 0,
          "speaker": "孙尚香",
          "text": "刚才我们去审讯抓到的骗子了，能够确定你的知己不是他们的同伙。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014005",
          "sourceType": 0,
          "speaker": "孙尚香",
          "text": "但谁也不能保证|102|就不是骗子。我们真的不想你有事，为了安全，你还是放弃吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014006",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "原来如此……你们是这么想的吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014007",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "网络确实是虚拟的。但在网络上倾注的感情是真实的。\n彼此陪伴的时光也是真实的。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014008",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "我愿意相信彼此之间的善意和情谊。\n我相信那位知己和你们一样，是我真正的朋友。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014009",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "我知道，这可能是我的一厢情愿……\n但至少，请给我一个证明的机会……",
          "type": "dialogue"
        },
        {
          "sourceId": "34014010",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "阿蝉，尚香，谢谢你们替我着想。\n倘若真有意外，我会保护自己的。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014011",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "……罢了罢了，既然如此，我们也没有理由再阻拦你了。\n不过你如何发现我们的身份？",
          "type": "dialogue"
        },
        {
          "sourceId": "34014012",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "难道是孙大小姐暴露了？我一直觉得她平日说话的口吻，和《霸总宝典》里的台词一样呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014013",
          "sourceType": 0,
          "speaker": "孙尚香",
          "text": "荒谬，给你一分钟时间，收回你的话。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014014",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "其实，我也觉得有点像呢。\n孙尚香，要不要看看你的星座分析和MBTI类型？",
          "type": "dialogue"
        },
        {
          "sourceId": "34014015",
          "sourceType": 0,
          "speaker": "孙尚香",
          "text": "住……住口，不要再让本大小姐说第二遍！",
          "type": "dialogue"
        },
        {
          "sourceId": "34014016",
          "sourceType": 3,
          "text": "与此同时……",
          "type": "narration"
        },
        {
          "sourceId": "34014017",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "|101|，安全系统的开发终于告一段落。让你以手办的人设发言，真是辛苦你了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014018",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "我们会根据你的发言设计屏蔽词库，再配合身份认证，肯定可以解决犯罪问题。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014019",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "作为谢礼，你有什么愿望吗？我会尽量替你实现。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014020",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "这段日子，我在网上认识了一位手办朋友。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014021",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "我一直没有说明我人类的身份……我不想撒谎，但又怕对方不能接受。",
          "type": "dialogue"
        },
        {
          "sourceId": "34014022",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "马上我们就要见面了，我想知道我的这位朋友，究竟是谁。",
          "type": "dialogue"
        }
      ],
