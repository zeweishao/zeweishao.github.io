            34017012
          ],
          "sectionId": 34017
        },
        {
          "bundle": "caiwenji",
          "rowIds": [
            34204001,
            34204002,
            34204003,
            34204004,
            34204005
          ],
          "sectionId": 34204
        }
      ],
      "title": "咫尺间的幸福·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "34018001",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "原来是牙白白先生，谢谢你救了我。\n你刚才说的……",
          "type": "dialogue"
        },
        {
          "sourceId": "34018002",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "没错，我就是你的知己。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018003",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "牙白白先生，请别和我开玩笑了……",
          "type": "dialogue"
        },
        {
          "sourceId": "34018004",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "你不信？我们去个没人的地方，我证明给你看。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018005",
          "sourceType": 3,
          "text": "一段时间后……",
          "type": "narration"
        },
        {
          "sourceId": "34018006",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "怎么样，蔡文姬。我们的聊天记录，我能一字一句全部背下来。这样你总信了吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018007",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "我从没和知己说过我的真名……你究竟是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "34018008",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "啧，居然输在这种细节上了吗。本以为利用身份认证知道真名之后，就更容易下手才对。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018009",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "你果然不是我的知己！\n你怎么知道我和|102|的事！",
          "type": "dialogue"
        },
        {
          "sourceId": "34018010",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "哼哼哼，既然你诚心发问，那我就大发慈悲告诉你！\n我就是大名鼎鼎的神秘甜心！",
          "type": "dialogue"
        },
        {
          "sourceId": "34018011",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "我潜伏在管理局里，就是为了获得手办的网络数据。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018012",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "那些聊天记录，我一下就能记住。再加上有了身份认证，还不是一骗一个准吗。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018013",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "本来我只是想要你的宝贝胡笳。\n不过你知道了这么多，我可不能放你走了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018014",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "管理局有内鬼？燥起来燥起来！",
          "type": "dialogue"
        },
        {
          "sourceId": "34018015",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "你，你们是谁？！怎么会在这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "34018016",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "哼，本王说了，会回来救人的。\n你快投降吧，你的那些手下已经被我们解决了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34018017",
          "sourceType": 0,
          "speaker": "牙白白",
          "text": "我骗来的涂料还没用完呢。想让我投降？门都没有！看招！",
          "type": "dialogue"
        },
        {
          "sourceId": "34018018",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "哼，不自量力，你这是自寻死路。",
          "type": "dialogue"
        }
      ],
      "id": "detail-785",
      "sourceRefs": [
        {
          "bundle": "caiwenji",
          "rowIds": [
            34018001,
            34018002,
