            6885014,
            6885015,
            6885016,
            6885017,
            6885018
          ],
          "sectionId": 6885
        }
      ],
      "title": "盛情难却·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "6915001",
          "sourceType": 9,
          "text": "晚间11:00，家中的桌面上。\n一个陌生的怪盗早已捷足先登，大胆来到你面前。",
          "type": "narration"
        },
        {
          "sourceId": "6915002",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "好久不见。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915003",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "雪已经停了吧，此时此刻，在这样的夜晚。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915004",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，不得不说，能够再次见到你……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915005",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "真是一件赏心悦目，让人发自内心感到开心的事呀。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915007",
              "text": "你就是要偷走我的怪盗！"
            }
          ],
          "sourceId": "6915006",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915007",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "嘘——",
          "type": "dialogue"
        },
        {
          "sourceId": "6915008",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "别开口。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915009",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我知道你想问什么。\n因为那些可爱的好奇已经要从你的眼睛中洋溢出来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915010",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但是在这之前，可以请你给我一分钟吗？非常认真地拜托你，我只要一分钟。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915012",
              "text": "一分钟？"
            }
          ],
          "sourceId": "6915011",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915012",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "从现在开始，在这短短的60s内，什么都不想，什么也不做。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915013",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "只保留内心的悸动，就像现在这样——",
          "type": "dialogue"
        },
        {
          "sourceId": "6915014",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "紧紧注视我。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915015",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，有人告诉过你吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915016",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "你的眼神真美。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915017",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "当因为紧张、急促，但在小小好奇的驱使下又忍不住偷望向一个人时。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915018",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "你的眼神在不安和怀疑中漫天闪烁。\n就像浮在天上的、水面颤动的倒影一样，会发光。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915019",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "来这之前的一周，我曾经假扮作人类的身份——\n以一个让人无法不产生怜意的、寒风中失恋的女孩，打电话去电台约歌。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915020",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "那是晚上的12点，四周好安静，只有下雪的声音。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915021",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我躲在未拆除的老式电话亭中，悬挂着身子，一个按键一个按键拨通电台的号码。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915022",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "受制于手办的体型，描述起来真是十分滑稽。但为了这一刻，能让你听到我想给你听的曲子，一切都是值得，不是吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915023",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "所以我猜想……你应该完全不会介意我，打开桌上的录音设备吧？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915025",
              "text": "要听电台吗？请便吧。"
            }
          ],
          "sourceId": "6915024",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915025",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "真迷人，我是说这首曲子，就像你一样。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915026",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "据说曲子的作者是位温柔细腻的双鱼座女人。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915027",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "在她情窦初开的19岁，对前来教堂礼拜的少年一见倾心。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915028",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "当时她因为生性羞怯，不论如何，始终不敢朝心上人吐露爱意。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915029",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "后来当她决定远赴巴黎，独自在教堂弹奏了这首相思缠绵的钢琴曲。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915030",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "这其实意味着，今晚短暂的相逢后，我也将很快离开这里。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915031",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "虽然目的地不是同一个巴黎，也可能是别的地方，很遗憾，暂时还不能透露给你。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915032",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但不可否认的是，在这一分钟之内。\n我完完全全独占了你，而你也彻彻底底……独属于我。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915033",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我真的好喜欢这种感觉。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915034",
          "sourceType": 9,
          "text": "4s… 3s… 2s…",
          "type": "narration"
        },
        {
          "sourceId": "6915035",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "最后1秒，音乐还未暂停，但帷幕即将落下。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915036",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "还想说……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915037",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "月色真美。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915038",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "好了，一分钟结束。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915039",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "作为交换，在离别之际，如果你还着迷，我想我们或许可以一起揭开那些为你而设的……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915040",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "谜题。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915042",
              "text": "我喜欢你的魔术。"
            }
          ],
          "sourceId": "6915041",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915042",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "感谢，我也同样喜欢你的风度。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915043",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，你听说过吗？\n任何一个令人惊叹的魔术背后，都有一个纯粹而简单的核心。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915044",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "在这场与你有关的魔术里：偷走你，即为独占你。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915045",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但这远远不够。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915046",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "“The world is simple, miserable, solid all the way through.”",
          "type": "dialogue"
        },
        {
          "sourceId": "6915047",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "也正因如此，所以我想你才如此甘愿沉沦，投身沉溺在这场魔术里。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915048",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我利用了一些司空见惯的道具和手段，一旦它跟现实的表象达成微妙的反应后——",
          "type": "dialogue"
        },
        {
          "sourceId": "6915049",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "魔术就达成了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915050",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "噢，有些累了，不介意我换个姿势吧。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915052",
              "text": "……"
            }
          ],
          "sourceId": "6915051",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915052",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "闪耀的珠宝、珍贵的文物，我在过去常因追逐而着迷。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915053",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但你跟它们却截然不同。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915054",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "“The figures are simple, miserable, solid all the way through.”\n“塑料树脂微弱冰冷，空洞可怜，它们身上既没有奇迹，也没有魔法。”",
          "type": "dialogue"
        },
        {
          "sourceId": "6915055",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但你却让这一切变的有意义。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915056",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "所以你的存在本身，就是比珠宝和文物还要珍贵的奇迹。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915057",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "这样令人着迷的奇迹，我想我愿意花费时间……很多很多的时间。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915058",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "孜孜不倦地在你身上仔细探寻。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915059",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "现在抬头看吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915060",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "然后告诉我，你看到了什么？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915063",
              "text": "空空荡荡的……天花板？"
            },
            {
              "targetId": "6915062",
              "text": "不想把眼睛从你身上拿开。"
            }
          ],
          "sourceId": "6915061",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915062",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "油嘴滑舌的人可是要被打屁股的哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915063",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "天花板上安装了一台3D全息投影装置，是趁你不在时，我偷派人设下的陷阱。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915064",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我藏在装修师宽松的上衣口袋里，装修完毕之后，我跳上桌子，将控制开启和关闭影像的遥控器放在了闹钟里。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915065",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "时间回到昨天中午，当闹钟的时分秒针一齐指向12点时，指针会因为遥控的阻挡再也无法前进。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915066",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "而这时，全息投影的开关就会因为触发而被打开。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915067",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "指针所指的方向……就恰巧是投影装置的正下方。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915068",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "所以……你不想要打开投影的开关看看吗，究竟会发生什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915069",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "就安装在你的头顶哟，稍微站起来，只用一只手就够得到了。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915071",
              "text": "伸手打开开关。"
            }
          ],
          "sourceId": "6915070",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915071",
          "sourceType": 9,
          "text": "按下开关的瞬间，光束从天花板遥射而下。回头看时，桌上已空无一物。",
          "type": "narration"
        },
        {
          "sourceId": "6915072",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "于是，大变活人的戏法就这样完成了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915073",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但其实，也未尝不是一个漏洞百出，兼具风险的尝试。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915074",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "不信的话，把开关关掉再试试吗？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915076",
              "text": "将手从投影的开关挪走。"
            }
          ],
          "sourceId": "6915075",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915076",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "Hi，♠|101|♠|103|，又见面了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915077",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "其实从头到尾，我都没有离开桌面一步喔。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915078",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "因为全息投影的效果，即使站在桌子上，用眼睛看起来，也像突然消失了一样。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915079",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "在此之前，我录制了长达一分钟的警报声，就为了在那一刻响起。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915080",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "巨大的警报声会盖过你跟手办的彼此呼喊。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915081",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "而这个时候，只要在窗外播放你的求救声，她们就会无暇思考，冲出房间了。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915083",
              "text": "窗外早已设好了悬空的纸箱？"
            }
          ],
          "sourceId": "6915082",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915083",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "答对了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915084",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "一系列的组合，看起来就像是以某种不可思议的方式将你凭空从房间关在窗外悬空的箱子里。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915085",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "箱内装满五颜六色的气球，在视野的盲区被牵引着缓慢飞行，从地上看，根本无从察觉。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915086",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "这已经足够让担心你的手办们追上好一阵了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915087",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "本来以为计划到这里就要完美谢幕呢，因为我只需耐心等待物流车的到来便可万事大吉，因为我，马上就要独占你了呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915088",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "车上运输的是由你指定签收的快件，有兴趣的话猜猜看，里面装有什么东西？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915090",
              "text": "里面……装着你？"
            }
          ],
          "sourceId": "6915089",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915090",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，你的脑袋里还真是装满了不可理喻、天马行空的想象呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915091",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但谁让我们偏偏同样疯狂？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915092",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "物流运送的是一架特制的保险柜，开启柜门的密码是你的生日，里面大概装了……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915093",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "捧花礼宾炮香槟红酒杯礼服鲜花水晶灯烛台蛋糕。\n这里再省略一千个字吧。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915095",
              "text": "´･◡･`"
            }
          ],
          "sourceId": "6915094",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915095",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "如果可以的话，还想塞个司仪进去呢，你们人类，不就喜欢这些东西吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915096",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "当快递员轻轻扣响你的门，我作为背后神秘的寄件人便华丽而优雅的倒在他身后的箱子上。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915097",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "当他收好你签订的快递单扭头离开时，只会大声惊呼“咦！从哪里多出的玩具？”",
          "type": "dialogue"
        },
        {
          "sourceId": "6915098",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "原谅他吧，不管是被称作玩具抑或是手办都不再重要了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915099",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "因为那个时候，我跟箱子已经被你取走。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915100",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "啊，该是一场多么完美的魔术呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915101",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "所以好想问问你这家伙，究竟犯了什么伤天害理的大案。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915102",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "竟然把那位糟糕的“警探大人”引来身边。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915103",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "害得我的魔术不得不一变再变，险些，你就要看不到我了。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915104",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "不过那又是一段很长的故事了，有兴趣听吗？改天再讲给你吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915105",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "说吧，打算怎么赔我？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915107",
              "text": "赔……你？"
            }
          ],
          "sourceId": "6915106",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915107",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "对呀，因为你可是险些坏掉人家计划的大元凶呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915108",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "这样吧，签章画印，等我想到了再来找你，你说好不好？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915109",
          "sourceType": 9,
          "text": "转瞬之间，一张薄薄的纸飞舞过你的鼻尖，嘴唇，最后轻轻印在你措手不及，还未收放的食指上。",
          "type": "narration"
        },
        {
          "sourceId": "6915110",
          "sourceType": 9,
          "text": "一个鲜红的手印出现在纸张的右下角。",
          "type": "narration"
        },
        {
          "sourceId": "6915111",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "这副惊魂未定的表情，我还没打算吃掉你呀。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915113",
              "text": "红手印？！是什么时候？"
            }
          ],
          "sourceId": "6915112",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915113",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "哎呀哎呀，忘记说明了，我在3D投影装置的开关上涂抹了一些印章泥。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915114",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "用手触碰开关的话，指头上理所应当会粘上印泥了不是吗？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915116",
              "text": "太狡猾了！"
            }
          ],
          "sourceId": "6915115",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915116",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "但是这一下，可更加糟糕了呀。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915117",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "我的意思是，那个开关非常、十分灵敏。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915118",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "那些印泥一点点脱落的话，可能会导致开关重启，因此会投影出一些很可怕、很奇怪的东西哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915119",
          "sourceType": 9,
          "text": "她话音刚落，缓缓而温柔的光柱从天花板再一次流泻而下，音乐也随之从设备中响起。",
          "type": "narration"
        },
        {
          "sourceId": "6915120",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "Wedding March\n《仲夏夜之梦》五幕前奏曲，门德尔松。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915121",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "保险柜里的捧花礼宾炮蛋糕香槟本该现在登场的，但是拜糟糕的“警探大人”所赐，只能委屈你一下了喔。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915122",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "喂，不会嫌弃的吧？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915124",
              "text": "这个……那个……"
            }
          ],
          "sourceId": "6915123",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915124",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，看不出你还真是个品头论足、充满挑剔的家伙呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915125",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "不过因祸得福，虽然梦幻的现场没了，但我们也多了几位关在保险箱里的司仪哦。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "6915127",
              "text": "她们都平安无事吗？优纪，我的手办们。"
            }
          ],
          "sourceId": "6915126",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "6915127",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "当然了，你的东西我仔细疼爱还来不及呢，毕竟，她可是特别定制的，最珍贵的钥匙呀。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915128",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "有那位糟糕的“警探大人”在的话，她们很快就会回来了吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915129",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "不知道为什么，我现在突然又想看看那封誓约书呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915130",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "喔，上面的情诗真是迷人。喂，你要不要读给我听？",
          "type": "dialogue"
        },
        {
          "sourceId": "6915131",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "主人！主人！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915132",
          "sourceType": 5,
          "speaker": "岩田和江",
          "text": "灯光……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915133",
          "sourceType": 5,
          "speaker": "花迦",
          "text": "还有音乐！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915134",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "犯规！太犯规了吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915135",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "你的手上，你的手上拿着什么东西！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915136",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "快给我！优纪也要签！优纪也要签！",
          "type": "dialogue"
        },
        {
          "sourceId": "6915137",
          "sourceType": 9,
          "text": "于是气球充盈而起，于是人影飞快攒动，于是月光温柔洒下……",
          "type": "narration"
        },
        {
          "sourceId": "6915138",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "啊，有了司仪，这下子总算完美了呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915139",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "誓约书可是大人和大人之间才能签订的哦，小朋友禁止早恋。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915140",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "我才不是小孩子。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915141",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "唔……誓约书上还残留某人指尖的香味。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915142",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "那么……",
          "type": "dialogue"
        },
        {
          "sourceId": "6915143",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "晚安好梦，诸位，以及亲爱的“警探大人”。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915144",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "没有告别一声不响的离开，像是那家伙的作风呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915145",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "那家伙大概永远也不会明白，一生的浪漫，应该从一场告别开始。",
          "type": "dialogue"
        },
        {
          "sourceId": "6915146",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "♠|101|♠|103|，还期望能在月色温柔下，再次相会。到时候我会找你打牌哦！",
          "type": "dialogue"
        }
      ],
