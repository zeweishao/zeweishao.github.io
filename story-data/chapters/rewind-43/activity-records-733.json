      "blocks": [
        {
          "text": "「我怀疑你和本市目前一起恶性案件有关。」",
          "title": "燃烧的时计",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "M城爆炸案"
    },
    {
      "blocks": [
        {
          "text": "「根据心理侧写，连环爆炸案的凶手有非常强的表现欲，他享受制造爆炸。」",
          "title": "燃烧的时计",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "无声的计时"
    },
    {
      "blocks": [
        {
          "text": "「啊！最最最喜欢在那一瞬间爆发出的刺眼光芒了！」",
          "title": "燃烧的时计",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "燃烧的乐园"
    },
    {
      "blocks": [
        {
          "text": "「就让天空被我染成粉红色吧！」",
          "title": "燃烧的时计",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "灼眼的夜空"
    },
    {
      "blocks": [
        {
          "text": "突然消失在街角的咖啡店。",
          "title": "乐园的余烬\t",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "无人的咖啡厅"
    },
    {
      "blocks": [
        {
          "text": "二十二张纸牌，交给命运安排。",
          "title": "乐园的余烬\t",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "消失的占卜屋"
    },
    {
      "blocks": [
        {
          "text": "加速超越却甩不掉伤悲。",
