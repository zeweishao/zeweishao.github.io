            39417014,
            39417015,
            39417016,
            39417017,
            39417018
          ],
          "sectionId": 39417
        }
      ],
      "title": "未尽篇章·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "39418001",
          "sourceType": 0,
          "speaker": "居民甲",
          "text": "这位就是传说中的伊迪丝大人吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "39418002",
          "sourceType": 0,
          "speaker": "居民乙",
          "text": "欢迎您，伊迪丝大人，请接受我们的敬意。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418003",
          "sourceType": 0,
          "speaker": "居民丙",
          "text": "还愣着干什么，赶紧把地方收拾一下，好好招待伊迪丝大人。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418004",
          "sourceType": 0,
          "speaker": "女孩",
          "text": "看吧，大姐姐，大家见到你果然很开心呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "39418005",
          "sourceType": 0,
          "speaker": "居民甲",
          "text": "丫头叫谁大姐姐呢，不得无礼。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418006",
          "sourceType": 0,
          "speaker": "女孩",
          "text": "略，大姐姐可是我的好朋友，才不会介意这个呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418007",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "在「奥古斯都」本不该有身份之别，这一直是我努力的方向，没想到竟然在这个地方实现了。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418008",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "所以，这就是你一直以来背着我偷偷做的事吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "39418009",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "主人，我很抱歉，请原谅我的不告而别。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418010",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "旧贵族们早已盯上了这里，伯爵那边一直在给这里的居民施加压力，我无法坐视不管，他们都是……我的亲人。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418011",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "我知道，一直都知道，你从未遗忘自己的故乡。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418012",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "居住在这里的每一位手办，才是你心目中的「繁星」。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418013",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "没错，「奥古斯都」的任何事都逃不过主人的眼睛。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418014",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "我们虽然关于「繁星」的见解达成了一致，但很显然，你仍对我有所隐瞒。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418015",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "这次与旧贵族谈判会上的暴动，我之所以能够全身而退，也是因为你在背后帮我，对吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "39418016",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "那些围堵「奥古斯都」的暴民，反而救了我一命，也是你安排的吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "39418017",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "我曾发誓会协助您完成宏伟的志向，保护您的人身安全，是我应该做的。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418018",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "这一次你错了，罗威。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418019",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "「理想」是强者凭借理智和手腕一步步兑现的诺言，而一味的牺牲只能成为他人的垫脚石。",
          "type": "dialogue"
        },
        {
          "sourceId": "39418020",
          "sourceType": 0,
          "speaker": "伊迪丝",
          "text": "我的身边不需要默默无闻的牺牲者，需要的是强而有力的「同盟」。",
          "type": "dialogue"
        }
      ],
      "id": "detail-964",
      "sourceRefs": [
        {
          "bundle": "guanjia",
          "rowIds": [
            39418001,
