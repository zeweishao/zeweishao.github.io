            39403021
          ],
          "sectionId": 39403
        }
      ],
      "title": "那个执事·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "39404001",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "顺着这条小路一直往前走，很快就能抵达「奥古斯都」西城。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404002",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "守卫不久后就会察觉，随时可能追过来。你走吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404003",
          "sourceType": 0,
          "speaker": "刺客",
          "text": "真是稀奇，你竟然会放了我。你不怕你的主人发现了以后把你赶出去么？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404004",
          "sourceType": 0,
          "speaker": "刺客",
          "text": "还是说，你早就有了异心，只是你那自负的主人却不知道。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404005",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "「奥古斯都」的贵族们阶级森严，你今天的所作所为，会给西城的民众惹来不必要的麻烦。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404006",
          "sourceType": 0,
          "speaker": "罗威·伯恩斯",
          "text": "其他的事，我不会再多做解释。告辞。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404007",
          "sourceType": 0,
          "speaker": "刺客",
          "text": "哎，你——",
          "type": "dialogue"
        },
        {
          "sourceId": "39404008",
          "sourceType": 0,
          "speaker": "旁白",
          "text": "罗威转身步入黑暗，身影逐渐消失。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404009",
          "sourceType": 0,
          "speaker": "刺客",
          "text": "啧，这家伙究竟算是哪边的？真让人摸不着头脑。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404010",
          "sourceType": 0,
          "speaker": "刺客",
          "text": "我说老板们，我这算是完成你们交代的任务了吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404011",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "呵呵呵，你完成得很出色，会得到应得的奖励哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404012",
          "sourceType": 0,
          "speaker": "神秘的身影",
          "text": "你确定罗威这个人可以利用？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404013",
          "sourceType": 0,
          "speaker": "神秘的身影",
          "text": "他可是「奥古斯都」名流圈炙手可热的管家，无数贵族私下想要挖角，他都没有离开过伊迪丝。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404014",
          "sourceType": 0,
          "speaker": "神秘的身影",
          "text": "所以，你又凭什么觉得他会接受你的条件？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404015",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "小伯爵，你还年轻，还不够了解人心。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404016",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "没有人在我的面前可以隐藏自己的灵魂，从来没有。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404017",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "那美丽又易碎的灵魂，只需要轻轻地一推，它们就会如水晶一般碎裂。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404018",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "你不觉得越是看起来完美的人，破碎起来就越是……美好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404019",
          "sourceType": 0,
          "speaker": "神秘的身影",
          "text": "……这就是你想要的？",
          "type": "dialogue"
        },
        {
          "sourceId": "39404020",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "呵，我想看到高贵的人在我的面前失却尊严，哭泣、呐喊、尖叫，跪下来向我求饶。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404021",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "啊，只是想一想，就忍不住有些兴奋呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "39404022",
          "sourceType": 0,
          "speaker": "神秘的身影",
          "text": "虽然无法理解，但若是能从内部瓦解「奥古斯都」，我们的目标的确是一致的。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404023",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "那么，合作愉快哦，伯爵大人。",
          "type": "dialogue"
        },
        {
          "sourceId": "39404024",
          "sourceType": 0,
          "speaker": "克罗赛尔",
          "text": "接下来，让我们借一步说话，详细谈谈「那个计划」吧。",
          "type": "dialogue"
        }
      ],
      "id": "detail-950",
      "sourceRefs": [
        {
          "bundle": "guanjia",
