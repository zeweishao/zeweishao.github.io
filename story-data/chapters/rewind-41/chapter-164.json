            36001017,
            36001018,
            36001019,
            36001020,
            36001021,
            36001022,
            36001023
          ],
          "sectionId": 36001
        },
        {
          "bundle": "xingluo",
          "rowIds": [
            36030001,
            36030002,
            36030003
          ],
          "sectionId": 36030
        }
      ],
      "title": "星空猎人·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "36002001",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "放心，管理局会把她安置好的。\n但消息走漏……我们只能尽量努力。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002002",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "这是第十个……根据伤势判断，她们都是在半小时内遭到了攻击……\n敌人很棘手。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002003",
          "sourceType": 0,
          "speaker": "仓田龙马",
          "text": "不错，她确实很棘手。\n没有取胜，是我的过失。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002004",
          "sourceType": 0,
          "speaker": "凛",
          "text": "……连你也会失手。发生了什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "36002005",
          "sourceType": 0,
          "speaker": "仓田龙马",
          "text": "你已经跟了我一路。现身吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002006",
          "sourceType": 0,
          "speaker": "？？",
          "text": "星洛被发现了！又是会说话的老虎，真奇怪！你也不能吃吗？\n嗯…但好不好吃，总得试试！",
          "type": "dialogue"
        },
        {
          "sourceId": "36002007",
          "sourceType": 3,
          "text": "一段时间后……",
          "type": "narration"
        },
        {
          "sourceId": "36002008",
          "sourceType": 0,
          "speaker": "仓田龙马",
          "text": "是个武道的好苗子，值得栽培。\n但抱歉，我们不是一个等级。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002009",
          "sourceType": 0,
          "speaker": "？？",
          "text": "呜……好厉害……星洛不想和你打了！\n贝尔先生说过，要是遇到打不过的猎物，就要——跑！",
          "type": "dialogue"
        },
        {
          "sourceId": "36002010",
          "sourceType": 0,
          "speaker": "仓田龙马",
          "text": "……速度很快，就像野兽一样，但却失去了冷静。",
          "type": "dialogue"
        },
        {
          "sourceId": "36002011",
          "sourceType": 3,
          "text": "对手逃跑的一瞬，龙马用难以察觉的速度从对手身上拿走了一叠图纸。",
          "type": "narration"
        },
        {
          "sourceId": "36204001",
          "sourceType": 0,
          "speaker": "仓田龙马",
          "text": "方才一战，我有所感悟，要闭关思索。\n这个给你们，剩下的就有劳了。",
          "type": "dialogue"
        },
        {
          "sourceId": "36204002",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "……虽然是线索，但这些抽象符号的含义很难理解。",
          "type": "dialogue"
        },
        {
          "sourceId": "36204003",
          "sourceType": 0,
          "speaker": "凛",
          "text": "会有人看懂它的。比如——|101|。",
          "type": "dialogue"
        },
        {
          "sourceId": "36204004",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "不好啦！奖品仓库也遭到袭击了！快跟我来！",
          "type": "dialogue"
        },
        {
          "sourceId": "36204005",
          "sourceType": 2,
          "speaker": "神宫有咲",
          "text": "嘻嘻~居然有这种事。\n如果能靠犯人搅局，我就能设计一个精彩的恶作剧了。",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "36204006",
          "sourceType": 2,
          "speaker": "神宫有咲",
          "text": "能在这么大的活动上展现恶作剧的艺术，想想就刺激。\n现在，就先去拿一些材料吧~",
          "tone": "thought",
          "type": "dialogue"
        }
      ],
      "id": "detail-848",
      "sourceRefs": [
        {
          "bundle": "xingluo",
          "rowIds": [
            36002001,
            36002002,
            36002003,
            36002004,
            36002005,
            36002006,
            36002007,
            36002008,
            36002009,
            36002010,
            36002011
          ],
          "sectionId": 36002
        },
        {
          "bundle": "xingluo",
          "rowIds": [
            36204001,
            36204002,
            36204003,
            36204004,
            36204005,
            36204006
          ],
          "sectionId": 36204
        }
      ],
      "title": "星空猎人·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "36003001",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "家督大人，等等我，您走得太快了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36003002",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Sorry，辛苦你了。会场那边急着等我们救场呢。\n对了，到那里记得叫我Rap god。",
          "type": "dialogue"
        },
        {
          "sourceId": "36003003",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "嗯……那边怎么有个little girl？\nWake up，你怎么睡在这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "36003004",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哎呀~怎么到这个时候了，星洛只想小小地睡一会而已。\n都怪刚才那只会说话的老虎！",
          "type": "dialogue"
        },
        {
          "sourceId": "36003005",
          "sourceType": 7,
          "text": "星洛 · 星之圣枪\n商品名称：星洛·星之圣枪Ver.\n作品出处：《永恒的异界幻想》\n制造商：TENMA 天马\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约221mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "36003006",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Interesting，但你还是快离开这里吧。\n附近有bad guy，很危险。",
          "type": "dialogue"
        },
        {
          "sourceId": "36003007",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "我先去会场，你就先把这个小女孩送到安全的地方吧。\nGood luck。",
          "type": "dialogue"
        },
        {
          "sourceId": "36003008",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "啊？那我又得多跑一趟……家督，哦不是，Rap god，我能不能——",
          "type": "dialogue"
        },
        {
          "sourceId": "36003009",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "呀！又是一头会说话的野兽！\n不知道，你能不能吃呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "36003010",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Take easy，这不是野兽，他和你一样是手办。\n……Wait，难道说你就是那个袭击——",
          "type": "dialogue"
        },
        {
          "sourceId": "36003011",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哎呀！星洛不想那么多啦！吃饱肚子是猎人的第一目标！\n好不好吃，总得试试！",
          "type": "dialogue"
        }
      ],
      "id": "detail-849",
      "sourceRefs": [
        {
          "bundle": "xingluo",
          "rowIds": [
            36003001,
            36003002,
            36003003,
            36003004,
            36003005,
            36003006,
            36003007,
            36003008,
            36003009,
            36003010,
            36003011
          ],
          "sectionId": 36003
        }
      ],
      "title": "星空猎人·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "36004001",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "So，事情就是这样……会场还需要我的rap，救人的事就拜托你们了。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004002",
          "sourceType": 0,
          "speaker": "凛",
          "text": "你现在需要的是休息。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004003",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "没关系，我的练习时长已经超过三年半了，这点小伤并不会影响我的show。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004004",
          "sourceType": 0,
          "speaker": "萝贝卡",
          "text": "诶，真的让他一个人离开吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "36004005",
          "sourceType": 0,
          "speaker": "凛",
          "text": "做好自己的事，就是对彼此最大的帮助。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004006",
          "sourceType": 9,
          "text": ">>>即将以全息投影还原模拟现场。",
          "type": "narration"
        },
        {
          "sourceId": "36004007",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "从速度、力量、破坏程度来分析，犯人确实有可能是那个女孩。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004008",
          "sourceType": 0,
          "speaker": "凛",
          "text": "但这里的痕迹却很可疑。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004009",
          "sourceType": 0,
          "speaker": "希塔",
          "text": "咬痕和爪印？一个人型手办，不会留下这样的痕迹。除非——",
          "type": "dialogue"
        },
        {
          "sourceId": "36004010",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "先放点孜然，再放点辣椒，然后，然后……\n嘿嘿，星洛特制的烤肉调料就做好了！",
          "type": "dialogue"
        },
        {
          "sourceId": "36004011",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "你，你究竟是谁，你到底想做什么！呜哇，别过来！",
          "type": "dialogue"
        },
        {
          "sourceId": "36004012",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哎呀~别叫啦，如果食材的状态太紧张，是会影响口感的！\n星洛才不要吃干巴巴的肉呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004013",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "你疯了吗？手办是不能吃的！就算把我烤了也没用啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004014",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "手办？是什么？嗯……\n之前会说话的动物好像也提到过，你们都是不能吃的对手吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "36004015",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "你连手办都不知道？！你是从哪里来的？\n你自己也是手办啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "36004016",
          "sourceType": 3,
          "text": "一段时间后……",
          "type": "narration"
        },
        {
          "sourceId": "36004017",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "……就是这样。\n总之趁着事情还没闹大，你赶紧去管理局自首吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004018",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哎呀，星洛还是没有听懂啦！\n不过，既然你不能吃……那就把你放了吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "36004019",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "可惜星洛连烤肉调料都做好了……\n这么香的调料……太可惜了……",
          "type": "dialogue"
        },
        {
          "sourceId": "36004020",
          "sourceType": 0,
          "speaker": "粮丸",
          "text": "喵呜~喵！",
          "type": "dialogue"
        },
        {
          "sourceId": "36004021",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "糟了糟了！是那只大猫！它肯定是被你的调料吸引来的！\n快跑！手办是打不过它的！",
          "type": "dialogue"
        },
        {
          "sourceId": "36004022",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哼！你先逃吧。星空猎人才不会不战而退呢！\n大猫，星洛的午饭，就是你了！",
          "type": "dialogue"
        }
      ],
      "id": "detail-850",
      "sourceRefs": [
        {
          "bundle": "xingluo",
          "rowIds": [
            36004001,
            36004002,
            36004003,
            36004004,
            36004005,
            36004006,
            36004007,
            36004008,
            36004009,
            36004010,
            36004011,
            36004012,
            36004013,
            36004014,
            36004015,
            36004016,
            36004017,
            36004018,
            36004019,
            36004020,
            36004021,
            36004022
          ],
          "sectionId": 36004
        }
      ],
      "title": "星空猎人·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "36005001",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "呜……星洛大意了……\n可恶的大猫！快把星洛放下来！星洛才不要被吃掉呢！",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "36005003",
              "text": "什么声音？粮丸？"
            },
            {
              "targetId": "36005003",
              "text": "陌生的手办？"
            }
          ],
          "sourceId": "36005002",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "36005003",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "是巨人？！呜……吃烤肉的人，也会变成别人的食物，这是原野的法则。但星洛不怕！来吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "36005004",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "我不是巨人，也不会吃掉你。",
          "type": "dialogue"
        },
        {
          "sourceId": "36005005",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "你不是巨人？但你比星洛大这么多……\n难道星洛真的变成了「手办」，你才是……人类？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "36005007",
              "text": "你还不熟悉这里。"
            },
            {
              "targetId": "36005007",
              "text": "有话可以慢慢说。"
            }
          ],
          "sourceId": "36005006",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "36005007",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "星洛之前一直生活在荒野上。但某天醒来，星洛就发现自己来到了这里……然后……",
          "type": "dialogue"
        },
        {
          "sourceId": "36005008",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "|101|，我来检查留在这的材料了。\n没有好好保管的话，可是会有惩罚哦~",
          "type": "dialogue"
        },
        {
          "sourceId": "36005009",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "小声些，别吵醒她。",
          "type": "dialogue"
        },
        {
          "sourceId": "36005010",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "……哼，原来是有新的「朋友」啊。\n偷偷在外面认识新的女孩子，真是过分呢。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "36005012",
              "text": "我去买点东西。"
            },
            {
              "targetId": "36005012",
              "text": "帮我照顾一下她。"
            }
          ],
          "sourceId": "36005011",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "36005012",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "哼，这次就算了，再有下次，我会做很过分的事哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "36005013",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "呜哇~星洛睡了一个好觉！咦，|101|去哪里了？\n星洛的故事还没说完呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "36005014",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "嗯……有其他人的气味。是谁，为什么要偷偷潜入|101|的家！看招！",
          "type": "dialogue"
        },
        {
          "sourceId": "36005015",
          "sourceType": 0,
          "speaker": "神宫有咲",
          "text": "嘻，真有趣，明明是我先来的，居然还敢打我。\n看来，得让你吃点苦头呢。",
          "type": "dialogue"
        }
      ],
