{
  "bookId": "archive-p3_luning",
  "id": "section-28518",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "28518001",
          "sourceType": 9,
          "text": "啪！啪！啪！",
          "type": "narration"
        },
        {
          "sourceId": "28518002",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "你在做什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "28518003",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "……没什么，电视机好像有点失灵了。",
          "type": "dialogue"
        },
        {
          "sourceId": "28518004",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "你那样拍可能会把它拍坏的，闪开让我来吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "28518005",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "哦……",
          "type": "dialogue"
        },
        {
          "sourceId": "28518006",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "喝呀——！",
          "type": "dialogue"
        },
        {
          "sourceId": "28518007",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "喂喂！那么用力踢的话……修好了？！",
          "type": "dialogue"
        },
        {
          "sourceId": "28518008",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "常盘台中学秘传，奶奶式斜角四十五度打击机器修理法！",
          "type": "dialogue"
        },
        {
          "sourceId": "28518009",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "好帅……原来这招不是只能修自动贩卖机啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "28518010",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "……帅吗？我还以为你会觉得这样做很粗鲁呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "28518011",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "不会啊，超帅的！包括飞踢时不经意间露出的安全裤也是！",
          "type": "dialogue"
        },
        {
          "sourceId": "28518012",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "喂，你在看哪里啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "28518013",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "不好意思，因为太过显眼了。\n总之以后就多关照了~",
          "type": "dialogue"
        },
        {
          "sourceId": "28518014",
          "sourceType": 0,
          "speaker": "御坂美琴",
          "text": "哼！",
          "type": "dialogue"
        }
      ],
