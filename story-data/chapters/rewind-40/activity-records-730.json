  "sections": [
    {
      "blocks": [
        {
          "text": "小鱼干、猫薄荷、毛线球是诱捕一只猫咪的好办法。",
          "title": "绝咪档案",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "猫的习性"
    },
    {
      "blocks": [
        {
          "text": "「异乎寻常的动物，与死者的对话，实为面具的脸庞。」",
          "title": "绝咪档案",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "猫的天敌"
    },
    {
      "blocks": [
        {
          "text": "误会解开，哈莉却遭遇了绑架，而凶手的要求竟然是……",
          "title": "绝咪档案",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "猫的主人"
    },
    {
      "blocks": [
        {
          "text": "「驶向梦的境界，超越人类记忆的彼岸。」",
          "title": "绝咪档案",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "猫的新家"
    },
    {
      "blocks": [
        {
          "text": "「就这点杂鱼实力也敢欺负猫，真了不起喵~」",
          "title": "捕鼠行动",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "猫步轻悄"
    },
    {
      "blocks": [
        {
          "text": "「呵呵，你们是想一起去地下陪她吗？」",
          "title": "捕鼠行动",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "杀机暗藏"
    },
    {
      "blocks": [
        {
          "text": "「来尝尝猫爪子的厉害喵！」",
          "title": "捕鼠行动",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "步步紧逼"
    },
    {
      "blocks": [
        {
          "text": "「午夜一过，药水就会失效。」",
          "title": "捕鼠行动",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "大快朵颐"
    }
  ],
