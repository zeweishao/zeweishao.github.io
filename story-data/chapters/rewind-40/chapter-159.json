{
  "bookId": "rewind-40",
  "id": "chapter-159",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "35501001",
          "sourceType": 3,
          "text": "叮铛——唰啦——铃铃铃——",
          "type": "narration"
        },
        {
          "sourceId": "35501002",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "米娅莫拉苏娜丹妮……急急如律令！我看到了……那是一片绝望的黑暗。",
          "type": "dialogue"
        },
        {
          "sourceId": "35501003",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "你在找寻的也正在找寻你；你想要的同样也想要找到你。",
          "type": "dialogue"
        },
        {
          "sourceId": "35501004",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "呼！这个新学的咒语消耗了我太多力量，如果客人需要更详细的解释得另外加钱哦~",
          "type": "dialogue"
        },
        {
          "sourceId": "35501005",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "骗猫的吧，明明就只是闭着眼睛随便念了几段咒语而已?",
          "type": "dialogue"
        },
        {
          "sourceId": "35501006",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "我问的是尤菲在哪，这个占卜结果说了等于白说。",
          "type": "dialogue"
        },
        {
          "sourceId": "35501007",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "你、你、你居然敢质疑我的占卜！你会被困在绝望的黑暗之中，那是危险的预告！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501008",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "下次骗人的时候记得把眼睛睁开，那就不会是一片黑暗了。拜拜——",
          "type": "dialogue"
        },
        {
          "sourceId": "35501009",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "喂，站住！你还没给钱呢！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501010",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "嘻嘻，你要的不也在身边吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "35501011",
          "sourceType": 0,
          "speaker": "桑尼第二人格",
          "text": "什么！居然敢用鱼骨头付账！你会有报应的！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501012",
          "sourceType": 0,
          "speaker": "狂霸虎",
          "text": "桀桀桀，没想到吧，你也有今天！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501013",
          "sourceType": 0,
          "speaker": "绿斩仙",
          "text": "那种被你玩弄于股掌间的屈辱……我记忆犹新。今天我们就要报复回来！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501014",
          "sourceType": 0,
          "speaker": "熊傲天",
          "text": "你叫吧，叫得再大声也不会有人来救你的。这可是特制的笼子！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501015",
          "sourceType": 0,
          "speaker": "猫",
          "text": "喵——！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501016",
          "sourceType": 0,
          "speaker": "狂霸虎",
          "text": "这一天我已经等得太久了！二弟，三弟，你们上，把它的爪子统统磨平！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501017",
          "sourceType": 3,
          "text": "啪，啪，啪——",
          "type": "narration"
        },
        {
          "sourceId": "35501018",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "鼓掌鼓掌，你们嘴里的特制笼子就是纸箱和胶带还有——阿嚏，讨厌的猫薄荷！",
          "type": "dialogue"
        },
        {
          "sourceId": "35501019",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "就这点杂鱼实力也敢欺负猫，真了不起喵~",
          "type": "dialogue"
        },
        {
          "sourceId": "35501020",
          "sourceType": 3,
          "text": "咻咻咻——嘭！",
          "type": "narration"
        },
        {
          "sourceId": "35501021",
          "sourceType": 0,
          "speaker": "狂霸虎",
          "text": "你是谁？居然敢把我们准备的东西烧了！兄弟们给她点颜色看看——",
          "type": "dialogue"
        },
        {
          "sourceId": "35501022",
          "sourceType": 0,
          "speaker": "奇怪的猫耳少女",
          "text": "米菲亚是世界上最厉害最可爱的猫，喵~",
          "type": "dialogue"
        },
        {
          "sourceId": "35501023",
          "sourceType": 7,
          "text": "米菲亚 · 炸弹猫咪\n商品名称：米菲亚·炸弹猫咪Ver.\n作品出处：《少女X机关枪》\n制造商：LET'S RED 猩潮\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约214mm",
          "title": "角色介绍卡",
          "type": "profile"
        }
      ],
      "id": "detail-827",
      "sourceRefs": [
        {
          "bundle": "2023mifia",
          "rowIds": [
            35501001,
            35501002,
            35501003,
            35501004,
            35501005,
