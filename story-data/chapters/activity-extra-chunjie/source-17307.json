{
  "bookId": "activity-extra-chunjie",
  "id": "source-17307",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "17307001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "今天竟然就是假期的最后一天了呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "17307002",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "总觉得这个世界好像哪里出了问题，对时间进行了改动，总觉得假期的日子……过的特别快。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307003",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "工作之后，主人能够呆在家里的时间就要变少了啊，真是可恶。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307004",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "如果可以的话~我也想要假期再长一些啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307005",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "彩音也是这样想的，要是可以天天和主人玩游戏就好了。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "下一个长假，什么时候才能到来呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307007",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "啧。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307008",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "要是世界上的人都像是你们一样懒散，那么这个世界就该完蛋了。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307009",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "唔唔！这个声音！",
          "type": "dialogue"
        },
        {
          "sourceId": "17307010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这样强的气场……是……",
          "type": "dialogue"
        },
        {
          "sourceId": "17307011",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "……",
          "type": "dialogue"
        },
        {
          "sourceId": "17307012",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "看来你们又浪费了一个原本应该充实自己的假期。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307013",
          "sourceType": 7,
          "text": "夏澄阳子 · 逐日之心\n商品名称：夏澄阳子·辉煌年代Ver.\n作品名称：《格斗学园》\n制造商：GALATEA 伽拉\n手办材质：ABS&PVC 涂装完成\n手办规格：1/7比例模型·附专用底座・全高约238mm",
          "title": "角色介绍卡",
          "type": "profile"
        },
        {
          "sourceId": "17307014",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "阳……阳子大姐头。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307015",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "既然是新的一年到来，那么过往的一年都应该变换成不一样的面貌，像你们这样悠闲懒散可不行。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307016",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "要是在新年开始的时候，就抱着得过且过的想法，那么接下来的一年时间，可是会被你们虚度浪费的。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307017",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "所以！都给我好好打起精神来，先从保证身体健康开始，跑起来吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "17307018",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "既然精神振作不起来的话，就让身体先苏醒，从现在开始，我会好好监督你们，让你们新的一年积极向前！",
          "type": "dialogue"
        },
        {
          "sourceId": "17307019",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "哦！！",
          "type": "dialogue"
        },
        {
          "sourceId": "17307020",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊啊啊，主人好像要坏掉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307021",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "救命啊！！",
          "type": "dialogue"
        },
        {
          "sourceId": "17307022",
          "sourceType": 0,
          "speaker": "绯野原爱",
          "text": "为什么我这样的淑女要做这样的事情。",
          "type": "dialogue"
        },
        {
          "sourceId": "17307023",
          "sourceType": 0,
          "speaker": "阳子·辉煌年代",
          "text": "才第一圈而已，给我继续，停下来的话，姐姐可是会给你们惩罚的！",
          "type": "dialogue"
        }
      ],
