{
  "bookId": "rewind-42",
  "id": "activity-records-732",
  "sections": [
    {
      "blocks": [
        {
          "text": "观之不足由他缱，便赏遍了十二亭台是枉然。",
          "title": "闲情偶寄",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "古韵"
    },
    {
      "blocks": [
        {
          "text": "三唱三叹儿时去，一曲别离又相遇。",
          "title": "闲情偶寄",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "新声"
    },
    {
      "blocks": [
        {
          "text": "一尺水袖甩出嗔怒哀怨，一个大幕掩映天上人间。",
          "title": "闲情偶寄",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "戏痴"
    },
    {
      "blocks": [
        {
          "text": "汇千古忠孝节义，成一时离合悲欢。",
          "title": "闲情偶寄",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "知音"
    },
    {
      "blocks": [
        {
          "text": "听一出戏，前世今生。",
          "title": "曲艺风雅",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "翩然心动"
    },
    {
      "blocks": [
        {
          "text": "诸君漫说登场好，曲部风流斗巧妆。",
          "title": "曲艺风雅",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "仙山求药"
    },
    {
      "blocks": [
        {
          "text": "一段花腔婉转的唱词，一篇死别生离的曲艺。",
          "title": "曲艺风雅",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "水漫金山"
    },
    {
      "blocks": [
        {
          "text": "人生如戏，戏如人生，万般悲喜，尽在不言中。",
          "title": "曲艺风雅",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "雷峰夕照"
    }
  ],
