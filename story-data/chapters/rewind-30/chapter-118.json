            30020016
          ],
          "sectionId": 30020
        },
        {
          "bundle": "sweethome",
          "rowIds": [
            30021001,
            30021002
          ],
          "sectionId": 30021
        }
      ],
      "title": "始作俑者·Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "30022001",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "好了，下一位请到我这里来接受「管理局」的登记。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022002",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "都麻利一点，别想着逃跑，我的子弹可不长眼！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022003",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "哈莉，你这样讲话会把他们都吓跑的。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022004",
          "sourceType": 0,
          "speaker": "流浪手办甲",
          "text": "又是「管理局」啊，我还是躲远点吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "30022005",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "想从我哈莉的眼皮底下逃走？嘿嘿，你的胆子可不小啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022006",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "虽然答应了主人要先做完登记工作，但他们那边的情况我有些不放心，我们真的不用去看看吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "30022007",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "当然要去，我可比谁都想早点找到车贤秀和他单挑呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022008",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "那边怎么这么吵，不会是那些流浪手办在闹事吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022009",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "听起来似乎是战斗的声音，我们过去看看。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "最好不是流浪手办在闹事，不然又要耽误我们不少时间了。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022011",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "那些流浪手办即使闹事也是小打小闹，还从没有到眼前这样的级别。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022012",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "我有种似曾相识的感觉，总觉得在哪见过类似的战斗方式……",
          "type": "dialogue"
        },
        {
          "sourceId": "30022013",
          "sourceType": 5,
          "speaker": "异化车贤秀",
          "text": "呃……啊啊啊啊啊啊——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022014",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "真是太美丽了，残暴又野蛮，只有末世才能开出这么绚丽的花朵。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022015",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "一切都很完美，就等最后的变异到来，那样主人就会……",
          "type": "dialogue"
        },
        {
          "sourceId": "30022016",
          "sourceType": 3,
          "text": "哈莉用手雷对准洛瑞丝扔了过去，炸碎了她的美梦——",
          "type": "narration"
        },
        {
          "sourceId": "30022017",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "什么人胆敢袭击我？！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022018",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "竟然是你，哈莉，别来无恙，你的队友们还好吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "30022019",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "你还敢提她们，你忘了是怎么欺骗她们的吗，你这个狡猾的家伙。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022020",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "我们不过都是为了各自的主子，只要能赢，谈何欺骗呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022021",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "你这次又想打什么坏注意，警告你，我不会让你得逞的！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022022",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "真是可惜，我还想多和你这位老朋友叙叙旧呢……如果你能「友好」一点的话。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022023",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "哈莉，暮间猫和车贤秀的情况很不好，赶快后退！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022024",
          "sourceType": 5,
          "speaker": "异化车贤秀",
          "text": "呃啊啊……啊啊啊啊啊——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022025",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "他已经完全失去神智了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "30022026",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "偏偏选在这种时候，我完全没办法专心跟这家伙单挑啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022027",
          "sourceType": 5,
          "speaker": "暮间猫",
          "text": "贤秀！——车贤秀——！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022028",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "哈莉，你在发什么愣，快躲开！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022029",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "干嘛对我大喊大叫的，我知道——啊呀！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022030",
          "sourceType": 0,
          "speaker": "花迦",
          "text": "哈莉，不要……不要啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022031",
          "sourceType": 0,
          "speaker": "洛瑞丝",
          "text": "再见了，我的老朋友，我们的叙旧到此为止吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "30022032",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "车贤秀！你已经严重到无法分清谁是谁了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "30022033",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "在我修复他身上的瑕疵之前，大家一定要坚持住！",
          "type": "dialogue"
        },
        {
          "sourceId": "30022034",
          "sourceType": 5,
          "speaker": "异化车贤秀",
          "text": "呃啊啊啊！！！——",
          "type": "dialogue"
        }
      ],
      "id": "detail-638",
      "sourceRefs": [
