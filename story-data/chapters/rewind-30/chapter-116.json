      "title": "地下探险·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "30011001",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "这里就是地下水箱了么？",
          "type": "dialogue"
        },
        {
          "sourceId": "30011002",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "新来者的闯入者，劝你速速离开，否则——",
          "type": "dialogue"
        },
        {
          "sourceId": "30011003",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "等待你的只有死路一条！",
          "type": "dialogue"
        },
        {
          "sourceId": "30011004",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "好大的口气，那要看你有没有这个实力了。",
          "type": "dialogue"
        },
        {
          "sourceId": "30011005",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "……原来是你，被病毒感染的「车贤秀」，我的主人候你多时了。",
          "type": "dialogue"
        },
        {
          "sourceId": "30011006",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "你的主人是谁？到处散播谣言的就是他么？",
          "type": "dialogue"
        },
        {
          "sourceId": "30011007",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "你的问题太多了，无论你愿不愿意，今天都别想离开！",
          "type": "dialogue"
        },
        {
          "sourceId": "30011008",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "这么急躁的门差我还是第一次见，不过正好我也赶时间。",
          "type": "dialogue"
        },
        {
          "sourceId": "30011009",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "既然你不肯回答我的问题，那就只好由我亲自找到答案了。",
          "type": "dialogue"
        },
        {
          "sourceId": "30011010",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "我会让你知道什么是「恐怖」，你将无路可逃！",
          "type": "dialogue"
        },
        {
          "sourceId": "30011011",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "放肆的家伙！让我来好好教训你！",
          "type": "dialogue"
        },
        {
          "sourceId": "30012001",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "哈啊……哈啊…….",
          "type": "dialogue"
        },
        {
          "sourceId": "30012002",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "咳咳……你到底……这不可能……",
          "type": "dialogue"
        },
        {
          "sourceId": "30012003",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "再问你最后一次，背后指使你的究竟是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "30012004",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "想知道么……呵呵……咳咳……我偏不告诉你……",
          "type": "dialogue"
        },
        {
          "sourceId": "30012005",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "真是顽固不化，那我就勉为其难地了结你吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "30012006",
          "sourceType": 0,
          "speaker": "地下门差",
          "text": "怪、怪物……你这家伙果然是怪物！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "30012007",
          "sourceType": 0,
          "speaker": "怪异的车贤秀",
          "text": "随便你怎么想，我是怪物那又如何，哈哈哈哈！",
          "type": "dialogue"
        },
        {
          "sourceId": "30012008",
          "sourceType": 3,
          "text": "看守地下水箱的门差被打倒，原本紧闭的门轰然大开——",
          "type": "narration"
        },
        {
          "sourceId": "30012009",
          "sourceType": 2,
          "speaker": "怪异的车贤秀",
          "text": "这扇门的后面会有我想知道的真相么？",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "30012010",
          "sourceType": 2,
          "speaker": "怪异的车贤秀",
          "text": "身体上的怪物化症状越来越严重，可恶，就要没时间了……",
          "tone": "thought",
          "type": "dialogue"
        }
      ],
