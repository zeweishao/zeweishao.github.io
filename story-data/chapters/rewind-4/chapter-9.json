      "title": "#2 下定决心"
    },
    {
      "blocks": [
        {
          "sourceId": "709001",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "抓住你了~",
          "type": "dialogue"
        },
        {
          "sourceId": "709002",
          "sourceType": 0,
          "speaker": "真恋",
          "text": "放、放开我……",
          "type": "dialogue"
        },
        {
          "sourceId": "709003",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "别挣扎了，你逃不掉的哦，我的真恋小甜心。",
          "type": "dialogue"
        },
        {
          "sourceId": "709004",
          "sourceType": 5,
          "speaker": "优纪",
          "text": "放开真恋，你这个大坏蛋！",
          "type": "dialogue"
        },
        {
          "sourceId": "709005",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "这么美味的猎物，我怎么忍心放开呢？不如，你也跟我们一起来，怎么样？",
          "type": "dialogue"
        },
        {
          "sourceId": "709006",
          "sourceType": 0,
          "speaker": "岩田和江",
          "text": "休想用你的脏手碰她！",
          "type": "dialogue"
        },
        {
          "sourceId": "709007",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "你很在意这个黄头发的小姑娘？那我就不客气了，呵呵呵呵呵……",
          "type": "dialogue"
        },
        {
          "sourceId": "709008",
          "sourceType": 0,
          "speaker": "真恋",
          "text": "优纪、和江，谢谢你们，认识你们真好……",
          "type": "dialogue"
        },
        {
          "sourceId": "709009",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "呜呜呜，真恋，不要走……",
          "type": "dialogue"
        },
        {
          "sourceId": "709010",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "真是难看呢，这就是分别的哀伤吗，我的真恋？",
          "type": "dialogue"
        },
        {
          "sourceId": "709011",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "你和她们才刚刚认识，就如此地依依不舍，令我感到十分惊讶呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "709012",
          "sourceType": 5,
          "speaker": "狩猎者",
          "text": "不过真恋你也未免太看得起自己了，跟她比，你简直无足轻重——这个黄毛丫头，可是「阿撒兹勒」大人需要之人。",
          "type": "dialogue"
        },
        {
          "sourceId": "709013",
          "sourceType": 0,
          "speaker": "真恋",
          "text": "…………",
          "type": "dialogue"
        },
        {
          "sourceId": "709014",
          "sourceType": 5,
          "speaker": "苍岚",
          "text": "放开她！",
          "type": "dialogue"
        },
        {
          "sourceId": "709015",
          "sourceType": 0,
          "speaker": "狩猎者",
          "text": "你是谁？",
          "type": "dialogue"
        },
        {
          "sourceId": "709016",
          "sourceType": 5,
          "speaker": "苍岚",
          "text": "我苍岚，审判之剑·苍之意志·帝国荣耀守护者·屠龙者·永恒的公主殿下的仆从，誓死守护公主殿下！",
          "type": "dialogue"
        },
        {
          "sourceId": "709017",
          "sourceType": 5,
          "speaker": "苍岚",
          "text": "只要我活着，绝不允许任何胆敢冒犯公主殿下的无礼之辈！受死吧！",
          "type": "dialogue"
        }
      ],
      "id": "detail-82",
