      "title": "#5 为你而战"
    },
    {
      "blocks": [
        {
          "sourceId": "2201001",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "还差多少？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201002",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "三颗。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201003",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "管理局的尾巴呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201004",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "甩掉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201005",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "剩下的能量石……有线索么？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201006",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "正在找。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201007",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "你还真是无趣啊，除了工作，脑袋里不会有其他事情吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201008",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "要吃糖吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201009",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "谢谢，今天就不必了……我不想因为抽到红色被你暴打一顿。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201010",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "「安」，「阿尼塔」，「艾瑞尔」……「阿祖娜」。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201011",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "……没有「阿撒兹勒」。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201012",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "怎么了，你看上去很苦恼。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201013",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "你相信吗，一个登记在册的亡故之人，怎么会一丁点痕迹都没有留下，没有编号，没有居所，没有照片……甚至，连性别都是不详。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201014",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "阿……撒兹勒？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201015",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "不知道出自哪部作品，这个名字，你有印象吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "2201016",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "「阿撒兹勒」，希伯来语中的「神之强者」，充满堕落意味的名字，是代罪羔羊的恶魔化意象。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201017",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "一般来说，按照故事中的发展，或许这个名字本身，就是一个替罪的代号。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201018",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "呵，可笑，无论他是谁，都不要妄图从我手中逃过罪罚。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201019",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "喏，看，狐狸的尾巴，虽然只是一条干巴巴的到访记录——",
          "type": "dialogue"
        },
        {
          "sourceId": "2201020",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "登记入册前，这位「阿撒兹勒」来过M城，留下了一条入城记录，至于出城……唔，没有，真是有趣。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201021",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "或许他从未离开，一直蛰伏在我们身边。",
          "type": "dialogue"
        },
        {
          "sourceId": "2201022",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "能与手办对话的特别人类，来到M城的「水城结奈」，还有疑似「天启」首领的 「阿撒兹勒」……M城究竟藏着什么秘密，我可不信世上有这么多巧合。",
          "type": "dialogue"
        }
      ],
