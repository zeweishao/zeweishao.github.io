      ],
      "title": "#6 剑的诺言"
    },
    {
      "blocks": [
        {
          "sourceId": "2218001",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "累死了，整座M城都要跑遍了，为什么还是没有最后一颗能量石的下落！",
          "type": "dialogue"
        },
        {
          "sourceId": "2218002",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "一定是阿撒勒兹在偷懒的缘故吧，不努力的家伙……",
          "type": "dialogue"
        },
        {
          "sourceId": "2218003",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "去威胁他。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218004",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "好主意，唔，又到了门口呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "2218005",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "阿撒兹勒，出来。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218006",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "……又是你们。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218007",
          "sourceType": 0,
          "speaker": "神秘人-花鸟原",
          "text": "能量石呢，不想保住秘密了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "2218008",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "情报搜集需要时间，毕竟两位大人全力搜索，结局同样是一无所获。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218009",
          "sourceType": 0,
          "speaker": "水城结奈",
          "text": "强词夺理。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218010",
          "sourceType": 0,
          "speaker": "阿撒兹勒",
          "text": "如果有新的发现，会立刻通知两位大人。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218011",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "果然……果然是这样，呵，真令人意外。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218012",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "怎么了，你看起来状态很糟糕。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218013",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "嘘——隔墙有耳，跟我来。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218014",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "……究竟是……",
          "type": "dialogue"
        },
        {
          "sourceId": "2218015",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "「阿撒兹勒」还活着！",
          "type": "dialogue"
        },
        {
          "sourceId": "2218016",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "什么？！",
          "type": "dialogue"
        },
        {
          "sourceId": "2218017",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "千真万确，你看这里……「阿撒兹勒」，的确还活着。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218018",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "但修改信息、抹除痕迹……可不是那么轻易的事。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218019",
          "sourceType": 0,
          "speaker": "海伦",
          "text": "你的意思是……",
          "type": "dialogue"
        },
        {
          "sourceId": "2218020",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "管理局里出了内鬼。",
          "type": "dialogue"
        },
        {
          "sourceId": "2218021",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "「阿撒兹勒」，一直都在注视我们。",
          "type": "dialogue"
        }
      ],
