        }
      ],
      "title": "#5 冷彻的火焰"
    },
    {
      "blocks": [
        {
          "sourceId": "2206001",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "全面检索，关键词，「阿撒兹勒」。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206002",
          "sourceType": 3,
          "text": "检索中，请稍后——",
          "type": "narration"
        },
        {
          "sourceId": "2206003",
          "sourceType": 3,
          "text": "检索结果，空。",
          "type": "narration"
        },
        {
          "sourceId": "2206004",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "该死，靠不住的电子产品……咳咳咳咳，还有堆了十年的积灰旧档案，他们就不知道雇人打扫吗……咳咳……",
          "type": "dialogue"
        },
        {
          "sourceId": "2206005",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "……嗯？这是什么……《管理局试炼记录》。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206006",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "说起来，上一位试炼通过者的诞生，已经是十年前了吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "2206007",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "十年……",
          "type": "dialogue"
        },
        {
          "sourceId": "2206008",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "「阿撒兹勒」的死亡时间，也是十年前……",
          "type": "dialogue"
        },
        {
          "sourceId": "2206009",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "自「阿撒兹勒」死亡，就再无人能通过管理局的试炼，这其中一定存在什么联系。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206010",
          "sourceType": 0,
          "speaker": "明智光秀",
          "text": "世间偶然，皆为必然。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206011",
          "sourceType": 0,
          "speaker": "赵云",
          "text": "所以一块石头被偷，就会有另一块失踪？嗯？阿尔弗雷德先生，你怎么在这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "2206012",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "来找海伦的？她出去了。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206013",
          "sourceType": 0,
          "speaker": "明智光秀",
          "text": "组长有留言，她什么时候回来吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "2206014",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "我怎么知道，别烦我。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206015",
          "sourceType": 0,
          "speaker": "赵云",
          "text": "既然如此，那我们就先告辞了。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206016",
          "sourceType": 0,
          "speaker": "阿尔弗雷德",
          "text": "只能先继续去找下一个能量石了，走吧，少将军。",
          "type": "dialogue"
        },
        {
          "sourceId": "2206017",
          "sourceType": 0,
          "speaker": "明智光秀",
          "text": "我对狗找骨头的工作不感兴趣。",
          "type": "dialogue"
        }
      ],
