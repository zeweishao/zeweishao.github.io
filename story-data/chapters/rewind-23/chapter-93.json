            22203019
          ],
          "sectionId": 22203
        }
      ],
      "title": "#4 消失回忆"
    },
    {
      "blocks": [
        {
          "sourceId": "22204001",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "（怎么回事……头好重……身体也……）",
          "type": "dialogue"
        },
        {
          "sourceId": "22204002",
          "sourceType": 3,
          "text": "喂，「|101|」怎么啦？(#`O′)",
          "type": "narration"
        },
        {
          "sourceId": "22204003",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "病人刚刚苏醒，显然需要静养。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204004",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "我看「|102|」需要认清现实，好好清醒一下。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204005",
          "sourceType": 0,
          "speaker": "泉",
          "text": "突然间失去三个心爱的手办，出现「选择性失忆」或者用昏迷来逃避现实——这也不难理解。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204006",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "你们怎么证明被唤醒的是吾的专属人类，\n而不是什么反应迟钝的笨蛋「魂穿」过来？",
          "type": "dialogue"
        },
        {
          "sourceId": "22204007",
          "sourceType": 0,
          "speaker": "艾伦兹·珀尔",
          "text": "——最近流行的小说不都这么写吗，「魂穿」什么的，用失忆做借口，其实根本不是同一个人。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204008",
          "sourceType": 0,
          "speaker": "泉",
          "text": "唔，丰富的想象力~",
          "type": "dialogue"
        },
        {
          "sourceId": "22204009",
          "sourceType": 0,
          "speaker": "桑尼",
          "text": "……桑尼的咒语才不会出这种差错。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204010",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "喂喂，谁能解释一下！",
          "type": "dialogue"
        },
        {
          "sourceId": "22204011",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "为什么主人一回家就变成了这样？！\n优纪花迦和江她们去哪了，为什么一晚上都没回家！",
          "type": "dialogue"
        },
        {
          "sourceId": "22204012",
          "sourceType": 0,
          "speaker": "小红",
          "text": "附议！强烈附议！！！\n这些家伙为什么出现在我家！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22204013",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "依我看，不如用提问的方式，来验明「|101|」的身份。",
          "type": "dialogue"
        },
        {
          "sourceId": "22204014",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "嘿，「|101|」，现在需要你认真回答几个问题——能听到我说话吗？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204016",
              "text": "我记得，你是那个侦探。"
            }
          ],
          "sourceId": "22204015",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204016",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "谢谢，很荣幸。\n那么，「|101|」，你记得自己昨天去了哪里吗？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204018",
              "text": "我去了……「废弃工厂」？"
            }
          ],
          "sourceId": "22204017",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204018",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "没错，那么你是为了什么到哪里去呢？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204020",
              "text": "我去找……优纪她们有危险！"
            }
          ],
          "sourceId": "22204019",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204020",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "很好，再想想，后来你遇到了什么人？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204022",
              "text": "阿尔弗雷德……我们吵了一架。"
            }
          ],
          "sourceId": "22204021",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204022",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "发生争执的原因呢，你还记得吗？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204024",
              "text": "优纪，和江，花迦……她们失踪了。"
            }
          ],
          "sourceId": "22204023",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204024",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "后来呢？",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204026",
              "text": "她们……失踪了！！！"
            }
          ],
          "sourceId": "22204025",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204026",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "什么？！！什么失踪了？！！",
          "type": "dialogue"
        },
        {
          "sourceId": "22204027",
          "sourceType": 0,
          "speaker": "小红",
          "text": "意思是，家里再也没有优纪、花迦跟和江了吗？！",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "22204029",
              "text": "我记得……我要带她们回家！"
            }
          ],
          "sourceId": "22204028",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "22204029",
          "sourceType": 0,
          "speaker": "桑尼第三人格",
          "text": "等等——你还没有完全弄明白发生了什么。",
          "type": "dialogue"
        }
      ],
      "id": "detail-254",
      "sourceRefs": [
        {
          "bundle": "disanshiwuzhang",
          "rowIds": [
            22204001,
            22204002,
            22204003,
