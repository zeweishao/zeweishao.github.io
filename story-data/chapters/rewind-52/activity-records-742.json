{
  "bookId": "rewind-52",
  "id": "activity-records-742",
  "sections": [
    {
      "blocks": [
        {
          "text": "太好了，植物们的专属翻译官来啦。",
          "title": "属于生命的舞台",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "花庭呓语时"
    },
    {
      "blocks": [
        {
          "text": "我们所在的世界，便是最华丽的舞台。",
          "title": "属于生命的舞台",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "生灵全跳舞"
    },
    {
      "blocks": [
        {
          "text": "人鱼的梦中是泪水和回不去的故乡。",
          "title": "属于生命的舞台",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "人鱼酣梦中"
    },
    {
      "blocks": [
        {
          "text": "下一次的月落，我们会再次相遇。",
          "title": "属于生命的舞台",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "邂逅于落月"
    },
    {
      "blocks": [
        {
          "text": "一处宁静树荫，一段美梦填满的安眠。",
          "title": "我们于此长存",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "欺骗者之梦"
    },
    {
      "blocks": [
        {
          "text": "我们身上鲜花绕环，与大地紧紧相连。",
          "title": "我们于此长存",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "传信者之琴"
    },
    {
      "blocks": [
        {
          "text": "那里人迹罕至，如若羔羊迷途。",
          "title": "我们于此长存",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "牧羊人之歌"
    },
    {
      "blocks": [
        {
          "text": "你可来到这里，无数次与我们相见。",
          "title": "我们于此长存",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "驾车人之冠"
    }
  ],
