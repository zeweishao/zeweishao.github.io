            32203009,
            32203010,
            32203011,
            32203012
          ],
          "sectionId": 32203
        }
      ],
      "title": "#3 会面结束"
    },
    {
      "blocks": [
        {
          "sourceId": "32204001",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "你所说的的「地毯式搜寻」，就是没头苍蝇一样到处乱撞？",
          "type": "dialogue"
        },
        {
          "sourceId": "32204002",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "最简单直接的方法，往往最有效果。\n鼓足气势从街头冲到街尾，把整个街区扫荡个遍！",
          "type": "dialogue"
        },
        {
          "sourceId": "32204003",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "喂，你小子在干什么！\n收收你的光，闪得我眼睛都睁不开了。",
          "type": "dialogue"
        },
        {
          "sourceId": "32204004",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "阳光会增加阴影的面积，在此之下，任何尘埃都无所遁形。",
          "type": "dialogue"
        },
        {
          "sourceId": "32204005",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "发现了吗，就在刚才，手办的身影连同地上被拉长的影子一起，一闪而过。",
          "type": "dialogue"
        },
        {
          "sourceId": "32204006",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "......「马南家族」的洛瑞丝？\n她为什么会从N城跑来这里？",
          "type": "dialogue"
        },
        {
          "sourceId": "32204007",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "你拦住她，我来问话。",
          "type": "dialogue"
        },
        {
          "sourceId": "32204008",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "我们现在顾不上那些小杂鱼，先找克罗赛尔要紧。",
          "type": "dialogue"
        },
        {
          "sourceId": "32204009",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "躲藏在N城阴影之中的人，绝不能再次逃脱制裁。\n我见过她，那是在......",
          "type": "dialogue"
        },
        {
          "sourceId": "32204010",
          "sourceType": 0,
          "speaker": "卡缪",
          "text": "N城暴动开始的那一天。",
          "type": "dialogue"
        }
      ],
      "id": "detail-286",
      "sourceRefs": [
        {
          "bundle": "zhuxian38",
          "rowIds": [
            32204001,
            32204002,
            32204003,
            32204004,
            32204005,
            32204006,
            32204007,
            32204008,
            32204009,
            32204010
          ],
          "sectionId": 32204
        }
      ],
      "title": "#4 暗潮涌动"
    },
    {
      "blocks": [
        {
          "sourceId": "32205001",
          "sourceType": 0,
          "speaker": "孩子",
          "text": "为什么不相信我......\n我真的没有动，爆音鸡自己叫起来了！",
          "type": "dialogue"
        },
        {
          "sourceId": "32205002",
          "sourceType": 0,
          "speaker": "妈妈",
          "text": "那么，地上这些原味崽、机械兔，也全部是自己跑出来的吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "32205003",
          "sourceType": 0,
          "speaker": "孩子",
          "text": "我......我也不清楚怎么回事，大概是......「让玩具活过来」的生日愿望真的实现了吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "32205004",
          "sourceType": 0,
          "speaker": "妈妈",
          "text": "勇敢承认自己的错误，才是有担当的好孩子。\n首先，你要为刚才撒的谎向妈妈道歉。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205005",
          "sourceType": 0,
          "speaker": "孩子",
          "text": "妈妈，我......",
          "type": "dialogue"
        },
        {
          "sourceId": "32205006",
          "sourceType": 0,
          "speaker": "机械兔",
          "text": "叽叽，叽叽。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205007",
          "sourceType": 0,
          "speaker": "妈妈",
          "text": "怎么回事？机械兔......自己动了？开关，开关在哪里？",
          "type": "dialogue"
        },
        {
          "sourceId": "32205008",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "嘻嘻嘻！他没有说谎，现在轮到你道歉了，太太。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205009",
          "sourceType": 0,
          "speaker": "妈妈",
          "text": "啊——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "32205010",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "管理局规定，在人类面前必须时刻保持静止状态，不允许任意活动，违者监禁处罚。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205011",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "解释一下，这意味着你们将会面临几天的监禁。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205012",
          "sourceType": 0,
          "speaker": "机械兔",
          "text": "哼，愚昧的玩具，你注定无法跟上我们划时代的脚步。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205013",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "看来你们的脚步要暂时停下了，在管理局好好改造，争取早日重回自由身吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205014",
          "sourceType": 0,
          "speaker": "机械兔",
          "text": "自由......叽叽叽，找回属于我们的自由，才能重获新生！",
          "type": "dialogue"
        },
        {
          "sourceId": "32205015",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "你、你们要干什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "32205016",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "喔，自由与新生！喔，启示与真理！冲呀——",
          "type": "dialogue"
        },
        {
          "sourceId": "32205017",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "不，不太对劲......先回去汇报情况！\nN城管理局14街区请求支援！",
          "type": "dialogue"
        },
        {
          "sourceId": "32205018",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "支援部队？你们来得正好！\n我们在街头巷尾设立埋伏，等流窜的玩具一接近，就给他们来个背后突袭！",
          "type": "dialogue"
        },
        {
          "sourceId": "32205019",
          "sourceType": 0,
          "speaker": "管理局员工",
          "text": "怎么了？你们两个，为什么愣着不动？",
          "type": "dialogue"
        },
        {
          "sourceId": "32205020",
          "sourceType": 0,
          "speaker": "原味崽",
          "text": "自由......与新生，启示......与真理。",
          "type": "dialogue"
        },
        {
          "sourceId": "32205021",
          "sourceType": 0,
          "speaker": "咖啡崽",
          "text": "嘿嘿嘿，新的纪元......即将降临！",
          "type": "dialogue"
        }
      ],
      "id": "detail-287",
      "sourceRefs": [
        {
          "bundle": "zhuxian38",
