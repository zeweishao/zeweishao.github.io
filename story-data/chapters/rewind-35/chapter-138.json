      "title": "泳装对决·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "32514001",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "哈哈嘿吼~葵！打她，揍她，碾碎她！",
          "type": "dialogue"
        },
        {
          "sourceId": "32514002",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "哈莉比场上的选手还兴奋啊，为什么不直接报名呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "32514003",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "梅根队长不让哈莉报名，不然我肯定是冠军。小红，你说对不对？",
          "type": "dialogue"
        },
        {
          "sourceId": "32514004",
          "sourceType": 0,
          "speaker": "小红",
          "text": "啊对对对，别把枪口抵在我的脑袋上啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514005",
          "sourceType": 0,
          "speaker": "葵",
          "text": "……就稍微认真一点吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514006",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "军用格斗术追求最高效率的制敌，不会有任何多余的动作。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514007",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "虽然只是徒手格斗，也千万不能大意。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514008",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "看来有点棘手。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514009",
          "sourceType": 2,
          "speaker": "仓田真乃",
          "text": "她的爆发力好强！每个招式都像带着风……",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "32514010",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "漂亮！仓田选手躲过了葵选手的正拳，但是葵选手显然还有后续！",
          "type": "dialogue"
        },
        {
          "sourceId": "32514011",
          "sourceType": 5,
          "speaker": "仓田真乃",
          "text": "唔?！",
          "type": "dialogue"
        },
        {
          "sourceId": "32514012",
          "sourceType": 0,
          "speaker": "葵",
          "text": "抓到……你了。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514013",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "手臂被锁住了……居然是关节技？",
          "type": "dialogue"
        },
        {
          "sourceId": "32514014",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "去海边晒太阳有这么大的诱惑力吗？好久没看到葵这么认真了。",
          "type": "dialogue"
        },
        {
          "sourceId": "32514015",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "吼吼，扭她，扭她！",
          "type": "dialogue"
        },
        {
          "sourceId": "32514016",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "两人陷入焦灼！仓田选手右手被制，已经无法逃脱了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "32514017",
          "sourceType": 0,
          "speaker": "葵",
          "text": "好，就这样把她带倒！",
          "type": "dialogue"
        },
        {
          "sourceId": "32514018",
          "sourceType": 0,
          "speaker": "葵",
          "text": "什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "32514019",
          "sourceType": 5,
          "speaker": "柴可夫斯鸡",
          "text": "原地的后空翻！葵选手的锁技居然被破解了！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515001",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "呼……她好强。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515002",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "表面上懒洋洋的，但是动作都很凌厉，一不小心就会被击倒。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515003",
          "sourceType": 0,
          "speaker": "葵",
          "text": "首战就这么麻烦吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "32515004",
          "sourceType": 2,
          "speaker": "葵",
          "text": "不行了……到活动时限了……",
          "tone": "thought",
          "type": "dialogue"
        },
        {
          "sourceId": "32515005",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "啊，胜负已经分出来了。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515006",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "是吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "32515007",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "真乃的韧性很强，就像水一样——水是软硬兼备的。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515008",
          "sourceType": 0,
          "speaker": "绿子",
          "text": "如果拖入消耗战，她就会有很大的优势。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515009",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "诶，你是怎么了？",
          "type": "dialogue"
        },
        {
          "sourceId": "32515010",
          "sourceType": 5,
          "speaker": "柴可夫斯鸡",
          "text": "这是怎么回事？！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515011",
          "sourceType": 5,
          "speaker": "柴可夫斯鸡",
          "text": "葵选手她，她竟然在擂台上睡着了！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515012",
          "sourceType": 0,
          "speaker": "哈莉",
          "text": "可恶！明明全程压着对面打的！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515013",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "好了，她已经很努力啦。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515014",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "这样的情况……比赛确实无法再进行下去了。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515015",
          "sourceType": 5,
          "speaker": "柴可夫斯鸡",
          "text": "我宣布，葵选手弃权！恭喜仓田真乃选手进入下一轮！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515016",
          "sourceType": 3,
          "text": "没过多久，第二轮的对决便已打响。",
          "type": "narration"
        },
        {
          "sourceId": "32515017",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "哼哼，胆敢站上这个擂台，就说明你已经做好了与本王为敌的觉悟吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515018",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "接下来登场的，是来自磨坊堡的莉可选手。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515019",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "前缀是大魔王！",
          "type": "dialogue"
        },
        {
          "sourceId": "32515020",
          "sourceType": 0,
          "speaker": "柴可夫斯鸡",
          "text": "更正，是大魔王莉可选手。",
          "type": "dialogue"
        },
        {
          "sourceId": "32515021",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "魔、魔王？明明看上去年纪那么小……",
          "type": "dialogue"
        }
      ],
