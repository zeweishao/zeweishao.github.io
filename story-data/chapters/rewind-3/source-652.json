          "speaker": "奥菲利亚",
          "text": "——危险！葵！……",
          "type": "dialogue"
        },
        {
          "sourceId": "652002",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "啊！……",
          "type": "dialogue"
        },
        {
          "sourceId": "652003",
          "sourceType": 0,
          "speaker": "葵",
          "text": "…………",
          "type": "dialogue"
        },
        {
          "sourceId": "652004",
          "sourceType": 0,
          "speaker": "葵",
          "text": "你、你为什么……",
          "type": "dialogue"
        },
        {
          "sourceId": "652005",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "你没事……真是太好了……",
          "type": "dialogue"
        },
        {
          "sourceId": "652006",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "抱歉，我没有实现我们的约定……以后请你……请你好好保重……",
          "type": "dialogue"
        },
        {
          "sourceId": "652007",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "一定要找到一个很好的主人，幸福地生活在一起……",
          "type": "dialogue"
        },
        {
          "sourceId": "652008",
          "sourceType": 0,
          "speaker": "奥菲利亚",
          "text": "葵……再……再见……",
          "type": "dialogue"
        },
        {
          "sourceId": "652009",
          "sourceType": 0,
          "speaker": "葵",
          "text": "不、不要……奥菲利亚……",
          "type": "dialogue"
        }
      ],
