        },
        {
          "sourceId": "6998012",
          "sourceType": 10,
          "text": "直播结束啦，大家下次再见！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998013",
          "sourceType": 10,
          "text": "聊聊关于「手办」这件事",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998014",
          "sourceType": 10,
          "text": "#Kizuna AI：爱酱登录卡池啦！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998015",
          "sourceType": 10,
          "text": "一起来聊聊「幕后花絮」吧！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998016",
          "sourceType": 10,
          "text": "我做视频企划五周年啦！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998017",
          "sourceType": 10,
          "text": "制作成手办的虚拟艺人聚会！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998018",
          "sourceType": 10,
          "text": "网络抢修成功，大家久等了！",
          "title": "小节引文",
          "type": "narration"
        },
        {
          "sourceId": "6998019",
          "sourceType": 9,
          "text": "加速特效测试段落（层级在立绘层级之上），应用场景分：单人立绘和双人立绘两种。（正式场景动作还在做，先用黑屏）",
          "type": "narration"
        },
        {
          "sourceId": "6998020",
          "sourceType": 9,
          "text": "单人版立绘",
          "type": "narration"
        },
        {
          "sourceId": "6998021",
          "sourceType": 9,
          "text": "绊爱：欢迎这位像太阳一样闪耀的女孩！",
          "type": "narration"
        },
        {
          "sourceId": "6998022",
          "sourceType": 9,
          "text": "嗨多磨，我是绊爱",
          "type": "narration"
        },
        {
          "sourceId": "6998023",
          "sourceType": 9,
          "text": "绊爱：嗨多磨，我是绊爱",
          "type": "narration"
        },
        {
          "sourceId": "6998024",
          "sourceType": 9,
          "text": "绊爱：嗨多磨，我是绊爱",
          "type": "narration"
        },
        {
          "sourceId": "6998025",
          "sourceType": 10,
          "text": "直播结束啦，大家下次再见！",
          "title": "小节引文",
          "type": "narration"
        }
      ],
