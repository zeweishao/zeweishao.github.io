        {
          "sourceId": "1017001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这里就是后宅了啦。",
          "type": "dialogue"
        },
        {
          "sourceId": "1017002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "在主人的精心布置之下，很快就能变成手办们最喜欢的家。",
          "type": "dialogue"
        },
        {
          "sourceId": "1017003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "那么摆放手办用到的置物架，究竟要从哪里才能获得呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "1017004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "没错！就是家具城。",
          "type": "dialogue"
        },
        {
          "sourceId": "1017005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "一起来跟我看看吧~！",
          "type": "dialogue"
        }
      ],
