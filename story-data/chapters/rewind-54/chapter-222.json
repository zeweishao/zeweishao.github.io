            42726009,
            42726010,
            42726011
          ],
          "sectionId": 42726
        }
      ],
      "title": "登鬼船 · Ⅰ"
    },
    {
      "blocks": [
        {
          "sourceId": "42727001",
          "sourceType": 3,
          "text": "小船果真自动巡航起来——",
          "type": "narration"
        },
        {
          "sourceId": "42727002",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "总算如愿控制住了小船，我们何不即刻返程回岸？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727003",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "不急一时。水道的秘密，最好在这水道上解开，且让这艘船载着我们到这水道的尽头探上一探。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727004",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "怎么，宓妹可是发现了什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727005",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "听，前方水域隐约似有歌声传来。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727006",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "水上漂泊的灵魂啊，可曾找到心灵的慰藉。♪",
          "type": "dialogue"
        },
        {
          "sourceId": "42727007",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "如此动人又哀婉的乐音，听得人忍不住想要落泪。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727008",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "你是何人，为何会出现在此处？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727009",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "贝歌，一个抚慰受伤心灵的歌者，也是一尾永失家园的可怜人鱼。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727010",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "这里原本是我的临时居所，不知什么时候被改成了商用的运输水道。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727011",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "我无法忍受越来越嘈杂的环境，因此搬到这里来。没想到……这里反而比原来那个处所更加喧闹呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727012",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "可此地除了水流和鱼儿游动的声音，并未听到其他的杂音。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727013",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "呵，你在暗示什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727014",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "水的低语，藏着秘密的路径。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727015",
          "sourceType": 0,
          "speaker": "贝歌",
          "text": "我能告诉你们的，就这么多了。再会。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727016",
          "sourceType": 3,
          "text": "船舱之下传来窸窸窣窣的声响——",
          "type": "narration"
        },
        {
          "sourceId": "42727017",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "宓妹，你可听到什么奇怪的响动？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727018",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "这船舱之下定然藏着什么古怪。\n出来，否则就不客气了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727019",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "哈，有史以来最伟大的演员徕卡，准备好享受表演了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "42727020",
          "sourceType": 0,
          "speaker": "布鲁特",
          "text": "笨蛋徕卡，你抢了我的台词！",
          "type": "dialogue"
        },
        {
          "sourceId": "42727021",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "总算出来了，可把我憋坏了~唔唔唔，肚子好饿呀。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727022",
          "sourceType": 0,
          "speaker": "徕卡",
          "text": "我这里有一些速食涂料，喏，给你垫垫肚子吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727023",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "好呀好呀，等星洛吃饱饱了就有力气给大家烤肉啦，嘿嘿~",
          "type": "dialogue"
        },
        {
          "sourceId": "42727024",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "我劝你最好小心，最好不要吃来历不明的食物。",
          "type": "dialogue"
        },
        {
          "sourceId": "42727025",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "显而易见，这出戏变得越来越有趣了。",
          "type": "dialogue"
        }
      ],
      "id": "detail-1098",
      "sourceRefs": [
        {
          "bundle": "zhenji",
          "rowIds": [
            42727001,
            42727002,
