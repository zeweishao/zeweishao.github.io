            42732012,
            42732013
          ],
          "sectionId": 42732
        }
      ],
      "title": "陷囹圄 · Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "42733001",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "嗨呀，这里的迷宫怎么没完没了的，星洛要受不了啦！",
          "type": "dialogue"
        },
        {
          "sourceId": "42733002",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "水的流动性给了我灵感，我们可以利用水流避开这些陷阱。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733003",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "宓妹想是已有了新计划，快些告之给诸位吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733004",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "这断崖之下尚有一处溪流，若是沿着水流的路线行动，方可更好地避开沿途的这些障碍。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733005",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "像水草一样漂流出去吗？好呀好呀，星洛迫不及待想要试试看啦~",
          "type": "dialogue"
        },
        {
          "sourceId": "42733006",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "可我们的船因为摔下断崖，自动巡航系统已经坏掉了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733007",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "无碍。只需让船随着流水自然飘走，其他的按我说的做即可。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733008",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "不愧是你，总能第一时间在困境中找到新出路。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733009",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "诸位跟紧我，留意周围的环境变化，千万小心。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733010",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "哇哦，小船果然带我们轻飘飘地避过了岸上的那些障碍~",
          "type": "dialogue"
        },
        {
          "sourceId": "42733011",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "而且呐，不觉得我们这样颠来颠去的，就像跳舞一样有趣呢~",
          "type": "dialogue"
        },
        {
          "sourceId": "42733012",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "不可随意在船上蹦跳，会影响船头的行驶方向。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733013",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "水上漂流什么的太好玩啦，星洛已经停不下来咯~！",
          "type": "dialogue"
        },
        {
          "sourceId": "42733014",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "要是我把拍下来的视频传到网上，你绝对能成为网络红人——鬼畜区搞笑的那种。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733015",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "呵，看来我的计划一时半会是无法顺利执行下去了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42733016",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "偶尔发生这样的事也有趣得很，宓妹不这样认为吗？",
          "type": "dialogue"
        }
      ],
      "id": "detail-1104",
      "sourceRefs": [
        {
          "bundle": "zhenji",
          "rowIds": [
            42733001,
            42733002,
            42733003,
            42733004,
            42733005,
            42733006,
            42733007,
            42733008,
            42733009,
            42733010,
            42733011,
            42733012,
            42733013,
            42733014,
            42733015,
            42733016
          ],
          "sectionId": 42733
        }
      ],
      "title": "陷囹圄 · Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "42734001",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "宓妹且看，经过仔细的磨合，诸位的合作越发亲密无间了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734002",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "很好，看来我的计划定能妥当执行了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734003",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "唔，星洛以前独来独往惯了，从没像这样和大家一起冒险呢~有趣，真是太有趣啦~",
          "type": "dialogue"
        },
        {
          "sourceId": "42734004",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "这就是所谓「团队合作」的力量，这次一定能挖掘到震惊M城的特大新闻。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734005",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "地下水流危险，现在还不是说笑的时候。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734006",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "快看，前方似乎是一个旋涡，诸位当心。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734007",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "诸位合力往船的一侧靠拢，如此以来便可扭转船头的方向。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734008",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "按照我的指挥，准备，开始——",
          "type": "dialogue"
        },
        {
          "sourceId": "42734009",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "芜湖，水上漂流太刺激了！这是有史以来星洛经历过的最棒的冒险！",
          "type": "dialogue"
        },
        {
          "sourceId": "42734010",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "这样都能玩得这么尽兴，该说你头脑简单还是心思单纯好呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "42734011",
          "sourceType": 0,
          "speaker": "甄姬",
          "text": "很好，保持这样的势头，很快便能抵达终点。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734012",
          "sourceType": 0,
          "speaker": "星洛",
          "text": "星洛觉得呀，应该给我们的冒险团队起个酷炫的名字，比如「水道急速漂流大师」什么的~",
          "type": "dialogue"
        },
        {
          "sourceId": "42734013",
          "sourceType": 0,
          "speaker": "奥莉安娜",
          "text": "我拒绝，到时候写在新闻上被别人看到的话太羞耻了。",
          "type": "dialogue"
        },
        {
          "sourceId": "42734014",
          "sourceType": 0,
          "speaker": "蔡文姬",
          "text": "当心，现在还不是说笑的时候，快些赶路吧。",
          "type": "dialogue"
        }
      ],
      "id": "detail-1105",
      "sourceRefs": [
        {
          "bundle": "zhenji",
          "rowIds": [
            42734001,
            42734002,
