{
  "bookId": "rewind-54",
  "id": "activity-records-744",
  "sections": [
    {
      "blocks": [
        {
          "text": "春日盛会将临，邀约两三好友，与君同游。",
          "title": "浮长川而忘返",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "春日盛会"
    },
    {
      "blocks": [
        {
          "text": "与你在山水交融的洛川之畔，缓步徐徐而行。",
          "title": "浮长川而忘返",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "洛川徐行"
    },
    {
      "blocks": [
        {
          "text": "浩渺的烟波将天地融为一色，而你也如身处画中。",
          "title": "浮长川而忘返",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "烟波浩渺"
    },
    {
      "blocks": [
        {
          "text": "岁月像这东流的水一般一去不返，惟有你从始至终未曾改变。",
          "title": "浮长川而忘返",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "流水东去"
    },
    {
      "blocks": [
        {
          "text": "你是惊起而飞的雁。",
          "title": "思绵绵而增慕",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "蠃鱼"
    },
    {
      "blocks": [
        {
          "text": "亦是潜渊而动的游龙。",
          "title": "思绵绵而增慕",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "巴蛇"
    },
    {
      "blocks": [
        {
          "text": "芳华绝代，身姿绰约。",
          "title": "思绵绵而增慕",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "白鹿"
    },
    {
      "blocks": [
        {
          "text": "灿若桃华，冠绝辰星。",
          "title": "思绵绵而增慕",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "鲛人"
    }
  ],
