            25003007,
            25003008,
            25003009,
            25003010,
            25003011,
            25003012,
            25003013
          ],
          "sectionId": 25003
        }
      ],
      "title": "设局·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "25004001",
          "sourceType": 0,
          "speaker": "「天相星」",
          "text": "「七星古镜」失窃，「兑」字号细作孙尚香失踪，你们怎么看？",
          "type": "dialogue"
        },
        {
          "sourceId": "25004002",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "我亲自到现场搜查过，除了各位已知的情报，意外获得不少新线索。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004003",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "还请「七杀星」详细说明。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004004",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "诸位请看，这便是我带回来的「新线索」，是否觉得眼熟？",
          "type": "dialogue"
        },
        {
          "sourceId": "25004005",
          "sourceType": 0,
          "speaker": "「天璇星」",
          "text": "这件纹章的纹路……「七星阁」的卷宗记录过类似的图案。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004006",
          "sourceType": 0,
          "speaker": "「天权星」",
          "text": "这是「天启」的标志，此事若与「天启」有关就棘手了。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004007",
          "sourceType": 0,
          "speaker": "「天璇星」",
          "text": "现场还有其他的发现么，「七杀星」阁下？",
          "type": "dialogue"
        },
        {
          "sourceId": "25004008",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "经过我的仔细探查，没有在现场发现一丝打斗过的痕迹。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004009",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "……想必「七杀星」阁下早已有了结论。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004010",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "答案很明显——「兑」字号细作孙尚香暗中勾结「天启」，盗走了「七星古镜」。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004011",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "就阁下带回的证据以及现场的勘察结果，的确可得此结论。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004012",
          "sourceType": 0,
          "speaker": "「天璇星」",
          "text": "回想当初加入「七星阁」，孙尚香的各项成绩出类拔萃，打破了多年来的记录。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004013",
          "sourceType": 0,
          "speaker": "「天相星」",
          "text": "那恐怕都是精心谋划的骗局，真令人不寒而栗。",
          "type": "dialogue"
        },
        {
          "sourceId": "25004014",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "一个小小的内鬼而已，「七星阁」定会设法除去这个祸患。",
          "type": "dialogue"
        }
      ],
      "id": "detail-565",
      "sourceRefs": [
        {
          "bundle": "thebeauty",
          "rowIds": [
            25004001,
            25004002,
            25004003,
            25004004,
            25004005,
            25004006,
            25004007,
            25004008,
            25004009,
            25004010,
            25004011,
            25004012,
            25004013,
            25004014
          ],
          "sectionId": 25004
        }
      ],
      "title": "设局·Ⅳ"
    },
    {
      "blocks": [
        {
          "sourceId": "25005001",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "仅凭只言片语就决定一个人的生死，你们会不会太过分了些？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005002",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "未经允许怎可擅自闯入「议事堂」！",
          "type": "dialogue"
        },
        {
          "sourceId": "25005003",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "你到这里来做什么？这里不是你该来的地方。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005004",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "我来是为伸冤，没有什么地方比这里更合适的了。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005005",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "那么，你有何冤要伸？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005006",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "我并非是为了自己，而是要为不惜个人安危、敢冒风险执行任务却不慎失踪、身处危机的「兑」字号细作孙尚香。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005007",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "你二人平时总是针锋相对，为什么想到要替她伸冤？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005008",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "我只是不能容忍没有证据就抹杀掉一个人，这有违「七星阁」历来所标榜的仁义作风。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005009",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "可适才「七杀星」所给出的现场情报显示，孙尚香的确有很大的嫌疑，这又该如何解释？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005010",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "你曾到过现场亲自探查过吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005011",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "事发至今，我从未离开「七星阁」半步。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005012",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "即使这样，你还是相信了别人的一面之词。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005013",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "「七杀星」并非一面之词，我没理由不信。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005014",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "想不到先生居然把自己所教授的东西全都抛到了九霄云外。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005015",
          "sourceType": 0,
          "speaker": "貂蝉",
          "text": "如此也好，我便没有什么理由再留在这「七星阁」了。\n各位，我们好聚好散，后会无期。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005016",
          "sourceType": 0,
          "speaker": "「天璇星」",
          "text": "「天枢星」两名得意的部下一个做了内鬼，一个做了叛徒，你就没有什么想说的吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005017",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "瑜疏于管教，无话可说。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005018",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "按「七星阁」的律法，部下之错，上级需得承受加倍处罚。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005019",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "规矩永远都是规矩，这一点瑜十分清楚。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005020",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "但在接受惩罚之前，针对当下「七星阁」所面临的困局，瑜有一番计策，不知诸位可有兴趣？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005021",
          "sourceType": 0,
          "speaker": "「天相星」",
          "text": "周先生足智多谋，愿闻其详。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005022",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "其一，孙尚香所护送的那面古镜，乃是赝品。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005023",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "……此话当真？",
          "type": "dialogue"
        },
        {
          "sourceId": "25005024",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "不错，那面镜子本就是我察觉出有内鬼而亲手设的一个局。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005025",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "其二，真正的「七星古镜」我已亲手交给助手吕布，由他护送到周某的人类朋友|101|身边。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005026",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "当今之际，没有比放在人类的身边更加安全的地方了。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005027",
          "sourceType": 0,
          "speaker": "「七杀星」",
          "text": "先生果真神机妙算。",
          "type": "dialogue"
        },
        {
          "sourceId": "25005028",
          "sourceType": 0,
          "speaker": "「天枢星」",
          "text": "不敢当，不过是为「七星阁」略尽绵薄之力。",
          "type": "dialogue"
        }
      ],
