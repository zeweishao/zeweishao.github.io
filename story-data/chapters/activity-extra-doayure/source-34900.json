{
  "bookId": "activity-extra-doayure",
  "id": "source-34900",
  "sections": [
    {
      "blocks": [
        {
          "sourceId": "34900001",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "大家好，欢迎来到特别的手办街头采访节目~",
          "type": "dialogue"
        },
        {
          "sourceId": "34900002",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "这里是最最最喜欢主人的主持人优纪哦！",
          "type": "dialogue"
        },
        {
          "sourceId": "34900003",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "我是用机械眼进行录像的摄影师蒂娅。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900004",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊哈哈哈，倒也不用解释——本期采访的主题是「假期想要做什么」！",
          "type": "dialogue"
        },
        {
          "sourceId": "34900005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "现在让我们随机挑选一位路人进行采访吧~",
          "type": "dialogue"
        },
        {
          "sourceId": "34900006",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "你好，请问可以接受采访吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "34900007",
          "sourceType": 0,
          "speaker": "水手服少女",
          "text": "嗯，可以的哦。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "请问你在假期里想要做什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "34900009",
          "sourceType": 0,
          "speaker": "水手服少女",
          "text": "那当然是在家里打游戏啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900010",
          "sourceType": 0,
          "speaker": "水手服少女",
          "text": "在难得的假期，要把攒下来的游戏全部，痛痛快快地通关才行！",
          "type": "dialogue"
        },
        {
          "sourceId": "34900011",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊，是游戏爱好者。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900012",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "喜欢的游戏类型是什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "34900013",
          "sourceType": 0,
          "speaker": "水手服少女",
          "text": "剑与魔法的RPG！当然，格斗游戏我也非常喜欢~",
          "type": "dialogue"
        },
        {
          "sourceId": "34900014",
          "sourceType": 0,
          "speaker": "水手服少女",
          "text": "我挺享受在街机上蹂躏我家的笨蛋老哥呢，毕竟他只会一个劲地用「打击技」。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900015",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "喔，感受到了浓厚的兄妹情呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900016",
          "sourceType": 0,
          "speaker": "疑似极道少女",
          "text": "喂喂，又是「格斗」，又是「蹂躏」的，你们在聊什么？",
          "type": "dialogue"
        },
        {
          "sourceId": "34900017",
          "sourceType": 0,
          "speaker": "疑似极道少女",
          "text": "假期想干的事情吗……",
          "type": "dialogue"
        },
        {
          "sourceId": "34900018",
          "sourceType": 0,
          "speaker": "疑似极道少女",
          "text": "那当然是锻炼了！",
          "type": "dialogue"
        },
        {
          "sourceId": "34900019",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "相当的自律呢……",
          "type": "dialogue"
        },
        {
          "sourceId": "34900020",
          "sourceType": 0,
          "speaker": "疑似极道少女",
          "text": "变强的秘诀，就是坚持到底的毅力。即使是度假也绝不能松懈！",
          "type": "dialogue"
        },
        {
          "sourceId": "34900021",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "是的，为了我们的使命和理想。",
          "type": "dialogue"
        },
        {
          "sourceId": "34900022",
          "sourceType": 0,
          "speaker": "疑似极道少女",
          "text": "下次假期，要以1/7比例的大象为假想敌进行训练。",
          "type": "dialogue"
        }
      ],
