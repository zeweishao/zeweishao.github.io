  "sections": [
    {
      "blocks": [
        {
          "noticeKind": "placeholder",
          "text": "原文中的动态称谓保留为占位符：|101|＝玩家昵称。",
          "type": "notice"
        }
      ],
      "id": "reading-note",
      "title": "阅读说明"
    },
    {
      "blocks": [
        {
          "sourceId": "34901001",
          "sourceType": 0,
          "speaker": "年轻的画家",
          "text": "假期里想做什么……",
          "type": "dialogue"
        },
        {
          "sourceId": "34901002",
          "sourceType": 0,
          "speaker": "年轻的画家",
          "text": "写生。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901003",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "嗯嗯……还有呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "34901004",
          "sourceType": 0,
          "speaker": "年轻的画家",
          "text": "……和奇萝一起去写生。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901005",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "……（悄悄话）蒂娅，话题有点进行不下去了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901006",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "如果不写生的话，会做什么呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "34901007",
          "sourceType": 0,
          "speaker": "年轻的画家",
          "text": "可能会和|101|一起去逛艺术展。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901008",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "诶，突然出现了主人的名字？！",
          "type": "dialogue"
        },
        {
          "sourceId": "34901009",
          "sourceType": 0,
          "speaker": "年轻的画家",
          "text": "……或许还会让|101|做我的速写模特。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901010",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "唔哇哇——优纪是专业的主持人，冷静，冷静。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901011",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "不好意思，打扰了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901012",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "这里刚刚有手办引发了事件，管理局正在调查。安全起见，请各位撤离到其他区域。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901013",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "啊，请问可以接受我们的采访吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "34901014",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "拜托了，就当帮我们一个小忙，可以吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "34901015",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "……好的，我答应你们。但只能采访一小会儿。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901016",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "假期吗……真是有些遥远的词汇。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901017",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "曾经的北阿罗拉是一片祥和美好的土地。在特殊的日子，人们会停下劳作，用盛大的庆典祭祀光明女神阿罗拉。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901018",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "这就是「假期」吧。但是……好景不长，战火席卷了我们的家园，夺走了平静的生活。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901019",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "人们被迫与家人朋友分离，自此，假期也不复存在……",
          "type": "dialogue"
        },
        {
          "sourceId": "34901020",
          "sourceType": 0,
          "speaker": "优纪",
          "text": "呜呜呜……一定很辛苦吧……",
          "type": "dialogue"
        },
        {
          "sourceId": "34901021",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "为了不让那个世界的悲剧重演……我会作为管理局的一员，守护大家身处的手办社区。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901022",
          "sourceType": 0,
          "speaker": "蒂娅",
          "text": "嗯，一起守护同伴们吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "34901023",
          "sourceType": 0,
          "speaker": "大魔王",
          "text": "嘎哈哈哈哈——",
          "type": "dialogue"
        },
        {
          "sourceId": "34901024",
          "sourceType": 0,
          "speaker": "大魔王",
          "text": "什么假期！本王每天都要玩得，啊不是，过得痛痛快快的！",
          "type": "dialogue"
        },
        {
          "sourceId": "34901025",
          "sourceType": 0,
          "speaker": "大魔王",
          "text": "可恶的管理局，本王可不会轻易被你们捉到！",
          "type": "dialogue"
        },
        {
          "sourceId": "34901026",
          "sourceType": 0,
          "speaker": "温柔大小姐",
          "text": "目标出现了，我先失陪了。",
          "type": "dialogue"
        }
      ],
