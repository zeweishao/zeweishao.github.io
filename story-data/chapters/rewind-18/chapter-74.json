      "title": "故国旧梦·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "21402001",
          "sourceType": 0,
          "speaker": "地头霸烈猫",
          "text": "嘶痛痛痛……哼，臭小子，今天算你走运！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402002",
          "sourceType": 0,
          "speaker": "地头喽啰盒",
          "text": "痛痛……算你走运！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402003",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "到此为止了，loser。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402004",
          "sourceType": 0,
          "speaker": "地头霸烈猫",
          "text": "别着急，好戏才刚刚开场，等着瞧，你们今天必须搬走！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402005",
          "sourceType": 0,
          "speaker": "地头喽啰盒",
          "text": "别急，必须搬走！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402006",
          "sourceType": 0,
          "speaker": "流浪手办乙",
          "text": "呣……水，水！我的脚湿了！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402007",
          "sourceType": 0,
          "speaker": "流浪手办甲",
          "text": "卑鄙小人！排水管！它们扎漏了排水管！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402008",
          "sourceType": 0,
          "speaker": "地头霸烈猫",
          "text": "哈哈哈，马上，你的老鼠窝就会变成汪洋大海，不出一小时，人类维修工就会赶到，哼哼，你要怎么办呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21402009",
          "sourceType": 0,
          "speaker": "地头喽啰盒",
          "text": "汪洋大海，人类，怎么办呢？",
          "type": "dialogue"
        },
        {
          "sourceId": "21402010",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "混蛋！！！真男人就该堂堂正正地战斗！！！\n欧拉欧拉欧拉——阿打打打打打——！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402011",
          "sourceType": 0,
          "speaker": "地头霸烈猫",
          "text": "小子，省点力气留着搬家吧，再见！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402012",
          "sourceType": 0,
          "speaker": "地头喽啰盒",
          "text": "搬家吧，再见！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402013",
          "sourceType": 0,
          "speaker": "鸣太郎",
          "text": "呜呜呜……发大水……我的家……这可怎么办阿……",
          "type": "dialogue"
        },
        {
          "sourceId": "21402014",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Sorry，我们要尽快撤离了。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402015",
          "sourceType": 0,
          "speaker": "流浪手办丙",
          "text": "搞什么，这已经是第19999次搬家了！\n做不到就不要擅自说什么「一定会保护大家」之类的话！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402016",
          "sourceType": 0,
          "speaker": "流浪手办甲",
          "text": "也不能怪家督大人，大人明明很努力地在帮助大家了。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402017",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "架也打了，家也没了——我受不了了！！！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402018",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Calm down，总有办法。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402019",
          "sourceType": 0,
          "speaker": "流浪手办丙",
          "text": "说得轻巧，总有办法？搬了家，再被人赶出来的办法吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21402020",
          "sourceType": 0,
          "speaker": "独眼龙",
          "text": "你是在嘲讽吗？来，用拳头跟我说话——！",
          "type": "dialogue"
        },
        {
          "sourceId": "21402021",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "Stop，不要吵。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402022",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "嗨，天气不错呢各位，遇到麻烦了吗？",
          "type": "dialogue"
        },
        {
          "sourceId": "21402023",
          "sourceType": 0,
          "speaker": "伊达政宗",
          "text": "显而易见，my friend，真田君。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402024",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "如果是居住方面的烦恼，我可以帮忙联系管理局解决喔？",
          "type": "dialogue"
        },
        {
          "sourceId": "21402025",
          "sourceType": 0,
          "speaker": "流浪手办丙",
          "text": "哪有那么便宜的事，肯定又是一个有所图谋的家伙。",
          "type": "dialogue"
        },
        {
          "sourceId": "21402026",
          "sourceType": 0,
          "speaker": "真田幸村",
          "text": "被发现了，实际上，我正在参加管理局的试炼，如果帮助大家找到新居所的话，或许能够记上一功也说不定~",
          "type": "dialogue"
        },
        {
          "sourceId": "21402027",
          "sourceType": 0,
          "speaker": "流浪手办丙",
          "text": "好吧，真是个诚实的家伙。",
          "type": "dialogue"
        }
      ],
