      "title": "日光下的挑战·Ⅲ"
    },
    {
      "blocks": [
        {
          "sourceId": "34709001",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "那就老规矩，先得6分的队伍获胜，比赛开始！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709002",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "我话先说在前面，赛场上出现什么意外都是自己负责。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709003",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "哼哼，后场都在本王的绝对防御里。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709004",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "感觉她们的气势好强……",
          "type": "dialogue"
        },
        {
          "sourceId": "34709005",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "我们也不会输给对手的！加油！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709006",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "好，穗香的发球！嘿呀！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709007",
          "sourceType": 3,
          "text": "排球高高地飞到空中，划过一道抛物线。",
          "type": "narration"
        },
        {
          "sourceId": "34709008",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "这下就接到啦。我投！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709009",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "喂，她怎么飞起来了？",
          "type": "dialogue"
        },
        {
          "sourceId": "34709010",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "……好像确实没规定选手不能飞啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709011",
          "sourceType": 3,
          "text": "玛莉在网前打回了差点坠地的排球——",
          "type": "narration"
        },
        {
          "sourceId": "34709012",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "小菜一碟！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709013",
          "sourceType": 3,
          "text": "弗吉尼娅抢过即将落入莉可手中的排球。",
          "type": "narration"
        },
        {
          "sourceId": "34709014",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "憎恶——扣杀！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709015",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "啊疼……力道好强……",
          "type": "dialogue"
        },
        {
          "sourceId": "34709016",
          "sourceType": 3,
          "text": "排球打到了防守者的穗香的手腕上，弹飞在地。",
          "type": "narration"
        },
        {
          "sourceId": "34709017",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "……冷若冰霜！弗吉尼娅选手得分，「宿命魔王」队1：0领先！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709018",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "……无血无泪！弗吉尼娅选手再度进球。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709019",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "果然……与普通选手不同，弗吉尼娅的进攻是瞄准对手的身体去的。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709020",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "之前甚至出现过让对手中途退场的情况。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709021",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "必要时我会要求中止比赛。",
          "type": "dialogue"
        },
        {
          "sourceId": "34709022",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "……只是这一点困难，小玛莉和我一起努力就没问题！",
          "type": "dialogue"
        },
        {
          "sourceId": "34709023",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "没错，比赛才刚刚开始呢！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851001",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "比分4：4，「天使与小恶魔」队连追2分！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851002",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "啧，果然被抓住破绽了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34851003",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "唔——明明是弗吉尼娅总是在抢我的球，所以球才会掉在地上！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851004",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "所以说啊，我讨厌小孩子。",
          "type": "dialogue"
        },
        {
          "sourceId": "34851005",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "哈？",
          "type": "dialogue"
        },
        {
          "sourceId": "34851006",
          "sourceType": 5,
          "speaker": "莉可",
          "text": "可恶，本王可不是小孩子！这次应该本王来发球！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851007",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "……发球失误，比分5：4，「天使与小恶魔」队抵达赛点！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851008",
          "sourceType": 0,
          "speaker": "莉可",
          "text": "只是手滑了！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851009",
          "sourceType": 0,
          "speaker": "弗吉尼娅",
          "text": "够了，你就管好自己后场吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "34851010",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "……玛莉她们针对的是对手的防区重叠的部分——莉可和弗吉尼娅会抢对方的球。",
          "type": "dialogue"
        },
        {
          "sourceId": "34851011",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "都已经引发内讧了啊。",
          "type": "dialogue"
        },
        {
          "sourceId": "34851012",
          "sourceType": 3,
          "text": "数个回合后——",
          "type": "narration"
        },
        {
          "sourceId": "34851013",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "穗香——防御！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851014",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "穗香选手成功接住了弗吉尼娅的扣球！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851015",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "小玛莉，球就交给你了！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851016",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "嗯！让你们看看玛莉的厉害！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851017",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "扣球得分！",
          "type": "dialogue"
        },
        {
          "sourceId": "34851018",
          "sourceType": 0,
          "speaker": "裁判小狐",
          "text": "真是默契的配合！「天使与小恶魔」取得比赛胜利！",
          "type": "dialogue"
        }
      ],
      "id": "detail-815",
