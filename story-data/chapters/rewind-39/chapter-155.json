            34702010,
            34702011,
            34702012,
            34702013,
            34702014,
            34702015,
            34702016,
            34702017,
            34702018,
            34702019,
            34702020,
            34702021,
            34702022,
            34702023,
            34702024,
            34702025,
            34702026,
            34702027,
            34702028,
            34702029
          ],
          "sectionId": 34702
        }
      ],
      "title": "海岛与塞壬·Ⅱ"
    },
    {
      "blocks": [
        {
          "sourceId": "34703001",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "该怎样让挑战赛有热闹的「假期」氛围呢？只是在排球赛中活跃好像不够呢。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703002",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "嗯……在打排球时体现出度假的感觉？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703003",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "我知道了，戴上亲手制作的花环，穿上椰子叶做的裙子来打排球吧！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703004",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "可是我们已经是「天使」和「小恶魔」了……",
          "type": "dialogue"
        },
        {
          "sourceId": "34703005",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "真是的……主题和泳装不都是岛主选好的吗？为什么从刚才起就一直不说话？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703006",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "呃……我其实……",
          "type": "dialogue"
        },
        {
          "sourceId": "34703007",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "咳咳，岛主有自己的打算！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703008",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "……没错。",
          "type": "dialogue"
        },
        {
          "options": [
            {
              "targetId": "34703010",
              "text": "自由发挥才最有「假期」的感觉"
            },
            {
              "targetId": "34703010",
              "text": "因为我相信你们的能力"
            }
          ],
          "sourceId": "34703009",
          "sourceType": 4,
          "text": "",
          "type": "choice"
        },
        {
          "sourceId": "34703010",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "呵呵，不愧是岛主。那穗香就再好好想想吧~",
          "type": "dialogue"
        },
        {
          "sourceId": "34703011",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "就算岛主这么说也……呜呀！？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703012",
          "sourceType": 3,
          "text": "一道棕黄色的影子从女孩们的脚边迅速窜过。",
          "type": "narration"
        },
        {
          "sourceId": "34703013",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "有什么毛茸茸的……",
          "type": "dialogue"
        },
        {
          "sourceId": "34703014",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "可恶的冰淇淋小偷，快给我站住！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703015",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "这样追下去真是没完没了……冻住，不许走！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703016",
          "sourceType": 0,
          "speaker": "？？？",
          "text": "啾咪！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703017",
          "sourceType": 3,
          "text": "棕黄色的生物被脚下的冰霜绊倒，在沙子上滚了几圈才停下。",
          "type": "narration"
        },
        {
          "sourceId": "34703018",
          "sourceType": 0,
          "speaker": "？？？",
          "text": "疼疼疼……喂，就算是在沙滩上也很疼的啊！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703019",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "啊，狐狸先生说话了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703020",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "就算是狐狸又怎么样，偷东西就该做好相应的觉悟……对吧？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703021",
          "sourceType": 0,
          "speaker": "？？？",
          "text": "你以为你把拳头弄得嘎嘎响我就会怕你吗？\n开玩笑的，手下留情！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703022",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "……哎，我们还是回去吧，就当投喂野生动物了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703023",
          "sourceType": 0,
          "speaker": "？？？",
          "text": "我可不是什么野生动物，我是排球赛的裁判哦，裁判！\n|101|，你为什么只在旁边看着？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703024",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "再揍一顿应该就老实了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703025",
          "sourceType": 0,
          "speaker": "？？？",
          "text": "|101|，快救我！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703026",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "（悄悄话）真乃，它认识我？它说的是真的吗?",
          "type": "dialogue"
        },
        {
          "sourceId": "34703027",
          "sourceType": 0,
          "speaker": "仓田真乃",
          "text": "（悄悄话）啊哈哈……虽然有点不想承认，之前岛主你拜托它来做排球赛的裁判来着……",
          "type": "dialogue"
        },
        {
          "sourceId": "34703028",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "好吧……\n阳子，放过它吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703029",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "嘛，既然是岛主要保它，那我也没什么意见。\n我丢。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703030",
          "sourceType": 5,
          "speaker": "裁判小狐",
          "text": "唔哇哇哇——",
          "type": "dialogue"
        },
        {
          "sourceId": "34703031",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "好的，我接住了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703032",
          "sourceType": 0,
          "speaker": "冈田彩音",
          "text": "岛主可以让它讲解一下在餐车里露营的事迹，还有偷走大家的冰淇淋——",
          "type": "dialogue"
        },
        {
          "sourceId": "34703033",
          "sourceType": 5,
          "speaker": "裁判小狐",
          "text": "前半句本狐承认，但是后面的事你们要拿出证据！\n这座岛上可没有监控摄像头！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703034",
          "sourceType": 0,
          "speaker": "夏澄阳子",
          "text": "……听得让人越来越火大了。",
          "type": "dialogue"
        },
        {
          "sourceId": "34703035",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "摄像头……有办法了！",
          "type": "dialogue"
        },
        {
          "sourceId": "34703036",
          "sourceType": 0,
          "speaker": "玛莉萝丝",
          "text": "啊！原来如此……",
          "type": "dialogue"
        },
        {
          "sourceId": "34703037",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "怎么了？",
          "type": "dialogue"
        },
        {
          "sourceId": "34703038",
          "sourceType": 0,
          "speaker": "穗香",
          "text": "我们来拍摄记录大家的假期生活的宣传片吧~",
          "type": "dialogue"
        }
      ],
      "id": "detail-809",
