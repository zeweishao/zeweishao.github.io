        }
      ],
      "id": "stage-1",
      "title": "噩梦惊回"
    },
    {
      "blocks": [
        {
          "text": "梦中人怎知自己身在梦中？",
          "title": "一枕南柯",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "往日残影"
    },
    {
      "blocks": [
        {
          "text": "读作宿敌，写作朋友。",
          "title": "一枕南柯",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "洪波再起"
    },
    {
      "blocks": [
        {
          "text": "也许现实只是另一场梦。",
          "title": "一枕南柯",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "浮生好眠"
    },
    {
      "blocks": [
        {
          "text": "做自己喜欢的事，过自己喜欢的生活。",
          "title": "邪心妄念",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "凄迷"
    },
    {
      "blocks": [
        {
          "text": "向前走，别回头。",
          "title": "邪心妄念",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "惘然"
    },
    {
      "blocks": [
        {
          "text": "缘未尽，相逢终有时。",
          "title": "邪心妄念",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "离愁"
    },
    {
      "blocks": [
        {
          "text": "生命是独一无二的存在，别感伤，别遗憾。",
          "title": "邪心妄念",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "伤怀"
    }
