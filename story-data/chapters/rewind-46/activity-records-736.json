  "sections": [
    {
      "blocks": [
        {
          "text": "怪谈的背后传来大新闻的味道呢。",
          "title": "焦点报道",
          "type": "profile"
        }
      ],
      "id": "stage-1",
      "title": "某位记者的追迹"
    },
    {
      "blocks": [
        {
          "text": "不愧是地狱级别的试胆大会。",
          "title": "焦点报道",
          "type": "profile"
        }
      ],
      "id": "stage-2",
      "title": "本格试胆大会"
    },
    {
      "blocks": [
        {
          "text": "地狱的门口当然会有守卫。",
          "title": "焦点报道",
          "type": "profile"
        }
      ],
      "id": "stage-3",
      "title": "通往地狱之门"
    },
    {
      "blocks": [
        {
          "text": "真正的新闻应始终立足于真相之上。",
          "title": "焦点报道",
          "type": "profile"
        }
      ],
      "id": "stage-4",
      "title": "第一篇新闻"
    },
    {
      "blocks": [
        {
          "text": "新闻追踪也是需要体力的，助手。",
          "title": "新闻追踪",
          "type": "profile"
        }
      ],
      "id": "stage-5",
      "title": "尾行"
    },
    {
      "blocks": [
        {
          "text": "擦掉脚印、恢复现场，不让调查对象察觉任何端倪。",
          "title": "新闻追踪",
          "type": "profile"
        }
      ],
      "id": "stage-6",
      "title": "匿踪"
    },
    {
      "blocks": [
        {
          "text": "她可以是任何人，也可以永远是记者。",
          "title": "新闻追踪",
          "type": "profile"
        }
      ],
      "id": "stage-7",
      "title": "暗访"
    },
    {
      "blocks": [
        {
          "text": "照亮都市，揭秘真相。",
          "title": "新闻追踪",
          "type": "profile"
        }
      ],
      "id": "stage-8",
      "title": "曝光"
    }
