  "sections": [
    {
      "blocks": [
        {
          "sourceId": "26016001",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "就像Miku喜欢唱歌一样，我很喜欢收集手办。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016002",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "和你们生活在一起非常幸福。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016003",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "可以“做自己喜欢的事”本身，的确是一件幸运而且令人开心的事。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016004",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "我最近在努力练习唱歌。这样就可以和你合唱了。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016005",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "我们一起来练习吧。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016006",
          "sourceType": 0,
          "speaker": "玩家",
          "text": "可以吗？我还没完全掌握。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016007",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "我相信你。",
          "type": "dialogue"
        },
        {
          "sourceId": "26016008",
          "sourceType": 0,
          "speaker": "初音未来",
          "text": "加油。",
          "type": "dialogue"
        }
      ],
